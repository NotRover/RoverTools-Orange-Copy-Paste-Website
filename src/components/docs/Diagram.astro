---
/**
 * A diagram on a docs page, drawn like the landing's Sync and security
 * section: a fixed dark plate (so it reads the same in both docs themes),
 * <<stereotype>> nodes, labelled edges, and one short note underneath that
 * states the figure's single claim.
 *
 * The drawing keeps a minimum width; on a narrower column the script below
 * zooms it down to fit, as DocMock does for the app shots, so nothing scrolls
 * sideways and no branch is lost to a restack.
 */
import '../../styles/landing.css';
import '../../styles/diagrams.css';

interface Props {
	/** The one thing the figure shows, as a sentence. Also the accessible name. */
	note: string;
	/** Minimum drawing width in rem before the plate starts to scroll. */
	min?: number;
}
const { note, min = 36 } = Astro.props;
---

<figure class="dg-figure not-content">
	<div class="dg-plate" role="img" aria-label={note}>
		<div class="dg-draw" style={`min-width:${min}rem`}>
			<slot />
		</div>
	</div>
	<figcaption class="dg-note">{note}</figcaption>
</figure>

<script>
	// Zoom each drawing down to its plate when the column is narrower than the
	// drawing's minimum width. zoom reflows, so the plate hugs the result.
	for (const plate of document.querySelectorAll<HTMLElement>('.dg-plate')) {
		const draw = plate.querySelector<HTMLElement>('.dg-draw');
		if (!draw) continue;
		const fit = () => {
			draw.style.zoom = '';
			const pad = parseFloat(getComputedStyle(plate).paddingLeft) * 2;
			const z = (plate.clientWidth - pad) / draw.scrollWidth;
			if (z < 1) draw.style.zoom = String(z);
		};
		new ResizeObserver(fit).observe(plate);
	}
</script>
