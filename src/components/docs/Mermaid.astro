---
// Inline Mermaid for Starlight MDX pages, rendered on the app's AMOLED skin:
// near-black ground, lifted surfaces, the app's orange held back for accents,
// and Fira Code (the app's mono). The plate commits to one dark ground in both
// site themes on purpose: a single Mermaid theme config renders crisply and
// identically in light and dark, which is what a theme-following plate cannot
// do. The palette mirrors src/styles/landing.css so the diagrams read as the
// same product as the rest of the site. Diagrams author as plain Mermaid source
// - the theme lives here, so do not paste a %%{init}%% line into the code.
interface Props {
	code: string;
	title?: string;
}
const { code, title } = Astro.props;
---

<figure class="mermaid-figure">
	<div class="mermaid-plate">
		<pre class="mermaid-src" hidden>{code}</pre>
		<div class="mermaid-out not-content" role="img" aria-label={title ?? 'diagram'}></div>
	</div>
	{title && <figcaption>{title}</figcaption>}
</figure>

<script>
	import mermaid from 'mermaid';

	// A clean AMOLED monochrome that sits on the site's own ground (#0e0e0e, the
	// dark docs background): the plate matches the page, grey surfaces lift above
	// it to read as cards, crisp grey borders, white text. No colour accents -
	// depth comes from the greyscale steps and the borders alone. Fixed in both
	// site themes.
	const themeVariables = {
		background: '#0e0e0e',
		primaryColor: '#1b1b1b',
		primaryTextColor: '#fafafa',
		primaryBorderColor: '#3a3a3a',
		lineColor: '#8c8c8c',
		textColor: '#e4e4e4',
		fontFamily: 'Fira Code, ui-monospace, monospace',
		fontSize: '15px',
		// flowchart nodes
		mainBkg: '#1b1b1b',
		nodeBorder: '#3a3a3a',
		nodeTextColor: '#fafafa',
		clusterBkg: '#131313',
		clusterBorder: '#282828',
		edgeLabelBackground: '#0e0e0e',
		titleColor: '#fafafa',
		// sequence diagrams
		actorBkg: '#1b1b1b',
		actorBorder: '#3a3a3a',
		actorTextColor: '#fafafa',
		actorLineColor: '#333333',
		signalColor: '#9a9a9a',
		signalTextColor: '#e4e4e4',
		labelBoxBkgColor: '#1b1b1b',
		labelBoxBorderColor: '#3a3a3a',
		labelTextColor: '#fafafa',
		loopTextColor: '#e4e4e4',
		// notes and activations stay monochrome, set apart by a lighter grey
		noteBkgColor: '#232323',
		noteTextColor: '#f2f2f2',
		noteBorderColor: '#4d4d4d',
		altBackground: '#141414',
		activationBkgColor: '#262626',
		activationBorderColor: '#4d4d4d',
		sequenceNumberColor: '#0e0e0e',
	};

	let seq = 0;
	let done = false;
	async function renderAll() {
		if (done) return;
		mermaid.initialize({
			startOnLoad: false,
			securityLevel: 'loose',
			theme: 'base',
			themeVariables,
			fontFamily: 'Fira Code, ui-monospace, monospace',
			flowchart: { htmlLabels: true, curve: 'basis', useMaxWidth: true, padding: 14 },
			sequence: {
				useMaxWidth: true,
				diagramMarginX: 14,
				diagramMarginY: 12,
				actorMargin: 46,
				boxMargin: 10,
				noteMargin: 12,
				messageMargin: 38,
				mirrorActors: false,
			},
		});
		const figs = document.querySelectorAll<HTMLElement>('.mermaid-figure');
		for (const fig of figs) {
			const src = fig.querySelector('.mermaid-src')?.textContent?.trim();
			const out = fig.querySelector<HTMLElement>('.mermaid-out');
			if (!src || !out || out.querySelector('svg')) continue;
			try {
				const { svg } = await mermaid.render('mmd-' + seq++, src);
				out.innerHTML = svg;
			} catch (err) {
				out.innerHTML =
					'<p style="color:var(--sl-color-red);font-size:.85em">Diagram failed to render.</p>';
				console.error('mermaid render failed', err);
			}
		}
		done = true;
	}

	renderAll();
	// Re-run once after fonts settle so measured label boxes fit the real glyphs.
	if ((document as any).fonts?.ready) {
		(document as any).fonts.ready.then(() => {
			done = false;
			document.querySelectorAll('.mermaid-out').forEach((o) => (o.innerHTML = ''));
			renderAll();
		});
	}
	document.addEventListener('astro:after-swap', () => {
		done = false;
		renderAll();
	});
</script>

<style>
	.mermaid-figure {
		margin: 1.75rem 0;
		display: flex;
		flex-direction: column;
	}
	.mermaid-plate {
		/* Matches the dark docs background (#0e0e0e) so the diagram sits on the
		   page rather than in a black box; a hairline border just defines it. */
		background: #0e0e0e;
		border: 1px solid #1e1e1e;
		border-radius: 12px;
		padding: clamp(0.9rem, 2.5vw, 1.6rem);
		overflow-x: auto;
	}
	.mermaid-out {
		display: flex;
		justify-content: center;
		min-width: 0;
	}
	.mermaid-out :global(svg) {
		max-width: 100%;
		height: auto;
	}
	/* Crisper edges and labels than Mermaid's defaults. */
	.mermaid-out :global(.edgePath .path),
	.mermaid-out :global(.flowchart-link),
	.mermaid-out :global(.messageLine0),
	.mermaid-out :global(.messageLine1) {
		stroke-width: 1.4px;
	}
	.mermaid-out :global(.node rect),
	.mermaid-out :global(.node polygon),
	.mermaid-out :global(.actor) {
		rx: 4;
		ry: 4;
	}
	.mermaid-figure figcaption {
		margin-top: 0.7rem;
		font-size: 0.92em;
		line-height: 1.55;
		color: var(--sl-color-gray-3);
	}
</style>
