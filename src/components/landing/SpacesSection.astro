---
import { CHIP_ICONS, GROUP_COLORS, KIND_COLORS, TYPE_LABELS, THUMBS } from './app-parts';

/* The right-hand mock is a space feed drawn from the app's own entry cards, so it
   reads as the same product as every other mockup on the page: the kind chip, the
   "shared by" owner chip, a real image thumbnail, and the accent border the app
   puts on the entry that just landed on the clipboard - which is what auto-copy
   does the moment a teammate shares. Newest first, like the app. */
const space = { name: 'design-team', members: 4 };
const feed = [
	{
		owner: 'sam',
		kind: 'url',
		text: 'staging.rovertools.app/preview',
		age: 'now',
		active: true,
	},
	{
		owner: 'rio',
		kind: 'text',
		text: '#ff3e1c on #0e0e0e, ratio 4.6:1',
		group: ['brand', 'amber'],
		age: '2m',
	},
	{
		owner: 'mei',
		kind: 'image',
		text: 'home-redesign-v4.png',
		thumb: 'ui',
		age: '9m',
	},
] as const;
---

<section class="section spaces" id="spaces">
	<div class="wrap sp-grid">
		<div class="sp-copy">
			<p class="eyebrow reveal">Spaces</p>
			<h2 class="section-title reveal">A clipboard you can share.</h2>
			<p class="section-lead reveal">
				A Space is a live, shared feed between any number of people. Share a clip or a
				note into it and everyone sees it in seconds, still end-to-end encrypted with a
				key the server never holds.
			</p>
			<ul class="sp-list reveal">
				<li>
					<b>Invite your way.</b> A code, a link that works for people without the app,
					or an email. People can also ask to join, and any member can let them in.
				</li>
				<li>
					<b>Auto-copy incoming.</b> Turn it on per space and shared items land straight
					on your clipboard as they arrive.
				</li>
				<li>
					<b>Send filters, off by default.</b> Auto-share only the content, types or
					groups you choose. Until you do, only items you share by hand go in.
				</li>
				<li>
					<b>Talk about it in place.</b> Comment on anything shared into a space, with
					mentions.
				</li>
			</ul>
		</div>

		<div class="sp-demo reveal" aria-hidden="true">
			<div class="feed">
				<div class="feed-head">
					<span class="feed-name">{space.name}</span>
					<span class="feed-count">{space.members} members</span>
				</div>
				<div class="sp-feed">
					{
						feed.map((e) => (
							<div class={`oc-card${e.active ? ' oc-card--in-clipboard' : ''}`}>
								{e.kind === 'image' && (
									<div class="oc-card-media">
										<img class="oc-card-media-img" src={THUMBS[e.thumb as keyof typeof THUMBS]} alt="" />
									</div>
								)}
								<div class="oc-card-body">
									<p class={`oc-card-text${e.kind === 'image' ? ' oc-card-text--imgname' : e.kind === 'text' ? '' : ' oc-card-text--clamp'}`}>
										{e.text}
									</p>
									<div class="oc-card-footer">
										<span class="oc-chips">
											<span class="oc-chip" style={`--cc:${KIND_COLORS[e.kind]}`}>
												<Fragment set:html={CHIP_ICONS[e.kind]} />
												<span class="oc-chip-label">{TYPE_LABELS[e.kind]}</span>
											</span>
											{'group' in e && e.group && (
												<span class="oc-chip oc-chip--group" style={`--cc:${GROUP_COLORS[e.group[1]]}`}>
													<span class="oc-chip-dot" />
													<span class="oc-chip-label">{e.group[0]}</span>
												</span>
											)}
											<span class="oc-owner-chip">
												<span class="oc-owner-avatar">{e.owner[0].toUpperCase()}</span>
												<span class="oc-owner-name">{e.owner}</span>
											</span>
										</span>
										<span class="oc-time">{e.age}</span>
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.spaces {
	}

	.sp-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: 4rem;
		align-items: center;
	}

	.sp-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.sp-list li {
		font-size: 0.94rem;
		color: var(--text-secondary);
		padding-left: 1.1rem;
		position: relative;
	}

	.sp-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.5em;
		width: 6px;
		height: 6px;
		border-radius: 2px;
		background: var(--accent);
	}

	.sp-list b {
		color: var(--text);
	}

	/* the panel that holds the feed, drawn like the app's side panels */
	.feed {
		background: var(--sidebar-bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 0.9rem;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
	}

	.feed-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 0.7rem;
		padding: 0 0.2rem;
	}

	.feed-name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.95rem;
	}

	.feed-count {
		font-size: 0.7rem;
		color: var(--text-muted);
	}

	/* the app card carries all its own styling from landing.css; the feed only has
	   to stack the cards. The app separates entry cards by a 10px card margin-bottom
	   (`.oc-grid .oc-card` and the spaces `.sp-feed-card-grid .oc-card`), so the feed
	   matches that exact rhythm - the grid's own margin rule does not reach here. */
	.sp-feed {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	@media (max-width: 900px) {
		.sp-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 2.5rem;
		}
	}
</style>
