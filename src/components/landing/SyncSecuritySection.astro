---
import { KIND_COLORS, TYPE_LABELS } from './app-parts';

/* Sync and security in one section, because they are one claim: your items
   reach your other computers, and the server that carries them cannot read
   them. The diagram shows the trip; the server box lists what it really holds,
   type and time in the clear and the content as ciphertext. The key trip below
   it follows the real envelope (backend docs/architecture.md, sections 7.1 and
   7.2), and the ledger answers the questions a careful reader asks. */
const held = [
	{ kind: 'text', cipher: 'q9J2xK41Vd8mThPZC7oW', time: '18:32' },
	{ kind: 'image', cipher: '7Ryb1Nc4Wq0sPe6JzK2m', time: '18:20' },
	{ kind: 'url', cipher: 'Zt5mKd2Ga9Ho1Uv3Lx8B', time: '17:55' },
];
/* One item's trip, in three lanes: encrypted on this computer, held locked on
   the server, opened on your other computer. */
type Piece =
	| { t: 'lane'; row: number; label: string }
	| { t: 'k'; row: number; col: number; name: string; st: string; key?: boolean; srv?: boolean }
	| { t: 'e'; row: number; col: number; label: string }
	| { t: 'v'; row: number; col: number; label?: string; head?: boolean };

const trip: Piece[] = [
	{ t: 'lane', row: 1, label: 'This computer' },
	{ t: 'k', row: 1, col: 1, name: 'Password', st: 'only you know it' },
	{ t: 'e', row: 1, col: 2, label: 'Argon2id' },
	{ t: 'k', row: 1, col: 3, name: 'Master key', st: 'in memory only', key: true },
	{ t: 'e', row: 1, col: 4, label: 'locks' },
	{ t: 'k', row: 1, col: 5, name: 'Item key', st: 'one per item', key: true },
	{ t: 'e', row: 1, col: 6, label: 'encrypts' },
	{ t: 'k', row: 1, col: 7, name: 'Your item', st: 'what you copied' },

	{ t: 'v', row: 2, col: 3, label: 'kept locked' },
	{ t: 'v', row: 2, col: 5, label: 'uploads', head: true },
	{ t: 'v', row: 2, col: 7, head: true },

	{ t: 'lane', row: 3, label: 'Sync server' },
	{ t: 'k', row: 3, col: 3, name: 'Master key', st: 'locked', srv: true },
	{ t: 'k', row: 3, col: 5, name: 'Item key', st: 'locked', srv: true },
	{ t: 'k', row: 3, col: 7, name: 'Your item', st: 'encrypted', srv: true },

	{ t: 'v', row: 4, col: 3, head: true },
	{ t: 'v', row: 4, col: 5, label: 'downloads', head: true },
	{ t: 'v', row: 4, col: 7, head: true },

	{ t: 'lane', row: 5, label: 'Other computer' },
	{ t: 'k', row: 5, col: 1, name: 'Password', st: 'the same one' },
	{ t: 'e', row: 5, col: 2, label: 'Argon2id' },
	{ t: 'k', row: 5, col: 3, name: 'Master key', st: 'in memory only', key: true },
	{ t: 'e', row: 5, col: 4, label: 'opens' },
	{ t: 'k', row: 5, col: 5, name: 'Item key', st: 'unlocked', key: true },
	{ t: 'e', row: 5, col: 6, label: 'decrypts' },
	{ t: 'k', row: 5, col: 7, name: 'Your item', st: 'readable again' },
];

// the lane labels take the first column, so every piece sits one column over
const at = (row: number, col = 0) => `--a: ${row} / ${col + 1}`;

const ledger = [
	{
		q: 'The server database is copied',
		a: 'They get ciphertext. Item types and times show, the content does not.',
		verdict: 'ciphertext only',
	},
	{
		q: 'An update is tampered with',
		a: 'Its signature fails the check built into the app, so it does not install.',
		verdict: 'refused',
	},
	{
		q: 'You forget your password',
		a: 'Your recovery code opens the same master key, so nothing is lost.',
		verdict: 'recoverable',
	},
	{
		q: 'Your computer is left unlocked',
		a: 'Local history is not encrypted, so the app works offline. Lock your screen.',
		verdict: 'up to you',
		yours: true,
	},
];
---

<section class="section sync" id="security">
	<div class="wrap">
		<p class="eyebrow reveal">Sync and security</p>
		<h2 class="section-title reveal">Synced to every computer. Readable only on yours.</h2>
		<p class="section-lead reveal">
			Clips, notes and settings are encrypted on your computer before they leave it. The
			server stores them but holds no key that opens them.
		</p>

		<div class="bp reveal" aria-label="How one copy travels between your devices">
			<div class="bp-row">
				<div class="bp-node">
					<p class="st">&lt;&lt;device&gt;&gt;</p>
					<p class="bp-name">Laptop</p>
					<div class="clip">
						<span class="chip" style="--k: var(--accent)">Text</span>
						<span class="clip-text">Gate B12, boarding 18:40</span>
					</div>
					<p class="bp-foot">Plaintext stays here</p>
				</div>

				<div class="wire" aria-hidden="true">
					<span class="wire-tag">AES-256-GCM</span>
					<span class="wire-line"><span class="packet">q9J2xK41...</span></span>
					<span class="wire-sub">encrypted before it leaves</span>
				</div>

				<div class="bp-node bp-node--relay">
					<p class="st">&lt;&lt;relay&gt;&gt;</p>
					<p class="bp-name">Sync server</p>
					<div class="held">
						{
							held.map((h) => (
								<div class="held-row">
									<span class="chip" style={`--k:${KIND_COLORS[h.kind]}`}>{TYPE_LABELS[h.kind]}</span>
									<span class="held-cipher">{h.cipher}</span>
									<span class="held-time">{h.time}</span>
								</div>
							))
						}
					</div>
					<p class="bp-foot">Sees the type and time, never the content</p>
				</div>

				<div class="wire wire--out" aria-hidden="true">
					<span class="wire-tag">live</span>
					<span class="wire-line"><span class="packet">q9J2xK41...</span></span>
					<span class="wire-sub">or on your schedule</span>
				</div>

				<div class="bp-node">
					<p class="st">&lt;&lt;device&gt;&gt;</p>
					<p class="bp-name">Desktop</p>
					<div class="clip">
						<span class="chip" style="--k: var(--accent)">Text</span>
						<span class="clip-text">Gate B12, boarding 18:40</span>
					</div>
					<p class="bp-foot">Decrypted on arrival</p>
				</div>
			</div>
		</div>

		<p class="fig-note reveal">The server stores and forwards each item as ciphertext. Only your own computers turn it back into text.</p>

		<div class="keys reveal">
			<h3 class="keys-head">How one item stays locked on the way</h3>

			<div class="chain">
				{
					trip.map((pc) =>
						pc.t === 'lane' ? (
							<p class="lane" style={at(pc.row)}>{pc.label}</p>
						) : pc.t === 'k' ? (
							<div class:list={['k', { 'k--key': pc.key, 'k--srv': pc.srv }]} style={at(pc.row, pc.col)}>
								<p class="st">&lt;&lt;{pc.st}&gt;&gt;</p>
								<p class="k-name">{pc.name}</p>
							</div>
						) : pc.t === 'e' ? (
							<div class="e" style={at(pc.row, pc.col)} aria-hidden="true">
								<span>{pc.label}</span>
							</div>
						) : (
							<div class:list={['v', { 'v--head': pc.head }]} style={at(pc.row, pc.col)} aria-hidden="true">
								{pc.label && <span>{pc.label}</span>}
							</div>
						)
					)
				}
			</div>

		</div>

		<p class="fig-note reveal">Your password never leaves your computer, and the server holds every key only in locked form.</p>

		<div class="ledger">
			{
				ledger.map((row) => (
					<div class="row reveal">
						<div class="row-head">
							<p class="st">&lt;&lt;what if&gt;&gt;</p>
							<span class:list={['verdict', { 'verdict--yours': row.yours }]}>{row.verdict}</span>
						</div>
						<p class="q">{row.q}</p>
						<p class="a">{row.a}</p>
					</div>
				))
			}
		</div>

		<p class="mode-note reveal">
			Pick Realtime, Passive (every 5 minutes) or Manual on each device. Deletes travel
			too, offline work queues up, and conflicts resolve to the latest edit.
			<br />
			The full model, including what the server does see, is in the <a href="/docs/security/">security docs</a>.
		</p>
	</div>
</section>

<style>
	.bp {
		position: relative;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.4rem 1.4rem;
		background: #0b0b0b;
	}

	.bp-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(7rem, 0.6fr) minmax(0, 1.2fr) minmax(7rem, 0.6fr) minmax(0, 1fr);
		align-items: center;
	}

	.bp-node {
		background: var(--surface);
		border: 1px solid var(--border-light);
		border-radius: var(--radius-sm);
		padding: 0.7rem 0.85rem 0.75rem;
	}

	.bp-node--relay {
		border-style: dashed;
		background: #121212;
	}

	.st {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--text-muted);
	}

	.bp-name {
		margin: 0.05rem 0 0.45rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1rem;
	}

	.clip {
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		padding: 0.45rem 0.55rem;
		display: grid;
		gap: 0.3rem;
	}

	.chip {
		justify-self: start;
		font-size: 0.66rem;
		font-weight: 500;
		line-height: var(--chip-h);
		padding: 0 0.45rem;
		border-radius: var(--radius-xs);
		color: var(--k);
		background: color-mix(in srgb, var(--k) 14%, transparent);
	}

	.clip-text {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* what the server holds: the type and time in the clear, the content not */
	.held {
		display: grid;
		gap: 0.3rem;
	}

	.held-row {
		display: grid;
		grid-template-columns: 3.4rem minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.45rem;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		padding: 0.25rem 0.45rem;
	}

	.held-cipher {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.held-time {
		font-family: var(--font-mono);
		font-size: 0.64rem;
		color: var(--text-secondary);
	}

	.bp-foot {
		margin: 0.45rem 0 0;
		font-size: 0.72rem;
		color: var(--text-secondary);
	}

	.wire {
		display: grid;
		justify-items: center;
		/* the packet rides 0.6rem either side of the line, so clear it with room to spare */
		gap: 1.6rem;
		padding: 0 0.4rem;
	}

	.wire-tag {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		color: var(--accent);
		border: 1px solid var(--accent-dim-strong);
		background: var(--bg);
		border-radius: var(--radius-xs);
		padding: 0.15rem 0.55rem;
	}

	.wire-sub {
		font-size: 0.68rem;
		color: var(--text-muted);
		text-align: center;
	}

	.wire-line {
		position: relative;
		width: 100%;
		height: 0;
		border-top: 1px dashed var(--border-light);
	}

	/* the arrowhead on the wire's far end */
	.wire-line::after {
		content: '';
		position: absolute;
		right: -1px;
		top: -5px;
		width: 8px;
		height: 8px;
		border-top: 1px solid var(--border-light);
		border-right: 1px solid var(--border-light);
		transform: rotate(45deg);
	}

	.packet {
		position: absolute;
		top: -0.62rem;
		left: 0;
		font-family: var(--font-mono);
		font-size: 0.62rem;
		line-height: 1.2rem;
		padding: 0 0.4rem;
		border-radius: var(--radius-xs);
		color: #fff;
		background: var(--accent);
		white-space: nowrap;
		opacity: 0;
		animation: travel 4s cubic-bezier(0.45, 0, 0.55, 1) infinite;
	}

	.wire--out .packet {
		animation-delay: 2s;
	}

	@keyframes travel {
		0% { left: 0; transform: translateX(0); opacity: 0; }
		8% { opacity: 1; }
		42% { opacity: 1; }
		50% { left: 100%; transform: translateX(-100%); opacity: 0; }
		100% { left: 100%; transform: translateX(-100%); opacity: 0; }
	}

	/* squircle tags where the browser can draw one; a 7px rounded rect elsewhere */
	@supports (corner-shape: squircle) {
		.wire-tag,
		.packet {
			border-radius: 999px;
			corner-shape: squircle;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.packet {
			animation: none;
			opacity: 1;
			left: 50%;
			transform: translateX(-50%);
		}
	}

	.mode-note {
		margin: 1rem 0 0;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.mode-note a {
		color: var(--accent);
	}

	/* the key trip: three lanes, top to bottom */
	.keys {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 0.9rem 1.1rem 0.8rem;
	}

	.keys-head {
		margin: 0 0 0.9rem;
		font-family: var(--font-display);
		font-size: 0.95rem;
		letter-spacing: -0.01em;
	}

	.chain {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr) 6rem minmax(0, 1fr) 6rem minmax(0, 1fr) 6rem minmax(0, 1fr);
		grid-template-rows: auto 2rem auto 2rem auto;
	}

	.chain > * {
		grid-area: var(--a);
	}

	.lane {
		margin: 0;
		align-self: center;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--text-muted);
	}

	/* each diagram's note: close to its diagram, a wider gap before the next group */
	.fig-note {
		margin: 0.55rem 0 1.4rem;
		font-size: 0.85rem;
		color: var(--text-muted);
		text-wrap: pretty;
	}

	.k {
		border: 1px solid var(--border-light);
		border-radius: var(--radius-sm);
		background: var(--surface);
		padding: 0.45rem 0.7rem;
	}

	.k--key {
		border-color: var(--accent);
		background: var(--accent-dim);
	}

	/* what the server holds: dashed, dark, and never orange, since nothing there opens */
	.k--srv {
		border-style: dashed;
		border-color: var(--border-light);
		background: #0b0b0b;
	}

	.k-name {
		margin: 0.1rem 0 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.9rem;
	}

	/* a horizontal edge: a line with an arrowhead and its label above */
	.e {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.e::before {
		content: '';
		position: absolute;
		left: 0.4rem;
		right: 0.4rem;
		top: 50%;
		border-top: 1px solid var(--border-light);
	}

	.e::after {
		content: '';
		position: absolute;
		right: 0.45rem;
		top: calc(50% - 4px);
		width: 7px;
		height: 7px;
		border-top: 1px solid var(--border-light);
		border-right: 1px solid var(--border-light);
		transform: rotate(45deg);
	}

	.e span,
	.v span {
		position: relative;
		font-family: var(--font-mono);
		font-size: 0.64rem;
		color: var(--text-secondary);
		background: var(--bg);
		padding: 0 0.3rem;
		transform: translateY(-0.8rem);
	}

	/* a vertical edge between lanes; the ones with a head point down the trip */
	.v {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.v::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 0.25rem;
		bottom: 0.25rem;
		border-left: 1px dashed var(--border-light);
	}

	.v--head::after {
		content: '';
		position: absolute;
		left: calc(50% - 3.5px);
		bottom: 0.25rem;
		width: 7px;
		height: 7px;
		border-right: 1px solid var(--border-light);
		border-bottom: 1px solid var(--border-light);
		transform: rotate(45deg);
	}

	.v span {
		transform: none;
		margin-left: 6rem;
		background: none;
		white-space: nowrap;
	}

	/* the ledger */
	.ledger {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.7rem;
	}

	/* each case is a node like the diagrams above: dark ground, hairline border,
	   and a stereotype with the verdict chip beside it */
	.row {
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: #0b0b0b;
		padding: 0.7rem 0.9rem 0.8rem;
	}

	.row-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
	}

	.q {
		margin: 0.45rem 0 0.25rem;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.92rem;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	.a {
		margin: 0;
		font-size: 0.84rem;
		color: var(--text-secondary);
		text-wrap: pretty;
	}

	.verdict {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		color: var(--accent);
		border: 1px solid var(--accent-dim-strong);
		background: var(--accent-dim);
		border-radius: var(--radius-xs);
		padding: 0.15rem 0.55rem;
	}

	/* the one case the app leaves to you: neutral, not a win */
	.verdict--yours {
		color: var(--text-secondary);
		border-color: var(--border-light);
		background: var(--surface);
	}

	@supports (corner-shape: squircle) {
		.verdict {
			border-radius: 999px;
			corner-shape: squircle;
		}
	}

	@media (max-width: 1100px) {
		.ledger {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.chain {
			grid-template-columns: minmax(0, 1fr);
			grid-template-rows: none;
		}
		.chain > * {
			grid-area: auto;
		}
		.lane {
			margin: 1rem 0 0.4rem;
		}
		.lane:first-child {
			margin-top: 0;
		}
		.k--srv + .k--srv {
			margin-top: 0.4rem;
		}
		.e {
			min-height: 2.2rem;
		}
		.e::before {
			left: 50%;
			right: auto;
			top: 0.3rem;
			bottom: 0.3rem;
			border-top: none;
			border-left: 1px solid var(--border-light);
		}
		.e::after {
			right: auto;
			left: calc(50% - 3.5px);
			top: auto;
			bottom: 0.3rem;
			transform: rotate(135deg);
		}
		.e span {
			transform: none;
			margin-left: 7rem;
			background: none;
		}
		.v {
			display: none;
		}
	}

	@media (max-width: 900px) {
		.bp {
			padding: 1.6rem 1.1rem;
		}
		.bp-row {
			grid-template-columns: minmax(0, 1fr);
		}
		.wire {
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			padding: 0.5rem 0;
			min-height: 5.5rem;
		}
		.wire-tag {
			grid-column: 1;
			justify-self: end;
			margin-right: 0.8rem;
		}
		.wire-sub {
			grid-column: 3;
			justify-self: start;
			margin-left: 0.8rem;
			text-align: left;
		}
		.wire-line {
			grid-column: 2;
			grid-row: 1;
			width: 0;
			height: 5.5rem;
			border-top: none;
			border-left: 1px dashed var(--border-light);
		}
		.wire-line::after {
			right: auto;
			left: -5px;
			top: auto;
			bottom: -1px;
			transform: rotate(135deg);
		}
		.packet {
			display: none;
		}
	}
	@media (max-width: 560px) {
		.ledger {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
