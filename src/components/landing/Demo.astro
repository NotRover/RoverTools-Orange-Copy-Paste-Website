		await hold(1800);
	}

	async function sceneSearch() {
		say('Click the search box and type. Every keystroke narrows the history.');
		await clickOn(searchField!, 0.12, 0.5, 640);
		/* the app rings the box in accent and turns its icon while it has the
		   caret, and the clear button appears the moment there is a query */
		searchBox?.classList.add('is-focus');
		if (searchField) {
			searchField.textContent = '';
			searchField.classList.add('is-typed');
		}
		const term = 'invoice';
		for (let i = 1; i <= term.length; i++) {
			const typed = term.slice(0, i);
			if (searchField) searchField.textContent = typed;
			// the app filters on every keystroke, so the grid narrows as you type
			const hit = ENTRIES.map((e, k) => (e.content.toLowerCase().includes(typed) ? k : -1)).filter((k) => k >= 0);
			render({ only: hit });
			await hold(160);
		}
		say('Two entries mention invoice, so two are left.');
		await hold(2000);
	}

	/** rewrite the card's numbers from the demo's own history, so what it counts
	    is what you can see in the grid */
	function countFilters(shown = ENTRIES.length) {
		const result = filterPop?.querySelector('.cs-card-result');
		if (result) result.innerHTML = `<b>${shown}</b> of ${ENTRIES.length}`;
		filterPop?.querySelectorAll<HTMLElement>('.cs-type-option').forEach((row) => {
			const kind = row.dataset.kind;
			const n = ENTRIES.filter((e) => e.kind === kind).length;
			const count = row.querySelector('.cs-option-count');
			if (count) count.textContent = String(n);
			row.classList.toggle('cs-type-option--dead', n === 0);
		});
	}

	async function sceneFilter() {
		say('Filters cover type, cloud state, space and group.');
		await clickOn(filterBtn!, 0.5, 0.5, 640);
		filterBtn?.classList.add('is-on');
		openPop(filterPop, filterBtn, 6);
		countFilters();
		await hold(950);

		const imageRow = filterPop?.querySelector<HTMLElement>('.cs-type-option[data-kind="image"]');
		if (imageRow) {
			await clickOn(imageRow, 0.3, 0.5);
			// one type ticked: every other comes off, as it reads in the app
			filterPop?.querySelectorAll<HTMLElement>('.cs-type-option').forEach((r) => {
				const on = r === imageRow;
				r.classList.toggle('cs-type-option--on', on);
				r.querySelector('.cs-type-cb')?.classList.toggle('cs-type-cb--on', on);
			});
			const hit = ENTRIES.map((e, k) => (e.kind === 'image' ? k : -1)).filter((k) => k >= 0);
			render({ only: hit });
			countFilters(hit.length);
			say('Images only. Every count on the card comes from the history itself.');
		}
		await hold(2200);
	}

	async function sceneSort() {
		say('Sort the history: newest, oldest, A to Z, Z to A or by type.');
		await clickOn(sortBtn!, 0.5, 0.5, 640);
		sortBtn?.classList.add('is-on');
		openPop(sortPop, sortBtn, 6);
		await hold(780);

		const oldest = sortPop?.querySelector<HTMLElement>('[data-sort="Oldest"]');
		if (oldest) {
			await clickOn(oldest, 0.35, 0.5);
			sortPop?.querySelectorAll('.oc-sort-item').forEach((i) => i.classList.remove('oc-sort-item--active'));
			oldest.classList.add('oc-sort-item--active');
			closePops();
			sortBtn?.classList.remove('is-on');
			order = [...order].reverse();
			render();
			say('Oldest first: what was at the bottom is now at the top.');
