---
/**
 * The guided demo: one app window, one chapter per screen. Each chapter opens
 * by reading its screen top to bottom, so what is below the fold gets seen
 * whether or not anything is clicked in it, then plays out whatever that screen
 * is for with the app's own controls rather than describing it.
 *
 * The window is drawn at 1440x830 - the size the app has to be for the spaces
 * screen to fit all three of its panels - and scaled as one block, so no
 * internal metric ever reflows. Everything on the toolbar is the shared
 * HistoryScreen; the overlays are the app's own parts (FilterCard, BulkBar) and
 * the script places them off the button that opens them, as the app does.
 */
import AppShell from './AppShell.astro';
import BulkBar from './BulkBar.astro';
import CardMenu from './CardMenu.astro';
import FilterCard from './FilterCard.astro';
import GroupManager from './GroupManager.astro';
import AccountScreen from './AccountScreen.astro';
import HistoryScreen from './HistoryScreen.astro';
import NotesScreen from './NotesScreen.astro';
import SettingsMock from './SettingsMock.astro';
import ShortcutsScreen from './ShortcutsScreen.astro';
import SpacesScreen from './SpacesScreen.astro';
import { SORT_ICONS } from './app-parts';
import '../../styles/mocks/account.css';
import '../../styles/mocks/notes.css';
import '../../styles/mocks/pointer.css';
import '../../styles/mocks/spaces.css';

/* One per screen, in the order the sidebar lists them. The rail is the app's
   own navigation, not a list of verbs. */
const scenes = [
	{ title: 'Clipboard', note: 'Everything you copied, and what you can do to it' },
	{ title: 'Notes', note: 'Write things down without leaving the window' },
	{ title: 'Spaces', note: 'A live feed shared with the people in it' },
	{ title: 'Account', note: 'Devices, sync mode and what you are storing' },
	{ title: 'Settings', note: 'Change how the app behaves' },
	{ title: 'Shortcuts', note: 'Every key the app answers to' },
];

const sortOptions = ['Newest', 'Oldest', 'A to Z', 'Z to A', 'Type'];
---

<section class="section demo" id="demo">
	<div class="wrap wrap--wide">
		<p class="eyebrow reveal demo-mid">Every screen, in order</p>
		<h2 class="section-title reveal demo-mid">Watch it work.</h2>
		<p class="section-lead reveal demo-mid">
			Six screens, one window, read top to bottom. These are the app's own
			controls, at the size it draws them.
		</p>

		<div class="demo-stage reveal">
			<ol class="demo-steps" id="demo-steps">
				{
					scenes.map((s, i) => (
						<li>
							<button class:list={['demo-step', i === 0 && 'is-on']} data-scene={i} type="button">
								<span class="demo-step-n">{i + 1}</span>
								<span class="demo-step-body">
									<span class="demo-step-title">{s.title}</span>
									<span class="demo-step-note">{s.note}</span>
								</span>
								<span class="demo-step-bar"></span>
							</button>
						</li>
					))
				}
			</ol>

			<div class="demo-frame">
				<div class="demo-window" aria-hidden="true">
					<AppShell nav="clipboard" class="demo-shell">
						<div class="demo-screen" id="demo-history">
							<HistoryScreen count={18} groups={3} gridId="demo-grid" />
						</div>
						<div class="demo-screen is-off" id="demo-notes">
							<NotesScreen scrollId="demo-ns-scroll" />
						</div>
						<div class="demo-screen is-off" id="demo-settings">
							<SettingsMock />
						</div>
						<div class="demo-screen is-off" id="demo-account">
							<AccountScreen scrollId="demo-acct-scroll" />
						</div>
						<div class="demo-screen is-off" id="demo-shortcuts">
							<ShortcutsScreen scrollId="demo-sc-scroll" />
						</div>
						<!-- all three panels at the widths the wide shot uses, which is
						     what a 1440 window has room for -->
						<div class="demo-screen is-off" id="demo-spaces">
							<SpacesScreen rulesWidth={340} gridId="demo-sp-grid" arrival feedExtra />
						</div>
						<div class="demo-pop demo-pop--sort" id="demo-sort" slot="overlay">
							<div class="oc-sort-menu">
								{
									sortOptions.map((label, i) => (
										<span class:list={['oc-sort-item', i === 0 && 'oc-sort-item--active']} data-sort={label}>
											<Fragment set:html={SORT_ICONS[i]} />
											<span>{label}</span>
										</span>
									))
								}
							</div>
						</div>
						<div class="demo-pop demo-pop--filter" id="demo-filter" slot="overlay">
							<FilterCard />
						</div>
						<div class="demo-pop demo-pop--gm" id="demo-gm" slot="overlay">
							<GroupManager />
						</div>
						<CardMenu slot="overlay" spaces={2} />
						<div class="demo-pop demo-pop--bulk" id="demo-bulk" slot="overlay">
							<BulkBar count={0} flyout={false} picked={false} />
						</div>
						<div class="oc-pill-row">
							<div class="oc-stat-pill">
								<span class="oc-stat"><b id="demo-shown">18</b> shown</span>
								<span class="oc-stat-sep"></span>
								<span class="oc-stat"><b>18</b> total</span>
							</div>
							<div class="oc-sync-pill" id="demo-sync-pill"><span class="dot"></span>Sync connected</div>
						</div>
						<div class="fake-cursor" id="demo-cursor" slot="overlay">
							<span class="click-ring"></span>
							<svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 2l0 17 4.2-3.6 2.6 6 3-1.3-2.6-5.9 6-.6z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round"/></svg>
						</div>
					</AppShell>
				</div>
				<p class="demo-caption">
					<span class="demo-caption-tag" id="demo-caption-tag">{scenes[0]!.title}</span>
					<span class="demo-caption-text" id="demo-caption">{scenes[0]!.note}</span>
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	import { CHIP_ICONS, GROUP_COLORS, NAV_ICONS } from './app-parts';
	import { makeCard, type MockEntry } from './mock-cards';
	import { refreshMockScrollbars } from './mock-scrollbars';

	/* The history the demo works on. Small enough that every count on screen is
	   a number you could check by eye. */
	const ENTRIES: (MockEntry & { age: string })[] = [
		{ kind: 'text', content: 'Invoice INV-20418, due Sep 5. Net 30, reference PO-99812.', age: '2m ago' },
		{ kind: 'url', content: 'github.com/NotRover/RoverTools-Releases', age: '9m ago' },
		{ kind: 'image', content: '#a1b2c3d4 Image Aug 21, 2:45 PM', thumb: 'photo', age: '14m ago' },
		{
			kind: 'html',
			content: '<h4>Release checklist</h4><ul><li>Bump the version and tag it</li><li>Sign both bundles</li></ul>',
			group: ['release', 'amber'],
			age: '26m ago',
		},
		{ kind: 'document', content: 'quarterly-report.pdf', age: '41m ago' },
		{ kind: 'text', content: 'Invoice INV-20417 was paid on Aug 12, no action needed.', age: '1h ago' },
		{ kind: 'video', content: 'popup-placement-bug.mp4', thumb: 'ui', age: '2h ago' },
		{ kind: 'folder', content: '/home/rio/projects/orangecp/assets', group: ['work', 'teal'], age: '3h ago' },
		{ kind: 'document', content: 'press-kit-aug.pdf', age: '5h ago' },
		/* A 1440 window shows three wide columns, so the history has to have
		   enough in it to fill them. Appended rather than interleaved: the
		   scenes address the first nine by index. Nothing below mentions
		   "invoice" - the search scene counts on there being exactly two. */
		{ kind: 'text', content: 'Rotate the space key before the beta, then re-wrap for everyone.', age: '6h ago' },
		{ kind: 'url', content: 'docs.rovertools.app/spaces/rules', age: '7h ago' },
		{ kind: 'image', content: '#7f31c0ab Image Aug 21, 11:06 AM', thumb: 'chart', age: '8h ago' },
		{ kind: 'file', content: 'brand-assets (3 files)', group: ['work', 'teal'], age: '9h ago' },
		{
			kind: 'text',
			content: 'Ship the popup clamp fix first, then the rail. The clamp is the one people hit.',
			age: '11h ago',
		},
		{
			kind: 'html',
			content: '<h4>Handover</h4><ul><li>Rotate the space key</li><li>Re-wrap for the four of us</li></ul>',
			group: ['release', 'amber'],
			age: '13h ago',
		},
		{ kind: 'document', content: 'colour-audit-aug.pdf', age: '15h ago' },
		{ kind: 'image', content: '#3c9f21de Image Aug 20, 6:40 PM', thumb: 'swatchA', age: '17h ago' },
		{ kind: 'folder', content: '/home/rio/projects/orangecp/press', age: '19h ago' },
	];

	/* the history as every scene finds it: the scenes tag, share and reorder
	   these, so a reset has to put the list back rather than only clear flags */
	const BASE_ENTRIES = ENTRIES.map((e) => ({ ...e }));

	const grid = document.getElementById('demo-grid');
	const cursor = document.getElementById('demo-cursor');
	/* the window itself: everything is measured and placed in the 1440x830 the
	   mock is drawn at, and that is the box the overlays sit in */
	const win = document.querySelector<HTMLElement>('.demo-window .oc-window');
	const steps = [...document.querySelectorAll<HTMLElement>('.demo-step')];
	const sortPop = document.getElementById('demo-sort');
	const filterPop = document.getElementById('demo-filter');
	const bulkPop = document.getElementById('demo-bulk');
	const gmPop = document.getElementById('demo-gm');
	const menu = win?.querySelector<HTMLElement>('.oc-menu') ?? null;
	const menuGroups = menu?.querySelector<HTMLElement>('.oc-menu-groups-flyout') ?? null;
	const historyScreen = document.getElementById('demo-history');
	const notesScreen = document.getElementById('demo-notes');
	const settingsScreen = document.getElementById('demo-settings');
	const spacesScreen = document.getElementById('demo-spaces');
	const accountScreen = document.getElementById('demo-account');
	const shortcutsScreen = document.getElementById('demo-shortcuts');
	/* the notes grid and the pane it lives in: opening a note is a class on the
	   pane, exactly as it is in the app */
	const notesMain = notesScreen?.querySelector<HTMLElement>('.ns-main') ?? null;
	/* the one card the spaces scene brings in, drawn with the rest of the feed
	   and hidden until then, so a scene never has to build a card by hand */
	const spArrival = spacesScreen?.querySelector<HTMLElement>('[data-demo-arrival]') ?? null;
	const spMeta = spacesScreen?.querySelector<HTMLElement>('.sp-space-card.active .sp-space-card-meta') ?? null;
	const spMetaText = spMeta?.textContent ?? '';
	const shownCount = document.getElementById('demo-shown');
	const stage = document.querySelector<HTMLElement>('.demo-stage');
	const caption = document.getElementById('demo-caption');
	const captionTag = document.getElementById('demo-caption-tag');
	/* the sidebar cloud is the app's own sync indicator: green check when the
	   device matches the account, blue arrow pulsing while a pull is running */
	const syncNav = win?.querySelector<HTMLElement>('.oc-nav-sync') ?? null;
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	/* At 1023 and below the stage collapses to a single 1fr column, so the frame's
	   width is the track's and does not depend on what is drawn in it: the window
	   can be fitted to it exactly, and a rung is never left sitting in the middle
	   of its band. Above that the second column is `auto`, the frame follows the
	   window, and fitting one to the other would chase its own tail - so that band
	   keeps the ladder. Keep this breakpoint and the stylesheet's in step. */
	const demoFrame = document.querySelector<HTMLElement>('.demo-frame');
	const fitBand = window.matchMedia('(max-width: 1023px)');

	function fitWindow() {
		if (!demoFrame) return;
		if (!fitBand.matches) {
			demoFrame.style.removeProperty('--dz');
			return;
		}
		const room = demoFrame.clientWidth - 2;
		if (room > 0) demoFrame.style.setProperty('--dz', (room / 1440).toFixed(4));
	}

	if (demoFrame && 'ResizeObserver' in window) new ResizeObserver(fitWindow).observe(demoFrame);
	window.addEventListener('resize', fitWindow);
	fitBand.addEventListener('change', fitWindow);
	fitWindow();

	/* toolbar controls, in the order HistoryScreen draws them */
	const toolbar = win?.querySelector('.oc-toolbar') ?? null;
	const leftBtns = toolbar?.querySelectorAll<HTMLElement>('.oc-tb-group:first-child .oc-tb-btn');
	const sortBtn = leftBtns?.[0] ?? null;
	const filterBtn = leftBtns?.[1] ?? null;
	const searchBox = win?.querySelector<HTMLElement>('.oc-search') ?? null;
	const searchField = searchBox?.querySelector<HTMLElement>('.oc-search-field') ?? null;
	const rightBtns = toolbar?.querySelectorAll<HTMLElement>('.oc-tb-group:last-child .oc-tb-btn');
	const selectBtn = rightBtns?.[0] ?? null;
	const groupsBtn = rightBtns?.[1] ?? null;
	/* the sidebar: the clipboard nav button and the gear at the foot of it */
	const sideNav = win?.querySelectorAll<HTMLElement>('.oc-side-nav .oc-navbtn');
	const clipboardNav = sideNav?.[0] ?? null;
	const notesNav = sideNav?.[1] ?? null;
	const shortcutsNav = sideNav?.[3] ?? null;
	const sideBottom = win?.querySelectorAll<HTMLElement>('.oc-side-bottom .oc-navbtn');
	const userBtn = sideBottom?.[2] ?? null;
	const gearBtn = sideBottom?.[3] ?? null;

	/* the scrolling box on each screen - what a chapter reads top to bottom, and
	   what a reset puts back to the top */
	const historyScroll = historyScreen?.querySelector<HTMLElement>('.oc-viewport') ?? null;
	const notesScroll = document.getElementById('demo-ns-scroll');
	const acctScroll = document.getElementById('demo-acct-scroll');
	const setScroll = document.getElementById('demo-set-scroll');
	const shortcutsScroll = document.getElementById('demo-sc-scroll');
	const spacesFeed = spacesScreen?.querySelector<HTMLElement>('.sp-feed-scroll') ?? null;
	const spacesRules = spacesScreen?.querySelector<HTMLElement>('.sp-rules-body') ?? null;
	const scrollers = [historyScroll, notesScroll, acctScroll, setScroll, shortcutsScroll, spacesFeed, spacesRules];

	const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

	/* A scene is a long chain of awaits, and the rail or a scroll can start the
	   next one while it is still mid-chain. Every pause a scene takes goes
	   through `hold`, which throws once the run it belongs to has been
	   superseded - without it a stale scene keeps typing into the search field
	   and moving the cursor underneath the scene now on screen. */
	const CANCEL = Symbol('superseded');
	/* Every pause in the demo is scaled by this, so the whole thing can be slowed
	   down or sped up from one place rather than from forty numbers. */
	const PACE = 1.55;
	async function hold(ms: number) {
		const mine = token;
		await wait(ms * PACE);
		if (mine !== token) throw CANCEL;
	}

	/* ---- the window's own coordinate space --------------------------------- */
	/* Everything is placed in the window's own 1440x830, never in screen pixels,
	   so the choreography survives the zoom the whole block is drawn at. */
	function zoom() {
		const w = win?.getBoundingClientRect();
		return w && w.width ? w.width / 1440 : 1;
	}

	function boxOf(el: Element) {
		const w = win!.getBoundingClientRect();
		const b = el.getBoundingClientRect();
		const z = zoom();
		return { x: (b.left - w.left) / z, y: (b.top - w.top) / z, w: b.width / z, h: b.height / z };
	}

	/* ---- the pointer -------------------------------------------------------- */
	/* The cursor chases its target instead of transitioning to it: every frame
	   it closes a fixed fraction of the distance left. A target that moves
	   mid-flight - and it does, because a scene re-renders the grid under the
	   pointer - just bends the path, where a CSS transition would restart and
	   read as a jump. It also means the pointer decelerates into everything it
	   touches rather than arriving at speed and stopping dead.

	   FOLLOW is per second: about 1% of the distance is left after 700ms, which
	   is roughly what the old transition took. */
	const FOLLOW = 6.6;
	let curX = 1440 - 60;
	let curY = 830 - 74;
	let aimX = curX;
	let aimY = curY;
	let frame = 0;
	let lastFrame = 0;

	function paintCursor() {
		if (cursor) cursor.style.transform = `translate(${curX}px, ${curY}px)`;
	}

	function step(now: number) {
		const dt = Math.min(0.05, (now - lastFrame) / 1000);
		lastFrame = now;
		/* frame-rate independent: the same easing on a 60Hz and a 144Hz screen */
		const k = 1 - Math.exp(-FOLLOW * dt);
		curX += (aimX - curX) * k;
		curY += (aimY - curY) * k;
		paintCursor();
		if (Math.hypot(aimX - curX, aimY - curY) > 0.3) {
			frame = requestAnimationFrame(step);
		} else {
			curX = aimX;
			curY = aimY;
			paintCursor();
			frame = 0;
		}
	}

	/** send the pointer to a point in the window's own coordinates */
	function moveTo(x: number, y: number, instant = false) {
		aimX = x;
		aimY = y;
		if (instant || reduced) {
			if (frame) cancelAnimationFrame(frame);
			frame = 0;
			curX = x;
			curY = y;
			paintCursor();
			return;
		}
		if (!frame) {
			lastFrame = performance.now();
			frame = requestAnimationFrame(step);
		}
	}

	function aim(el: Element, fx: number, fy: number) {
		const b = boxOf(el);
		return { x: b.x + b.w * fx, y: b.y + b.h * fy };
	}

	/* ---- what the pointer is over ------------------------------------------ */
	/* No real pointer is ever over these controls, so `:hover` cannot fire on
	   any of them. The cursor says what it is on instead, and the app's own
	   hover rules hang off that class (styles/mocks/pointer.css). Without it a
	   click lands on a button that never acknowledges it. */
	let hot: Element | null = null;

	function setHot(el: Element | null) {
		if (hot === el) return;
		hot?.classList.remove('demo-hot', 'demo-press');
		hot = el;
		hot?.classList.add('demo-hot');
	}

	async function moveToEl(el: Element, fx = 0.5, fy = 0.5, settle = 520) {
		const p = aim(el, fx, fy);
		cursor?.classList.add('on');
		moveTo(p.x, p.y);
		await hold(settle);
		/* on arrival, not on setting off: the app lights up under the pointer,
		   not in front of it */
		setHot(el);
	}

	/* The cursor glides, and the grid under it can reflow while it is gliding.
	   Both mean the point it set off for is not always the point it is over when
	   the click would land, so the click waits for it to arrive and re-aims at
	   whatever the target's box is by then. */
	async function settleOn(el: Element, fx: number, fy: number) {
		for (let i = 0; i < 8; i++) {
			const want = aim(el, fx, fy);
			const at = boxOf(cursor!);
			if (Math.hypot(want.x - at.x, want.y - at.y) < 2) return;
			moveTo(want.x, want.y);
			await hold(110);
		}
	}

	async function click(settle = 300) {
		cursor?.classList.add('clicking');
		hot?.classList.add('demo-press');
		await hold(settle);
		hot?.classList.remove('demo-press');
		cursor?.classList.remove('clicking');
	}

	/** move onto a target, wait until the cursor is really on it, then click */
	async function clickOn(el: Element, fx = 0.5, fy = 0.5, settle = 560) {
		await moveToEl(el, fx, fy, settle);
		await settleOn(el, fx, fy);
		await click(260);
	}

	/** hang a popup off the control that opens it, the way the app does */
	function openPop(pop: HTMLElement | null, anchor: Element | null, dy = 4) {
		if (!pop || !anchor) return;
		const a = boxOf(anchor);
		const inner = pop.firstElementChild as HTMLElement;
		const r = inner.getBoundingClientRect();
		const z = zoom();
		pop.style.left = `${Math.max(8, Math.min(a.x, 1440 - 8 - r.width / z))}px`;
		pop.style.top = `${Math.max(8, Math.min(a.y + a.h + dy, 830 - 8 - r.height / z))}px`;
		pop.classList.add('is-open');
	}

	function closePops() {
		[sortPop, filterPop, bulkPop, gmPop].forEach((p) => p?.classList.remove('is-open'));
		menu?.classList.remove('open');
	}

	type Screen = 'history' | 'notes' | 'settings' | 'spaces' | 'account' | 'shortcuts';

	const SCREEN_EL: Record<Screen, HTMLElement | null> = {
		history: historyScreen,
		notes: notesScreen,
		settings: settingsScreen,
		spaces: spacesScreen,
		account: accountScreen,
		shortcuts: shortcutsScreen,
	};

	/**
	 * Play a screen's sections in, the way the app does when one mounts.
	 *
	 * Swapping a class is not a mount, so the animation has already run - on the
	 * first paint, while the screen was hidden and nobody saw it. Taking the
	 * class off, forcing a reflow and putting it back is what restarts it; the
	 * reflow read is the whole point and cannot be dropped.
	 */
	function replayIntro(el: HTMLElement | null) {
		if (!el || reduced) return;
		el.classList.remove('demo-intro');
		void el.offsetWidth;
		el.classList.add('demo-intro');
	}

	/** the app draws one screen at a time, and the sidebar says which */
	function showScreen(which: Screen) {
		historyScreen?.classList.toggle('is-off', which !== 'history');
		notesScreen?.classList.toggle('is-off', which !== 'notes');
		settingsScreen?.classList.toggle('is-off', which !== 'settings');
		spacesScreen?.classList.toggle('is-off', which !== 'spaces');
		accountScreen?.classList.toggle('is-off', which !== 'account');
		shortcutsScreen?.classList.toggle('is-off', which !== 'shortcuts');
		clipboardNav?.classList.toggle('active', which === 'history');
		notesNav?.classList.toggle('active', which === 'notes');
		shortcutsNav?.classList.toggle('active', which === 'shortcuts');
		userBtn?.classList.toggle('active', which === 'account');
		gearBtn?.classList.toggle('active', which === 'settings');
		/* the sidebar cloud is the spaces button. It wears the sync colour while
		   the clipboard is up and the active highlight while spaces is. */
		syncNav?.classList.toggle('active', which === 'spaces');
		if (syncNav) syncNav.style.color = which === 'spaces' ? '' : '#22c55e';
		/* A pane on a screen that was hidden measured as having no height, so its
		   bar hid itself. Now that it has one, ask again - otherwise the screen
		   arrives without a scrollbar and only grows one once something scrolls. */
		refreshMockScrollbars();
		replayIntro(SCREEN_EL[which]);
	}

	/* ---- reading a screen -------------------------------------------------- */
	/* The panes are `overflow: hidden`, so nothing else can move them and nothing
	   reports it when the demo does. Both halves of that are wanted: a wheel over
	   the demo carries on down the page, and the drawn scrollbar is told the
	   content moved rather than listening for an event that never fires. */

	function easeInOut(t: number) {
		return t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2;
	}

	/** scroll a pane to a position over `ms`, or jump there if motion is off */
	function glide(el: HTMLElement, to: number, ms: number) {
		if (reduced) {
			el.scrollTop = to;
			refreshMockScrollbars();
			return Promise.resolve();
		}
		return new Promise<void>((done) => {
			const mine = token;
			const from = el.scrollTop;
			const delta = to - from;
			if (Math.abs(delta) < 1) {
				done();
				return;
			}
			const start = performance.now();
			const tick = (now: number) => {
				/* a chapter the rail has moved on from must not keep dragging a pane
				   the screen now on show is sitting in */
				if (mine !== token) {
					done();
					return;
				}
				const p = Math.min(1, (now - start) / ms);
				el.scrollTop = from + delta * easeInOut(p);
				refreshMockScrollbars();
				if (p < 1) requestAnimationFrame(tick);
				else done();
			};
			requestAnimationFrame(tick);
		});
	}

	/**
	 * Read a screen the way a person would: down to the bottom slowly enough to
	 * take in, a beat there, then back to the top for whatever the chapter does
	 * next. A pane with nothing below the fold is left alone.
	 *
	 * The trip is timed from how far it is rather than fixed, so a screen with
	 * a hand's worth below the fold does not crawl and one with six of them does
	 * not race. `MS_PER_PX` is the reading speed; the clamp keeps the shortest
	 * pass long enough to follow and the longest short enough to sit through.
	 */
	const MS_PER_PX = 7;

	async function readThrough(el: HTMLElement | null) {
		if (!el) return;
		const room = el.scrollHeight - el.clientHeight;
		if (room <= 2) return;
		const down = Math.min(11000, Math.max(1800, room * MS_PER_PX));
		await hold(420);
		await glide(el, room, down * PACE);
		await hold(900);
		/* back up faster than down: nobody re-reads on the way home */
		await glide(el, 0, Math.max(700, down * 0.28) * PACE);
		await hold(320);
	}

	/** bring one row into view, the way a person scrolls to the thing they want */
	async function bringIntoView(el: HTMLElement | null, target: Element | null, pad = 120) {
		if (!el || !target) return;
		const top = (target.getBoundingClientRect().top - el.getBoundingClientRect().top) / zoom();
		await glide(el, el.scrollTop + top - pad, 620 * PACE);
		await hold(260);
	}

	/* ---- the grid ---------------------------------------------------------- */
	let order = ENTRIES.map((_, i) => i);
	/* the entry whose content is on the clipboard right now - the app draws that
	   one with an accent border and keeps it there until something else is copied */
	let onClipboard = 0;

	function render(opts: { select?: boolean; picked?: number[]; only?: number[] } = {}) {
		if (!grid) return;
		grid.textContent = '';
		const visible = order.filter((i) => !opts.only || opts.only.includes(i));
		visible.forEach((i) => {
			const e = ENTRIES[i]!;
			grid.appendChild(
				makeCard(e, {
					age: e.age,
					active: i === onClipboard && !opts.select,
					select: opts.select,
					picked: opts.picked?.includes(i),
				}),
			);
		});
		if (shownCount) shownCount.textContent = String(visible.length);
	}

	function setStep(n: number) {
		steps.forEach((s, i) => s.classList.toggle('is-on', i === n));
	}

	/** the line under the window - the demo's own voice, not app chrome */
	function say(text: string) {
		if (caption) caption.textContent = text;
	}

	function setSync(state: 'idle' | 'working') {
		if (!syncNav) return;
		syncNav.innerHTML = state === 'working' ? NAV_ICONS.cloudArrowUp : NAV_ICONS.cloudCheck;
		syncNav.style.color = state === 'working' ? '#3b82f6' : '#22c55e';
		syncNav.classList.toggle('is-syncing', state === 'working');
	}

	/** every surface a scene opened or toggled, put back the way it was drawn */
	function resetSurfaces() {
		closePops();
		setSync('idle');
		if (selectBtn) selectBtn.querySelector('.oc-tb-badge')?.remove();

		const count = bulkPop?.querySelector('.bulk-popup-count strong');
		if (count) count.textContent = '0';
		const flyout = bulkPop?.querySelector<HTMLElement>('.bulk-popup-groups-flyout');
		if (flyout) flyout.hidden = true;
		bulkPop?.querySelector('.bulk-popup-groups-wrap .bulk-popup-chip')?.classList.remove('bulk-popup-chip--groups-active');
		bulkPop?.querySelectorAll('.bulk-popup-space-row').forEach((r) => {
			r.classList.remove('bulk-popup-space-row--active');
			// the app draws the check only on a space the selection is in, so the
			// glyph itself has to go, not just the class
			const box = r.querySelector('.bulk-popup-space-check');
			if (box) box.innerHTML = '';
		});

		if (menuGroups) menuGroups.hidden = true;
		menu
			?.querySelectorAll('.oc-menu-group-chip')
			.forEach((c) => c.classList.remove('oc-menu-group-chip--on'));

		// the group the manager scene added, and the counts it moved
		gmPop?.querySelectorAll('[data-demo-added]').forEach((c) => c.remove());
		const gmCount = gmPop?.querySelector('[data-gm-count]');
		if (gmCount) gmCount.textContent = '3';
		const gmInput = gmPop?.querySelector('[data-gm-input]');
		if (gmInput) {
			gmInput.textContent = 'New group name...';
			gmInput.classList.remove('is-typed');
		}
		gmPop?.querySelector('[data-gm-add]')?.classList.remove('is-on');
		const groupsBadge = groupsBtn?.querySelector('.oc-tb-badge');
		if (groupsBadge) groupsBadge.textContent = '3';

		if (spArrival) spArrival.hidden = true;
		if (spMeta) spMeta.textContent = spMetaText;
		notesMain?.classList.remove('ns-main--editing');
		if (acctSeg) {
			acctSeg.querySelectorAll('.acct-seg-pill').forEach((p, i) => p.classList.toggle('active', i === 0));
			if (acctModeDesc) acctModeDesc.textContent = acctModeText;
		}
		showScreen('history');
		/* every pane back to the top. These are `overflow: hidden` so a viewer
		   cannot drag them around mid-chapter, and a surface set that way fires no
		   scroll event - the drawn bar has to be told the content moved. */
		for (const el of scrollers) if (el) el.scrollTop = 0;
		refreshMockScrollbars();
		settingsScreen?.querySelectorAll<HTMLElement>('.set-toggle').forEach((t) => {
			t.classList.toggle('is-on', t.dataset.on === '1');
		});
		const slots = document.getElementById('demo-slots');
		slots?.classList.remove('is-open');
		const slotList = slots?.querySelector<HTMLElement>('.set-select-list');
		if (slotList) slotList.hidden = true;
		const slotValue = slots?.querySelector('[data-slot-value]');
		if (slotValue) slotValue.textContent = '5';
		slots?.querySelectorAll('.set-select-option').forEach((o) => {
			o.classList.toggle('is-on', (o as HTMLElement).dataset.slot === '5');
		});

		sortPop?.querySelectorAll('.oc-sort-item').forEach((i, k) => i.classList.toggle('oc-sort-item--active', k === 0));
		filterPop?.querySelectorAll('.cs-type-option').forEach((r) => {
			r.classList.remove('cs-type-option--on');
			r.querySelector('.cs-type-cb')?.classList.remove('cs-type-cb--on');
		});
	}

	/** back to a known state before every chapter, and between its beats */
	function reset(park = true) {
		resetSurfaces();
		ENTRIES.splice(0, ENTRIES.length, ...BASE_ENTRIES.map((e) => ({ ...e })));
		order = ENTRIES.map((_, i) => i);
		onClipboard = 0;
		render();
		searchBox?.classList.remove('is-focus');
		if (searchField) {
			searchField.textContent = 'Search...';
			searchField.classList.remove('is-typed');
		}
		[sortBtn, filterBtn, selectBtn].forEach((b) => b?.classList.remove('is-on'));
		setHot(null);
		if (park) moveTo(1440 - 60, 830 - 74, true);
	}

	/* the sync-mode segment and the line under it: the account chapter moves both,
	   so both have to be remembered the way the toggles below are */
	const acctSeg = accountScreen?.querySelector<HTMLElement>('.acct-mode .acct-seg') ?? null;
	const acctModeDesc = accountScreen?.querySelector<HTMLElement>('.acct-mode .acct-card-desc') ?? null;
	const acctModeText = acctModeDesc?.textContent ?? '';

	/* every toggle remembers how it was drawn, so a reset can put it back */
	settingsScreen?.querySelectorAll<HTMLElement>('.set-toggle').forEach((t) => {
		t.dataset.on = t.classList.contains('is-on') ? '1' : '0';
	});

	/* ---- scenes ------------------------------------------------------------ */

	/** the app swaps the card's time for a green "Copied" for a moment */
	async function flashCopied(card: HTMLElement) {
		const time = card.querySelector('.oc-time');
		const prev = time?.innerHTML ?? '';
		if (time) {
			time.innerHTML = `${CHIP_ICONS.check}Copied`;
			time.classList.add('oc-time--copied');
		}
		await hold(1000);
		if (time) {
			time.innerHTML = prev;
			time.classList.remove('oc-time--copied');
		}
	}

	async function sceneCopy() {
		say('Click an entry and it goes straight back on the clipboard.');
		const at = 2;
		const card = grid?.children[at] as HTMLElement | undefined;
		if (!card) return;
		await clickOn(card, 0.5, 0.32, 780);
		// the border turns accent the moment the click lands, and stays there
		const id = order[at]!;
		onClipboard = id;
		grid?.querySelectorAll('.oc-card--in-clipboard').forEach((c) => c.classList.remove('oc-card--in-clipboard'));
		card.classList.add('oc-card--in-clipboard');
		await flashCopied(card);
		// a copy is a capture like any other, so it comes back as the newest entry
		order = [id, ...order.filter((k) => k !== id)];
		render();
		say('It comes back as the newest entry, ready to paste anywhere.');
		await hold(1900);
	}

	/** put the card menu where the pointer is, kept inside the window */
	function openMenuAt(x: number, y: number) {
		if (!menu) return;
		menu.classList.add('open');
		const r = menu.getBoundingClientRect();
		const z = zoom();
		menu.style.left = `${Math.min(x, 1440 - 8 - r.width / z)}px`;
		menu.style.top = `${Math.min(y, 830 - 8 - r.height / z)}px`;
	}

	async function sceneGroups() {
		say('Right-click an entry to open its menu.');
		const card = grid?.children[1] as HTMLElement | undefined;
		if (!card || !menu || !menuGroups) return;
		const p = aim(card, 0.55, 0.3);
		await moveToEl(card, 0.55, 0.3, 780);
		await click(300);
		openMenuAt(p.x, p.y);
		await hold(1000);

		say('Groups lists what this entry can be tagged with.');
		const groupsRow = menu.querySelector<HTMLElement>('.oc-menu-groups-wrap .oc-menu-item');
		if (groupsRow) await clickOn(groupsRow, 0.5, 0.5);
		menuGroups.hidden = false;
		await hold(1000);

		const chip = menuGroups.querySelector<HTMLElement>('[data-group="work"]');
		if (chip) {
			await clickOn(chip, 0.5, 0.5);
			chip.classList.add('oc-menu-group-chip--on');
		}
		await hold(700);
		menuGroups.hidden = true;
		menu.classList.remove('open');
		ENTRIES[order[1]!]!.group = ['work', 'teal'];
		render();
		say('The chip shows on the card, and the group can be filtered on.');
