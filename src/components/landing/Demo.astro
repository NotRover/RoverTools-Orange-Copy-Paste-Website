	async function sceneAccount() {
		say('The person at the foot of the sidebar is the account.');
		await clickOn(userBtn!, 0.5, 0.5, 800);
		showScreen('account');
		await hold(1300);

		say('Who is signed in, the devices on the account, and what it is storing.');
		await readThrough(acctScroll);

		const mode = accountScreen?.querySelector<HTMLElement>('.acct-mode') ?? null;
		const passive = acctSeg?.querySelectorAll<HTMLElement>('.acct-seg-pill')[1] ?? null;
		if (mode && passive) {
			say('Syncing is set per device, not per account.');
			await bringIntoView(acctScroll, mode, 120);
			await clickOn(passive, 0.5, 0.5);
			acctSeg?.querySelectorAll('.acct-seg-pill').forEach((p) => p.classList.remove('active'));
			passive.classList.add('active');
			if (acctModeDesc) {
				acctModeDesc.textContent =
					'This device uploads what you copy, and picks up the rest when you open the app.';
			}
			say('Passive here, realtime on the laptop. Neither device decides for the other.');
			await hold(2400);
		}
	}

	async function sceneShortcuts() {
		say('The keyboard icon lists every key the app answers to.');
		await clickOn(shortcutsNav!, 0.5, 0.5, 800);
		showScreen('shortcuts');
		await hold(1300);

		say('Global capture and paste, the popup, cards, pins, groups, search.');
		await readThrough(shortcutsScroll);

		say('Nothing on this page is a binding the app does not have.');
		await hold(1900);
	}

	/* ---- chapters ---------------------------------------------------------- */
	/* One per screen. Each opens by reading its screen top to bottom, so what is
	   below the fold is seen whether or not anything gets clicked in it, then
	   plays out what that screen is for. `reset(false)` clears the board between
	   beats without parking the pointer back in the corner every time. */

	async function chapClipboard() {
		say('Everything you copied, newest first, grouped by the day it landed.');
		await readThrough(historyScroll);
		await sceneCopy();
		reset(false);
		await hold(700);
		await sceneSearch();
		reset(false);
		await hold(700);
		await sceneFilter();
		reset(false);
		await hold(700);
		await sceneSort();
		reset(false);
		await hold(700);
		await sceneGroups();
	}

	async function chapSpaces() {
		/* sharing starts on the clipboard, so the chapter does too: pick three,
		   send them, then go and watch them land */
		say('A space is a shared feed. Things get into one from the history.');
		await hold(1400);
		await sceneShare();
		reset(false);
		await hold(700);
		await sceneSpaces();
	}

	const SCENES = [
		chapClipboard,
		sceneNotes,
		chapSpaces,
		sceneAccount,
		sceneSettings,
		sceneShortcuts,
	];

	/* ---- the runner -------------------------------------------------------- */
	/* One scene at a time, each starting from the same window. `token` is what
	   stops a scene that is still awaiting from writing over the next one after
	   a click on the rail or a scroll away. */
	let current = 0;
	let token = 0;
	let onScreen = false;

	async function play(n: number) {
		const mine = ++token;
		current = n;
		setStep(n);
		reset();
		if (captionTag) captionTag.textContent = steps[n]?.querySelector('.demo-step-title')?.textContent ?? '';
		say(steps[n]?.querySelector('.demo-step-note')?.textContent ?? '');
		try {
			await hold(420);
			await SCENES[n]!();
		} catch (err) {
			if (err !== CANCEL) throw err;
			return;
		}
		if (mine !== token || !onScreen) return;
		play((n + 1) % SCENES.length);
	}

	steps.forEach((s, i) =>
		s.addEventListener('click', () => {
			onScreen = true;
			play(i);
		}),
	);

	render();
	setStep(0);

	if (!reduced) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					const was = onScreen;
					onScreen = e.isIntersecting;
					if (onScreen && !was) play(current);
					if (!onScreen) token++;
				}
			},
			{ threshold: 0.3 },
		);
		if (stage) io.observe(stage);
	}
</script>

