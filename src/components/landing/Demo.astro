	/** the bar the app floats under the select toggle, counting what is ticked */
	function showBulk(n: number) {
		if (!bulkPop) return;
		const count = bulkPop.querySelector('.bulk-popup-count strong');
		if (count) count.textContent = String(n);
		if (!selectBtn) return;
		/* the toolbar button wears the count while select mode is on, and wears
		   nothing at zero - the app draws the badge only above zero */
		let badge = selectBtn.querySelector('.oc-tb-badge');
		if (n > 0 && !badge) {
			badge = document.createElement('span');
			badge.className = 'oc-tb-badge';
			selectBtn.appendChild(badge);
		}
		if (badge) {
			if (n > 0) badge.textContent = String(n);
			else badge.remove();
		}
		/* The app anchors the bar under the select toggle, right edges flush, and
		   the share flyout drops out of the bar from there. Floating the bar at
		   the foot of the window instead left the flyout no room and it fell out
		   of the bottom of the screen. */
		const inner = bulkPop.firstElementChild as HTMLElement;
		const iw = inner.getBoundingClientRect().width / zoom();
		const a = boxOf(selectBtn);
		bulkPop.style.left = `${Math.max(8, a.x + a.w - iw)}px`;
		bulkPop.style.top = `${a.y + a.h + 6}px`;
		bulkPop.classList.add('is-open');
	}

	async function sceneShare() {
		say('Select mode turns the cards into a selection, and opens the bulk bar.');
		await clickOn(selectBtn!, 0.5, 0.5, 640);
		selectBtn?.classList.add('is-on');
		render({ select: true });
		// the app opens the bar the moment select mode is on, at zero selected
		showBulk(0);
		await hold(900);

		say('Tick what you want to send. The count follows on the toolbar.');
		const picked: number[] = [];
		for (const i of [0, 2, 4]) {
			const card = grid?.children[order.indexOf(i)] as HTMLElement | undefined;
			if (!card) continue;
			await clickOn(card, 0.5, 0.3, 480);
			picked.push(i);
			// tick it in place: a full re-render would pull the grid out from under
			// the cursor between one click and the next
			card.classList.add('oc-card--picked');
			showBulk(picked.length);
			await hold(260);
		}
		await hold(800);

		const shareChip = bulkPop?.querySelector<HTMLElement>('.bulk-popup-groups-wrap .bulk-popup-chip');
		const flyout = bulkPop?.querySelector<HTMLElement>('.bulk-popup-groups-flyout');
		if (shareChip && flyout) {
			say('Share to space lists the spaces this account is in.');
			await clickOn(shareChip, 0.5, 0.5);
			// the list opens on the click, never before it
			shareChip.classList.add('bulk-popup-chip--groups-active');
			flyout.hidden = false;
			await hold(900);

			const design = flyout.querySelector<HTMLElement>('.bulk-popup-space-row');
			if (design) {
				await clickOn(design, 0.3, 0.5);
				design.classList.add('bulk-popup-space-row--active');
				const box = design.querySelector('.bulk-popup-space-check');
				if (box) box.innerHTML = CHIP_ICONS.check;
				say('Design ticked: those three go to that space, encrypted before they leave.');
			}
			await hold(1000);
			flyout.hidden = true;
			shareChip.classList.remove('bulk-popup-chip--groups-active');
		}
		picked.forEach((i) => {
			ENTRIES[i]!.spaces = 1;
			ENTRIES[i]!.sync = 'synced';
		});
		render({ select: true, picked });
		say('Everyone in the space gets them on their own devices.');
		await hold(2300);
		closePops();
		selectBtn?.classList.remove('is-on');
	}

