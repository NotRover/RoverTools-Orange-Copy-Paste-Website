			await bringIntoView(setScroll, slots.closest('.set-section'), 60);
			await clickOn(trigger, 0.5, 0.5);
			slots.classList.add('is-open');
			list.hidden = false;
			await hold(900);
			const nine = list.querySelector<HTMLElement>('[data-slot="9"]');
			if (nine) {
				await clickOn(nine, 0.5, 0.5);
				list.querySelectorAll('.set-select-option').forEach((o) => o.classList.remove('is-on'));
				nine.classList.add('is-on');
				const value = trigger.querySelector('[data-slot-value]');
				if (value) value.textContent = '9';
			}
			list.hidden = true;
			slots.classList.remove('is-open');
			await hold(1200);
		}

		const row = settingsScreen?.querySelector<HTMLElement>(
			'[data-set-row="Click a card to view it"] .set-toggle',
		);
		if (row) {
			await bringIntoView(setScroll, row.closest('.set-row'), 150);
			say('Off, a click copies an entry. On, a click opens it instead.');
			await clickOn(row, 0.5, 0.5);
			row.classList.add('is-on');
