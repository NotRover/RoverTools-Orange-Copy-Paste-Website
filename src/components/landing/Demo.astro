		say('New groups come from the toolbar.');
		await clickOn(groupsBtn!, 0.5, 0.5, 780);
		openPop(gmPop, groupsBtn, 6);
		await hold(900);

		const input = gmPop?.querySelector<HTMLElement>('[data-gm-input]');
