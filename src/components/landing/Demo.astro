	async function sceneSpaces() {
		say('The cloud at the top of the sidebar opens Spaces.');
		await clickOn(syncNav!, 0.5, 0.5, 800);
		showScreen('spaces');
		await hold(1500);

		const design = spacesScreen?.querySelector<HTMLElement>('.sp-space-card.active') ?? null;
		if (design) {
			say('Every space you are in, and how many of its people are online right now.');
			await moveToEl(design, 0.5, 0.5, 700);
			await hold(1700);
		}

		say('The feed beside it is what the four of you have shared, newest first.');
		await readThrough(spacesFeed);

		say('The panel on the right is what this space is allowed to do on this machine.');
		await readThrough(spacesRules);

		/* the card is already in the feed, drawn with the rest of it and hidden
		   until now: a scene should never have to hand-build a card that the
		   screen component already knows how to draw */
		if (spArrival) {
			spArrival.hidden = false;
			spArrival.classList.add('demo-arrive');
			requestAnimationFrame(() => requestAnimationFrame(() => spArrival.classList.remove('demo-arrive')));
			if (spMeta) spMeta.textContent = spMetaText.replace('18 items', '19 items');
			say('rio copies something on their machine. It arrives here, decrypted on yours.');
			await hold(2300);
		}

		say('Copy new items in is on for this space, so it is on your clipboard too.');
