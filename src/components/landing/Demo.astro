	async function sceneSettings() {
		say('The gear at the foot of the sidebar opens Settings.');
		await clickOn(gearBtn!, 0.5, 0.5, 800);
		showScreen('settings');
		await hold(1200);

		say('Notifications, sounds, quick paste, history, updates, data.');
		await readThrough(setScroll);

		const slots = document.getElementById('demo-slots');
		const trigger = slots?.querySelector<HTMLElement>('.set-select-trigger');
		const list = slots?.querySelector<HTMLElement>('.set-select-list');
		if (slots && trigger && list) {
