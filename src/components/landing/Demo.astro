		if (input && addBtn) {
			await clickOn(input, 0.25, 0.5);
			input.textContent = '';
			input.classList.add('is-typed');
			const name = 'receipts';
			for (let i = 1; i <= name.length; i++) {
				input.textContent = name.slice(0, i);
				await hold(130);
			}
			say('Name it, add it, and it is ready to tag with.');
			await hold(500);
			await clickOn(addBtn, 0.5, 0.5);
			addBtn.classList.add('is-on');
			const chips = gmPop?.querySelector('[data-gm-chips]');
			chips?.insertAdjacentHTML(
				'beforeend',
				`<span class="gm-chip" data-demo-added style="--cc:${GROUP_COLORS.purple}"><span class="gm-chip-dot"></span><span class="gm-chip-name">receipts</span><span class="gm-chip-count">0</span></span>`,
			);
			const gmCount = gmPop?.querySelector('[data-gm-count]');
			if (gmCount) gmCount.textContent = '4';
			const badge = groupsBtn?.querySelector('.oc-tb-badge');
			if (badge) badge.textContent = '4';
			input.textContent = 'New group name...';
			input.classList.remove('is-typed');
		}
		await hold(2000);
