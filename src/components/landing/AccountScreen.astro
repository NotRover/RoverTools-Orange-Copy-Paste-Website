---
/**
 * The account screen as the app draws it: identity band, then the sync mode,
 * the devices on the account, and what the account is storing. The panels are
 * the same components the showcase tiles use, so the two cannot drift apart.
 *
 * The scroll shell is `set-screen`, which is what the app does: AccountScreen
 * renders `settings-screen account-screen` and borrows the settings screen's
 * scrolling column whole.
 */
import { SRC_ICONS } from './app-parts';
import DevicesPanel from './mocks/DevicesPanel.astro';
import StorageZone from './mocks/StorageZone.astro';

interface Props {
	/** id put on the scrolling box, so the demo can scroll it */
	scrollId?: string;
}

const { scrollId } = Astro.props;
---

<div class="set-screen" id={scrollId}>
	<div class="set-inner">
		<div class="scr-head">
			<span class="scr-eyebrow">Cloud</span>
			<h2 class="scr-title">Account and Sync</h2>
			<p class="scr-subtitle">
				Sign in, keep your devices in sync, and see what this account is storing.
				End-to-end encrypted.
			</p>
		</div>

		<div class="acct-card">
			<div class="acct-idband">
				<div class="acct-id-main">
					<span class="acct-avatar">R</span>
					<div class="acct-id-text">
						<span class="acct-id-email">rio@studio.example</span>
						<span class="acct-id-status acct-id-status--connected">
							<span class="acct-id-dot"></span>Connected, realtime
						</span>
					</div>
					<div class="acct-id-actions">
						<span class="acct-btn">Sync now</span>
						<span class="acct-btn">Sign out</span>
					</div>
				</div>
				<div class="acct-id-meta">
					<span class="acct-id-fact">2 devices</span>
					<span class="acct-id-fact">Last sync 12s ago</span>
					<span class="acct-id-fact">Nothing queued</span>
					<div class="acct-id-meta-actions">
						<span class="acct-link">Reset sync</span>
					</div>
				</div>
				<div class="acct-id-recovery">
					<span class="acct-id-recovery-icon" set:html={SRC_ICONS.key11} />
					<span class="acct-id-recovery-text">
						Your recovery code is the only way back into this account's data if you
						forget the password. Nobody else holds a copy, this app included.
					</span>
					<span class="acct-link">Show code</span>
				</div>
			</div>
		</div>

		<DevicesPanel />
		<StorageZone />
	</div>
</div>
