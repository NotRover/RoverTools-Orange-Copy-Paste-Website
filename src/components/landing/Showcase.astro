		border: 1px solid var(--border);
		border-radius: 9px;
		background: var(--surface);
		color: var(--text-secondary);
		font-size: 11.5px;
		font-weight: 600;
	}

	.sp-action-btn--primary {
		border-color: transparent;
		background: var(--cta, var(--accent));
		color: #fff;
	}

	/* the feed's timeline rail */
	.sp-timeline-wrap {
		min-height: 100%;
	}

	.sp-timeline-groups {
		display: flex;
		flex-direction: column;
		margin-left: 15px;
	}

	.sp-timeline-group {
		display: flex;
		flex-direction: column;
		position: relative;
	}

	.sp-timeline-day-row {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 10px 16px 8px 0;
		position: relative;
		width: 100%;
	}

	.sp-timeline-day-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--accent);
		box-shadow: 0 0 0 3px var(--accent-dim);
		flex-shrink: 0;
		margin-left: -5px;
		position: relative;
		z-index: 1;
	}

	.sp-timeline-day-label {
		font-size: 12.5px;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: -0.2px;
		white-space: nowrap;
	}

	.sp-timeline-day-row::after {
		content: '';
		flex: 1;
		height: 0.5px;
		background: var(--accent);
		opacity: 0.25;
		margin-left: 4px;
	}

	.sp-timeline-day-chevron {
		flex-shrink: 0;
		display: inline-flex;
		color: var(--accent);
		opacity: 0.5;
		margin-right: 4px;
	}

	.sp-feed-card-grid {
		columns: 2;
		column-gap: 10px;
		padding-top: 4px;
		padding-left: 15px;
		padding-right: 14px;
	}

	.sp-feed-card-grid :global(.oc-card),
	.sp-feed-card-grid .ns-card {
		break-inside: avoid;
		margin-bottom: 10px;
	}

	.sp-timeline-end {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 18px 16px 20px;
	}

	.sp-timeline-end-text {
		font-size: 11px;
		font-weight: 500;
		color: var(--text-muted);
		letter-spacing: 0.4px;
		opacity: 0.6;
	}

	/* source and owner chips on a shared item */
	:global(.sp-source-chip--clip) {
		background: rgba(99, 102, 241, 0.12) !important;
		color: #6366f1 !important;
	}

	:global(.sp-source-chip--note) {
		background: rgba(244, 63, 94, 0.12) !important;
		color: #f43f5e !important;
	}

	.sp-owner {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		gap: 5px;
		max-width: 130px;
		height: var(--chip-h);
		padding: 0 7px 0 2px;
		line-height: 1.4;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface-hover);
		font-size: 10px;
		font-weight: 600;
		color: var(--text-secondary);
	}

	.sp-owner-avatar {
		width: 14px;
		height: 14px;
		flex-shrink: 0;
		border-radius: 6px;
	}

	.sp-owner-avatar--initials {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--accent-dim-strong);
		color: var(--accent);
		font-size: 8.5px;
		font-weight: 700;
		line-height: 1;
	}

	.sp-owner--self {
		padding: 0 8px;
		color: var(--text-muted);
		background: transparent;
	}

	/* the rules rail */
	.sp-rules-head {
		display: flex;
		align-items: center;
		gap: 9px;
		flex-shrink: 0;
		padding: 12px;
		border-bottom: 1px solid var(--border);
	}

	.sp-rules-avatar {
		display: grid;
		place-items: center;
		width: 26px;
		height: 26px;
		flex-shrink: 0;
		border-radius: var(--radius-xs);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.4px;
		color: #fff;
	}

	.sp-rules-head-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.sp-rules-name {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--text);
	}

	.sp-rules-sub {
		font-size: 10.5px;
		color: var(--text-muted);
	}

	.sp-rules-body {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding: 12px;
		overflow: hidden;
	}

	.sp-settings-block {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.sp-settings-label {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: 0.6px;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.sp-settings-count {
		padding: 1px 6px;
		border-radius: 5px;
		background: var(--accent-dim);
		color: var(--accent);
		font-size: 9px;
		font-weight: 700;
		letter-spacing: 0.2px;
		text-transform: none;
	}

	.sp-toggle-row {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		padding: 9px 11px;
		border: 1px solid var(--border);
		border-radius: 9px;
		background: var(--surface);
	}

	.sp-toggle-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		flex: 1;
		min-width: 0;
	}

	.sp-toggle-title {
		font-size: 12px;
		font-weight: 600;
		color: var(--text);
	}

	.sp-toggle-desc {
		font-size: 10.5px;
		line-height: 1.4;
		color: var(--text-muted);
	}

	/* the app's switch: 30x17 track, 11px knob, 13px travel */
	.sp-switch {
		position: relative;
		flex-shrink: 0;
		width: 30px;
		height: 17px;
		margin-top: 1px;
		border-radius: 99px;
		border: 1px solid var(--border);
		background: var(--bg);
	}

	.sp-switch::after {
		content: '';
		position: absolute;
		top: 2px;
		left: 2px;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--text-muted);
	}

	.sp-switch--on {
		background: var(--cta, var(--accent));
		border-color: transparent;
	}

	.sp-switch--on::after {
		transform: translateX(13px);
		background: #fff;
	}

	.sp-member-list {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.sp-member-row {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 6px 9px;
		border-radius: 8px;
		background: var(--surface);
		flex-wrap: wrap;
	}

	.sp-member-pic {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		font-size: 8px;
		font-weight: 650;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 14%, transparent);
	}

	.sp-member-name {
		font-size: 11.5px;
		font-weight: 600;
		color: var(--text);
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sp-member-dot {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 8px;
	}

	.sp-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #6b7280;
	}

	.sp-dot--on {
		background: #22c55e;
	}

	.sp-invite-box {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-top: 8px;
		padding-top: 10px;
		border-top: 1px solid var(--border);
	}

	.sp-invite-row {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: nowrap;
	}

	.sp-invite-code {
		flex: 1;
		min-width: 0;
		padding: 4px 9px;
		border: 1px dashed var(--border);
		border-radius: 7px;
		background: var(--surface);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 11.5px;
		letter-spacing: 1px;
		color: var(--text);
	}

	.sp-inline-input {
		flex: 1;
		min-width: 0;
		padding: 5px 8px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface);
		color: var(--text-muted);
		font-size: 12px;
	}

	.sp-btn {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 5px 10px;
		border: 1px solid var(--border);
		border-radius: 7px;
		background: var(--surface);
		color: var(--text-secondary);
		font-size: 10.5px;
		font-weight: 600;
		flex-shrink: 0;
	}

	/* icon-only until the rail is dragged past 336px, which it is not here */
	.sp-btn--icon {
		padding: 5px 7px;
	}

	.sp-btn--danger {
		color: var(--danger);
		border-color: color-mix(in srgb, var(--danger) 34%, transparent);
	}

	.sp-rules-foot {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
		flex-shrink: 0;
		padding: 10px 12px;
		border-top: 1px solid var(--border);
	}

	.sp-danger-note {
		font-size: 10px;
		font-weight: 500;
		color: var(--text-muted);
		line-height: 1.4;
	}

	/* ---- bento grid of small tiles ---- */
	.bento {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 0.9rem;
	}

	.tile {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		margin: 0;
		display: flex;
		flex-direction: column;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.tile--s2 {
		grid-column: span 2;
	}

	.tile--s3 {
		grid-column: span 3;
	}

	.tile--band {
		grid-column: 1 / -1;
		flex-direction: row;
		align-items: stretch;
	}

	.tile.tile--band .mock {
		flex: 0 0 clamp(424px, 44%, 480px);
		border-bottom: none;
		border-right: 1px solid var(--border);
		justify-content: center;
	}

	.tile--band figcaption {
		align-self: center;
	}

	.tile .mock {
		flex: 1;
		justify-content: center;
	}

	.tile:hover {
		border-color: var(--border-light);
		transform: translateY(-2px);
	}

	.mock {
		padding: 0.9rem;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	figcaption {
		padding: 0.7rem 0.95rem 0.9rem;
		font-size: 0.82rem;
		color: var(--text-secondary);
	}

	.tile figcaption strong {
		display: block;
		font-family: var(--font-display);
		font-size: 0.95rem;
		color: var(--text);
		margin-bottom: 0.2rem;
		letter-spacing: -0.01em;
	}

	.muted {
		color: var(--text-muted);
		font-size: 0.68rem;
	}

	/* ---- Quick Paste popup: 340px wide, the app's own metrics ---- */
	.mock--popup {
		display: flex;
		justify-content: center;
		padding: 0.9rem 0;
	}

	.pp {
		position: relative;
		width: 340px;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		padding: 10px 10px 4px;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
		font-size: 13px;
		line-height: normal;
	}

	.pp-header {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 2px 2px 6px;
	}

	.pp-header-left {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.pp-title {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--accent);
	}

	.pp-count {
		font-size: 10px;
		font-weight: 600;
		color: var(--text-muted);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 3px 8px;
		line-height: 1;
		letter-spacing: 0.2px;
	}

	.pp-tabs {
		display: flex;
		gap: 1px;
		margin-left: auto;
		margin-right: 6px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 2px;
	}

	.pp-tab {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: 10px;
		font-weight: 600;
		color: var(--text-muted);
		border-radius: 4px;
		padding: 3px 8px;
		line-height: 1;
	}

	.pp-tab--active {
		background: var(--accent-dim);
		color: var(--accent);
	}

	.pp-tab-count {
		font-size: 9px;
		font-weight: 600;
		color: var(--text-muted);
		min-width: 14px;
		text-align: center;
	}

	.pp-tab--active .pp-tab-count {
		color: var(--accent);
	}

	.pp-close {
		width: 22px;
		height: 22px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-muted);
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 6px;
		flex-shrink: 0;
	}

	.pp-list {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.pp-item {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 7px 10px;
		min-height: 40px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface);
		color: var(--text);
		font-size: 12px;
	}

	/* selected row: accent border, and the badge picks up accent - no fill */
	.pp-item--selected {
		border-color: var(--accent);
	}

	.pp-item--selected .pp-badge {
		color: var(--accent);
	}

	.pp-badge {
		width: 20px;
		height: 20px;
		border-radius: 5px;
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--text-muted);
		font-size: 10px;
		font-weight: 600;
		font-family: 'Cascadia Code', 'Fira Code', Consolas, monospace;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.pp-wrap {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 8px;
		overflow: hidden;
	}

	.pp-filename {
		font-size: 11px;
		color: var(--text-secondary);
		font-family: 'Cascadia Code', 'Fira Code', Consolas, monospace;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		min-width: 0;
		flex: 1;
	}

	.pp-meta {
		display: flex;
		align-items: center;
		gap: 4px;
		flex-shrink: 0;
	}

	.pp-pin {
		color: var(--accent);
		display: flex;
	}

	.pp-time {
		font-size: 10px;
		color: var(--text-muted);
		white-space: nowrap;
	}

	/* looping cursor that clicks slot 2 */
	.pp-cursor {
		position: absolute;
		top: 0;
		left: 0;
		pointer-events: none;
		animation: ppCursor 6.5s ease-in-out infinite;
		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
	}

	.pp-ring {
		position: absolute;
		top: -5px;
		left: -5px;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		border: 2px solid var(--accent);
		opacity: 0;
		animation: ppRing 6.5s ease-out infinite;
	}

	@keyframes ppCursor {
		0%, 12% { transform: translate(210px, 190px); opacity: 0; }
		22% { opacity: 1; }
		38% { transform: translate(190px, 60px); opacity: 1; }
		52%, 60% { transform: translate(176px, 92px); opacity: 1; }
		56% { transform: translate(176px, 92px) scale(0.85); }
		80% { transform: translate(210px, 190px); opacity: 1; }
		88%, 100% { transform: translate(210px, 190px); opacity: 0; }
	}

	@keyframes ppRing {
		0%, 54% { opacity: 0; transform: scale(0.4); }
		56% { opacity: 0.9; transform: scale(0.5); }
		64% { opacity: 0; transform: scale(1.5); }
		100% { opacity: 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		.pp-cursor,
		.pp-ring {
			animation: none;
			opacity: 0;
		}
	}

	/* ---- capture popup ---- */
	.cp {
		height: 248px;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		padding: 10px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
		line-height: normal;
	}

	.cp-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 2px;
	}

	.cp-head-left {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.cp-title {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--accent);
	}

	.cp-close {
		width: 22px;
		height: 22px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-muted);
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 6px;
		flex-shrink: 0;
	}

	.cp-preview {
		flex: 1;
		min-height: 0;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		padding: 8px 10px;
	}

	.cp-preview-text {
		margin: 0;
		font-size: 11.5px;
		line-height: 1.5;
		color: var(--text-secondary);
		font-family: 'Cascadia Code', 'Fira Code', Consolas, monospace;
	}

	.cp-actions {
		display: flex;
		gap: 1px;
	}

	.cp-item {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 6px 9px;
		border-radius: var(--radius-xs);
		color: var(--text);
		font-size: 12px;
	}

	.cp-item--danger {
		color: var(--text);
	}

	.cp-sep {
		width: 1px;
		align-self: stretch;
		background: var(--border);
		margin: 3px 2px;
	}

	/* ---- account screen: the sync-mode segment, from AccountScreen.css ---- */
	.acct-mode {
		display: flex;
		flex-direction: column;
		gap: 5px;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
	}

	.acct-mode-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 26px;
	}

	.acct-seg {
		display: flex;
		gap: 2px;
		padding: 2px;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--bg);
	}

	.acct-seg-pill {
		font-size: 11.5px;
		font-weight: 500;
		color: var(--text-muted);
		border-radius: 6px;
		padding: 4px 10px;
	}

	.acct-seg-pill.active {
		color: var(--text);
		background: var(--surface-hover);
	}

	.acct-card-desc {
		margin: 0;
		font-size: 12px;
		line-height: 1.45;
		color: var(--text-muted);
	}

	.acct-mode-note {
		margin: 2px 0 0;
		font-size: 10.5px;
		line-height: 1.4;
		color: var(--text-muted);
	}

	.sp-badge--warn {
		border-color: rgba(245, 158, 11, 0.4);
		color: #f59e0b;
		text-transform: none;
		letter-spacing: 0;
	}

	/* ---- settings screen: the update card, from SettingsScreen.css ---- */
	.set-section {
		display: flex;
