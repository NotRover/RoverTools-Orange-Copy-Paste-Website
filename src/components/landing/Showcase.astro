	/* filter counts */
	/* the filter card itself, from SearchFilter.css - the single-column shell
	   is 304px in the app, so the mock draws it at exactly that */
	.mock--filter {
		align-items: center;
		justify-content: center;
	}

	/* ---- notes: the note card, from note-card.css ---- */
	/* the notes grid, the way NotesScreen.css draws it: columns, a 10px gutter,
	   and a card that never breaks across a column. A wide tile fits two. */
	.tile .mock--notes {
		display: block;
		columns: 2;
		column-gap: 10px;
	}

	.mock--notes .ns-card {
		break-inside: avoid;
		margin-bottom: 10px;
	}

	/* note previews carry real markdown: a table, a quote, a paragraph */
	.ns-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 11px;
		margin: 0.3em 0;
	}

	.ns-table :is(th, td) {
		padding: 2px 5px;
		line-height: 1.3;
		border: 1px solid var(--border);
		text-align: left;
