		margin-top: 1px;
		border-radius: 99px;
		border: 1px solid var(--border);
		background: var(--bg);
	}

	.sp-switch::after {
		content: '';
		position: absolute;
		top: 2px;
		left: 2px;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--text-muted);
	}

	.sp-switch--on {
		background: var(--cta, var(--accent));
		border-color: transparent;
	}

	.sp-switch--on::after {
		transform: translateX(13px);
		background: #fff;
	}

	.sp-member-list {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.sp-member-row {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 6px 9px;
		border-radius: 8px;
		background: var(--surface);
		flex-wrap: wrap;
	}

	.sp-member-pic {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		font-size: 8px;
		font-weight: 650;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 14%, transparent);
	}

	.sp-member-name {
		font-size: 11.5px;
		font-weight: 600;
		color: var(--text);
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sp-member-dot {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 8px;
	}

	.sp-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #6b7280;
	}

	.sp-dot--on {
		background: #22c55e;
	}

	.sp-invite-box {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-top: 8px;
		padding-top: 10px;
		border-top: 1px solid var(--border);
	}

	.sp-invite-row {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: nowrap;
	}

	.sp-invite-code {
		flex: 1;
		min-width: 0;
		padding: 4px 9px;
		border: 1px dashed var(--border);
		border-radius: 7px;
		background: var(--surface);
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
		font-size: 11.5px;
		letter-spacing: 1px;
		color: var(--text);
	}

	.sp-inline-input {
		flex: 1;
		min-width: 0;
		padding: 5px 8px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface);
		color: var(--text-muted);
		font-size: 12px;
	}

	.sp-btn {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 5px 10px;
		border: 1px solid var(--border);
		border-radius: 7px;
		background: var(--surface);
		color: var(--text-secondary);
		font-size: 10.5px;
		font-weight: 600;
		flex-shrink: 0;
	}

	/* icon-only until the rail is dragged past 336px, which it is not here */
	.sp-btn--icon {
		padding: 5px 7px;
	}

	.sp-btn--danger {
		color: var(--danger);
		border-color: color-mix(in srgb, var(--danger) 34%, transparent);
	}

	/* Icon-only until the rail is dragged past 336px, which is the app's own
	   rule - this shot is drawn at 340, so the labels are in. */
	.sp-btn-label {
		display: none;
	}

	.sp-rules--wide .sp-btn-label {
		display: inline;
	}

	.sp-rules--wide :global(.sp-btn--icon) {
		padding: 5px 9px;
	}

	.sp-member-remove {
		padding: 3px 8px;
		border-radius: 6px;
		font-size: 10px;
	}

	/* the invite-by-email field, drawn as static text since nothing is typed */
	.sp-inline-input {
		flex: 1;
		min-width: 0;
		padding: 5px 8px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface);
		color: var(--text-muted);
		font-size: 12px;
		box-sizing: border-box;
	}

	.sp-rules-foot {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 6px;
		flex-shrink: 0;
		padding: 10px 12px;
		border-top: 1px solid var(--border);
	}

	.sp-danger-note {
		font-size: 10px;
		font-weight: 500;
		color: var(--text-muted);
		line-height: 1.4;
	}

	/* ---- rows layout, values from .sp-list-* in SpacesScreen.css ---- */
	.sp-feed-card-list {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.sp-list-card {
		display: flex;
		align-items: center;
		gap: 8px;
		height: 38px;
		padding: 0 10px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface);
		overflow: hidden;
	}

	.sp-list-card--note {
		height: 46px;
	}

	/* Accent is reserved for what this account sent: if a row is orange, you
	   put it there. */
	.sp-list-dir {
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		border: 1px solid transparent;
		border-radius: var(--radius-xs);
	}

	.sp-list-dir--in {
		background: var(--surface-hover);
		border-color: var(--border-light);
		color: var(--text-secondary);
	}

	.sp-list-dir--out {
		background: var(--accent-dim);
		color: var(--accent);
	}

	.sp-list-type-wrap {
		flex-shrink: 0;
		display: flex;
		align-items: center;
	}

	.sp-list-note-badge {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		border-radius: var(--radius-xs);
		background: var(--accent-dim);
		color: var(--accent);
	}

	.sp-list-note-content {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.sp-list-title {
		font-size: 12px;
		font-weight: 500;
		color: var(--text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.sp-list-text {
		flex: 1;
		min-width: 0;
		font-size: 11.5px;
		color: var(--text-secondary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.sp-list-preview {
		font-size: 10.5px;
		color: var(--text-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.sp-list-time {
		flex-shrink: 0;
		font-size: 10.5px;
		color: var(--text-muted);
		white-space: nowrap;
	}

	/* ---- the rows-layout shot ---- */
	.mock--rows {
		display: flex;
		flex-direction: column;
		gap: 8px;
		align-items: stretch;
		justify-content: flex-start;
	}

	.rows-head {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.rows-head-label {
		font-size: 10.5px;
		font-weight: 700;
		letter-spacing: 0.3px;
		text-transform: uppercase;
		color: var(--text-muted);
	}

	/* the layout segment with the right half selected */
	.oc-seg-slider--right {
		left: auto;
		right: 2px;
	}

	/* ---- bento grid of small tiles ---- */
	/* Twelve columns, so a row can be split unevenly. Three rows of two, each
	   split the other way from the row above, and the two tiles in a row stretch
	   to the same height: every horizontal edge in the block lines up, while no
	   two tiles side by side are the same width. The narrower span still has to
	   clear the panel the app draws inside it, so nothing goes below five. */
	.bento {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 0.9rem;
	}

	.tile--c3 {
		grid-column: span 3;
	}

	.tile--c4 {
		grid-column: span 4;
	}

	.tile--c5 {
		grid-column: span 5;
	}

	.tile--c7 {
		grid-column: span 7;
	}

	.tile {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		/* a figure carries a 40px UA margin, which in a grid track eats 80px of
		   the column and leaves the 340px popup inside it clipped */
		margin: 0;
		display: flex;
		flex-direction: column;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	/* The mock takes the room the caption does not, and gives way when its
	   content is taller than that: without min-height:0 a flex item refuses to
	   shrink past its content and pushes the caption out of the tile. Cropping a
	   scrolled list is the honest outcome; hiding the caption is not. */
	.tile .mock {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		justify-content: center;
	}

	.tile:hover {
		border-color: var(--border-light);
		transform: translateY(-2px);
	}

	.mock {
		padding: 0.9rem;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	figcaption {
		padding: 0.7rem 0.95rem 0.9rem;
		font-size: 0.82rem;
		color: var(--text-secondary);
	}

	.tile figcaption strong {
		display: block;
		font-family: var(--font-display);
		font-size: 0.95rem;
		color: var(--text);
		margin-bottom: 0.2rem;
		letter-spacing: -0.01em;
	}

	.muted {
		color: var(--text-muted);
		font-size: 0.68rem;
	}

	/* the menu hangs off the tile, not the window shell, so the card behind it can
	   sit at the top and the menu overlap it from the corner where the pointer was */
	.tile .mock--menu {
		position: relative;
		justify-content: flex-start;
		/* the menu is absolutely positioned, so the mock has to be told to leave
		   room for it - the card behind it is only 90px tall */
		min-height: 292px;
	}

	.mock--menu :global(.oc-menu) {
		top: 8px;
		left: 40%;
	}

	/* ---- the note editor, from notes-screen/note-editor/note-editor.css ---- */
	/* The editor fills its pane in the app, so the mock gives it the tile: one
	   column, no centring, and the panel takes the whole width it is given. */
	.mock--editor {
		align-items: center;
		justify-content: center;
	}

	/* a panel, not a screen: fixed width, its own border, centred on the tile */
	.ns-editor {
		width: 420px;
		display: flex;
		flex-direction: column;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
		overflow: hidden;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
	}

	.ns-format-bar {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		row-gap: 4px;
		padding: 6px 12px;
		border-bottom: 1px solid var(--border);
		flex-shrink: 0;
	}

	.ns-fmt-group {
		display: inline-flex;
		align-items: center;
		gap: 1px;
	}

	.ns-fmt-group + .ns-fmt-group {
		margin-left: 6px;
		padding-left: 7px;
		border-left: 1px solid var(--border);
	}

	.ns-fmt-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 6px;
		color: var(--text-muted);
		flex-shrink: 0;
	}

	.ns-fmt-btn--active {
		color: var(--accent);
		background: rgba(255, 62, 28, 0.12);
	}

	.ns-fmt-btn--dropdown {
		width: auto;
		gap: 4px;
		padding: 0 7px;
		font-size: 11.5px;
		font-weight: 700;
	}

	.ns-editor-content {
		padding: 12px;
		font-size: 12px;
		line-height: 1.5;
		color: var(--text-secondary);
	}

	.ed-h {
		margin: 0 0 0.4em;
		color: var(--text);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	/* an entry pulled into a note: a coloured pill that opens a panel under
	   itself, from notes-screen/editor-engine. Type tints mirror the entry chips. */
	.ee-clip-embed {
		display: inline-flex;
		flex-direction: column;
		align-items: stretch;
		max-width: 100%;
		margin: 2px 2px 0;
		vertical-align: middle;
	}

	.ee-clip-embed-inner {
		display: flex;
		align-items: center;
		gap: 5px;
		padding: 3px 5px 3px 7px;
		border-radius: 7px;
		font-size: 0.82em;
		font-weight: 600;
		line-height: 1.4;
		white-space: nowrap;
	}

	.ee-clip-embed-inner--url {
		background: rgba(16, 185, 129, 0.12);
		color: #10b981;
	}

	/* open: the pill and the panel become one shape */
	.ee-clip-embed--open .ee-clip-embed-inner {
		border-bottom-left-radius: 0;
		border-bottom-right-radius: 0;
	}

	.ee-clip-embed-icon {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
		opacity: 0.85;
	}

	.ee-clip-embed-label {
		max-width: 220px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		letter-spacing: 0.01em;
	}

	.ee-embed-panel {
		display: flex;
		flex-direction: column;
		width: 100%;
		min-width: 320px;
		max-width: 340px;
		border: 1px solid var(--border);
		border-top: none;
		border-radius: 0 0 8px 8px;
		background: var(--surface);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.16);
		overflow: hidden;
	}

	.ee-embed-panel-meta {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 5px 10px 4px;
		border-bottom: 1px solid var(--border);
		background: #1c1c1c;
	}

	.ee-embed-panel-type {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: #10b981;
		font-size: 10px;
		font-weight: 650;
		letter-spacing: 0.3px;
		text-transform: uppercase;
	}

	.ee-embed-panel-time {
		margin-left: auto;
		font-size: 10px;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}

	.ee-embed-panel-body {
		padding: 9px 10px;
		font-family: var(--font-mono);
		font-size: 11px;
		line-height: 1.45;
		color: var(--text-secondary);
		word-break: break-all;
	}

	/* the storage zone's breakdown by type, from AccountScreen.css */
	.acct-comp {
		display: flex;
		flex-direction: column;
		gap: 9px;
		padding: 11px 14px 10px;
		border-top: 1px solid var(--border);
	}

	.acct-comp-head {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.acct-comp-total {
		margin-left: auto;
		font-size: 11.5px;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}

	.acct-comp-bar {
		display: flex;
		height: 6px;
		border-radius: 3px;
		overflow: hidden;
		background: rgba(240, 240, 240, 0.08);
	}

	.acct-comp-seg {
		height: 100%;
		box-shadow: inset -1px 0 0 var(--surface);
	}

	.acct-comp-seg:last-child {
		box-shadow: none;
	}

	.acct-comp-legend {
		display: flex;
		flex-direction: column;
	}

	.acct-comp-row {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 5px 6px;
		margin: 0 -6px;
		border-radius: var(--radius-xs);
		color: var(--text);
		font-size: 12px;
	}

	.acct-comp-dot {
		width: 8px;
		height: 8px;
		border-radius: 2px;
		flex-shrink: 0;
	}

	.acct-comp-label {
		flex: 1;
		min-width: 0;
	}

	.acct-comp-count {
		font-weight: 550;
		font-variant-numeric: tabular-nums;
	}

	.acct-comp-pct {
		width: 34px;
		text-align: right;
		font-size: 11.5px;
		color: var(--text-muted);
		font-variant-numeric: tabular-nums;
	}

	/* ---- the two popouts: same shell, from NotificationsPopout.css and
	   InvitesPopover.css. They float over the app, so they keep the page ground
	   rather than the surface the tile is drawn on. ---- */
	.tile .mock--pop {
		align-items: center;
		justify-content: flex-start;
	}

	.inv-pop,
	.ntf-panel {
		display: flex;
		flex-direction: column;
		background: var(--bg);
		border: 1px solid var(--border-light);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		overflow: hidden;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
	}

	.inv-pop {
		width: 300px;
	}

	.ntf-panel {
		width: 336px;
	}

	.inv-head,
	.ntf-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 8px;
		padding: 10px 12px;
		border-bottom: 1px solid var(--border);
	}

	.inv-title,
	.ntf-title {
		font-size: 13px;
		font-weight: 600;
		color: var(--text);
	}

	.ntf-head-actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.ntf-link {
		font-size: 11px;
		color: var(--text-secondary);
	}

	.inv-tabs,
	.ntf-chips {
		display: flex;
		gap: 4px;
		padding: 7px 12px;
		border-bottom: 1px solid var(--border);
	}

	.inv-tab,
	.ntf-chip {
		display: flex;
		align-items: center;
		gap: 4px;
		padding: 3px 8px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		color: var(--text-secondary);
		font-size: 10px;
	}

	.inv-tab.active,
	.ntf-chip.active {
		background: var(--accent-dim-strong);
		border-color: transparent;
		color: var(--accent);
	}

	.inv-tab-count,
	.ntf-chip-count {
		font-size: 9px;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}

	.inv-row {
		padding: 9px 12px 10px;
		border-bottom: 1px solid var(--border);
	}

	.inv-row:last-child {
		border-bottom: none;
	}

	.inv-row-space {
		margin: 0;
		font-size: 12px;
		font-weight: 600;
		line-height: 1.45;
		color: var(--text);
	}

	.inv-row-sub {
		margin: 1px 0 0;
		font-size: 11px;
		line-height: 1.4;
		color: var(--text-secondary);
	}

	.inv-row-meta {
		font-size: 10px;
		color: var(--text-muted);
	}

	.inv-row-actions,
	.ntf-actions {
		display: flex;
		gap: 6px;
		margin-top: 7px;
	}

	.inv-btn,
	.ntf-btn {
		padding: 3px 10px;
		border: 1px solid var(--border-light);
		border-radius: var(--radius-xs);
		color: var(--text-secondary);
		font-size: 11px;
	}

	.inv-btn--primary,
	.ntf-btn--primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	/* the day header sticks to the top of the feed in the app; here it is just
	   the label that starts a group */
	.ntf-day {
		padding: 9px 12px 7px;
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.4px;
		text-transform: uppercase;
		color: var(--accent);
	}

	.ntf-row {
		position: relative;
		display: flex;
		gap: 10px;
		padding: 11px 12px;
		border-bottom: 1px solid var(--border);
	}

	.ntf-row:last-child {
		border-bottom: none;
	}

	/* unread: a tinted ground and an accent rail, so the state reads in a
	   screenshot as well as under a cursor */
	.ntf-row.unread {
		background: var(--accent-dim);
	}

	.ntf-row.unread::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--accent);
	}

	.ntf-row.unread .ntf-row-title {
		font-weight: 600;
	}

	.ntf-glyph {
		width: 26px;
		height: 26px;
		flex-shrink: 0;
		border-radius: var(--radius-xs);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.ntf-glyph--accent {
		background: var(--accent-dim-strong);
		color: var(--accent);
	}

	.ntf-glyph--good {
		background: rgba(34, 197, 94, 0.13);
		color: var(--success);
	}

	.ntf-glyph--warn {
		background: rgba(245, 158, 11, 0.15);
		color: #f59e0b;
	}

	.ntf-body {
		flex: 1;
		min-width: 0;
		padding-right: 18px;
	}

	.ntf-row-title {
		margin: 0;
		font-size: 12px;
		line-height: 1.45;
		color: var(--text);
	}

	.ntf-row-sub {
		margin: 2px 0 0;
		font-size: 11px;
		line-height: 1.45;
		color: var(--text-secondary);
	}

	.ntf-row-meta {
		margin: 3px 0 0;
		font-size: 10px;
		color: var(--text-muted);
	}

	/* ---- the bulk actions bar, from bulk-actions/BulkActionsBar.css. In the app
	   it floats under the select toggle with a flyout hanging off one chip; here
	   the bar sits on the tile and the Share flyout is open. ---- */
	.tile .mock--bulk {
		align-items: center;
		justify-content: flex-start;
		/* the flyout is out of flow, so the mock is told to leave room for it */
		min-height: 186px;
	}

	/* ---- Quick Paste popup: 340px wide, the app's own metrics ---- */
	.mock--popup {
		align-items: center;
		padding: 0.9rem 0;
	}

	.pp {
		position: relative;
		width: 340px;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		padding: 10px 10px 4px;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
		font-size: 13px;
		line-height: normal;
	}

	.pp-header {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 2px 2px 6px;
	}

	.pp-header-left {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.pp-title {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--accent);
	}

	.pp-count {
		font-size: 10px;
		font-weight: 600;
		color: var(--text-muted);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 3px 8px;
		line-height: 1;
		letter-spacing: 0.2px;
	}

	.pp-tabs {
		display: flex;
		gap: 1px;
		margin-left: auto;
		margin-right: 6px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 2px;
	}

	.pp-tab {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: 10px;
		font-weight: 600;
		color: var(--text-muted);
		border-radius: 4px;
		padding: 3px 8px;
		line-height: 1;
	}

	.pp-tab--active {
		background: var(--accent-dim);
		color: var(--accent);
	}

	.pp-tab-count {
		font-size: 9px;
		font-weight: 600;
		color: var(--text-muted);
		min-width: 14px;
		text-align: center;
	}

	.pp-tab--active .pp-tab-count {
		color: var(--accent);
	}

	.pp-close {
		width: 22px;
		height: 22px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-muted);
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 6px;
		flex-shrink: 0;
	}

	.pp-list {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.pp-item {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 7px 10px;
		min-height: 40px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface);
		color: var(--text);
		font-size: 12px;
	}

	/* selected row: accent border, and the badge picks up accent - no fill */
	.pp-item--selected {
		border-color: var(--accent);
	}

	.pp-item--selected .pp-badge {
		color: var(--accent);
	}

	.pp-badge {
		width: 20px;
		height: 20px;
		border-radius: 5px;
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--text-muted);
		font-size: 10px;
		font-weight: 600;
		font-family: 'Cascadia Code', 'Fira Code', Consolas, monospace;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.pp-wrap {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 8px;
		overflow: hidden;
	}

	.pp-filename {
		font-size: 11px;
		color: var(--text-secondary);
		font-family: 'Cascadia Code', 'Fira Code', Consolas, monospace;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		min-width: 0;
		flex: 1;
	}

	.pp-meta {
		display: flex;
		align-items: center;
		gap: 4px;
		flex-shrink: 0;
	}

	.pp-pin {
		color: var(--accent);
		display: flex;
	}

	.pp-time {
		font-size: 10px;
		color: var(--text-muted);
		white-space: nowrap;
	}

	/* looping cursor that clicks slot 2 */
	.pp-cursor {
		position: absolute;
		top: 0;
		left: 0;
		pointer-events: none;
		animation: ppCursor 6.5s ease-in-out infinite;
		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
	}

	.pp-ring {
		position: absolute;
		top: -5px;
		left: -5px;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		border: 2px solid var(--accent);
		opacity: 0;
		animation: ppRing 6.5s ease-out infinite;
	}

	@keyframes ppCursor {
		0%, 12% { transform: translate(210px, 190px); opacity: 0; }
		22% { opacity: 1; }
		38% { transform: translate(190px, 60px); opacity: 1; }
		52%, 60% { transform: translate(176px, 92px); opacity: 1; }
		56% { transform: translate(176px, 92px) scale(0.85); }
		80% { transform: translate(210px, 190px); opacity: 1; }
		88%, 100% { transform: translate(210px, 190px); opacity: 0; }
	}

	@keyframes ppRing {
		0%, 54% { opacity: 0; transform: scale(0.4); }
		56% { opacity: 0.9; transform: scale(0.5); }
		64% { opacity: 0; transform: scale(1.5); }
		100% { opacity: 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		.pp-cursor,
		.pp-ring {
			animation: none;
			opacity: 0;
		}
	}

	/* ---- capture popup ---- */
	.cp {
		width: 340px;
		height: 248px;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		padding: 10px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
		line-height: normal;
	}

	.cp-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 2px;
	}

	.cp-head-left {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.cp-title {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--accent);
	}

	.cp-close {
		width: 22px;
		height: 22px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-muted);
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 6px;
		flex-shrink: 0;
	}

	.cp-preview {
		flex: 1;
		min-height: 0;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		padding: 8px 10px;
	}

	.cp-preview-text {
		margin: 0;
		font-size: 11.5px;
		line-height: 1.5;
		color: var(--text-secondary);
		font-family: 'Cascadia Code', 'Fira Code', Consolas, monospace;
	}

	.cp-actions {
		display: flex;
		gap: 1px;
	}

	.cp-item {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 6px 9px;
		border-radius: var(--radius-xs);
		color: var(--text);
		font-size: 12px;
	}

	.cp-item--danger {
		color: var(--text);
	}

	.cp-sep {
		width: 1px;
		align-self: stretch;
		background: var(--border);
		margin: 3px 2px;
	}

	/* ---- account screen: the sync-mode segment, from AccountScreen.css ---- */
	.acct-mode {
		display: flex;
		flex-direction: column;
		gap: 5px;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
	}

	.acct-mode-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		min-height: 26px;
	}

	.acct-seg {
