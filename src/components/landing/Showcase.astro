---
import '../../styles/mocks/spaces.css';
import '../../styles/mocks/account.css';
import '../../styles/mocks/notes.css';
import '../../styles/mocks/popouts.css';
import BulkBar from './BulkBar.astro';
import FilterCard from './FilterCard.astro';
import CardMenu from './CardMenu.astro';
import CapturePopup from './mocks/CapturePopup.astro';
import DevicesPanel from './mocks/DevicesPanel.astro';
import HistoryShot from './mocks/HistoryShot.astro';
import InvitesPopout from './mocks/InvitesPopout.astro';
import NoteCards from './mocks/NoteCards.astro';
import NoteEditor from './mocks/NoteEditor.astro';
import NotificationsPopout from './mocks/NotificationsPopout.astro';
import QuickPastePopup from './mocks/QuickPastePopup.astro';
import RowsList from './mocks/RowsList.astro';
import ShortcutsPanel from './mocks/ShortcutsPanel.astro';
import SpaceMembers from './mocks/SpaceMembers.astro';
import SpaceRules from './mocks/SpaceRules.astro';
import SpacesShot from './mocks/SpacesShot.astro';
import StorageZone from './mocks/StorageZone.astro';
import { CHIP_ICONS, KIND_COLORS, GROUP_COLORS } from './app-parts';


---

<section class="section show" id="showcase">
	<div class="wrap">
		<p class="eyebrow reveal">In the app</p>
		<h2 class="section-title reveal">Every surface, up close.</h2>
		<p class="section-lead reveal">
			Real screens, drawn at the sizes the app renders them. Nothing here is a
			stylised version of the product.
		</p>

		<!-- wide shot: the clipboard screen -->
		<figure class="wide reveal">
			<HistoryShot />
			<figcaption>
				<strong>The history screen</strong>
				Sort, filters, search and a three-way layout switch across the top; day groups
				on a timeline; the entry sitting on your clipboard outlined in orange.
			</figcaption>
		</figure>

		<!-- the two popups, shown at the size the app opens them -->
		<div class="popups reveal">
			<figure class="popup-shot">
				<div class="popup-stage">
					<CapturePopup />
				</div>
				<figcaption>
					<strong>The copy popup</strong>
					Ctrl+Shift+C shows what the app just captured. Pin it, add it to a group, share it
					to a space, or delete it, without opening the window.
				</figcaption>
			</figure>
			<figure class="popup-shot">
				<div class="popup-stage">
					<QuickPastePopup />
				</div>
				<figcaption>
					<strong>Quick Paste</strong>
					Ctrl+Shift+V opens it at your cursor. Press a number to paste that entry, arrow
					through the list, or type to search; the side panel previews whatever is selected.
				</figcaption>
			</figure>
		</div>

		<!-- wide shot: the spaces screen -->
		<figure class="wide wide--spaces reveal">
			<SpacesShot />
			<figcaption>
				<strong>The Spaces screen</strong>
				Your spaces on the left, the shared feed in the middle, and the rules and people
				for that space on the right. Both side panels resize and stay where you put them.
			</figcaption>
		</figure>

		<div class="bento">
			<figure class="tile tile--c7 tile--full reveal">
				<div class="mock mock--filter">
					<FilterCard />
				</div>
				<figcaption>
					<strong>Filters that count ahead</strong>
					Every type, cloud state and space carries the number of items it would leave
					you, counted before you click it.
				</figcaption>
			</figure>
			<figure class="tile tile--c5 reveal">
				<div class="mock mock--rows">
					<RowsList />
				</div>
				<figcaption>
					<strong>Cards or rows</strong>
					The same shared feed as one line per item. The arrow says which way it went:
					orange for what you sent, grey for what arrived.
				</figcaption>
			</figure>
			<figure class="tile tile--c7 reveal">
				<div class="mock mock--notes">
					<NoteCards />
				</div>
				<figcaption>
					<strong>Notes, in the same window</strong>
					Task lists, tables, code and quotes. A note pins, tags and shares exactly like a
					copied item.
				</figcaption>
			</figure>
			<figure class="tile tile--c5 reveal">
				<div class="mock mock--editor">
					<NoteEditor />
				</div>
				<figcaption>
					<strong>A real editor, not a text box</strong>
					Headings, checklists, tables, code and colors. Drop a copied item into the text
					and it stays linked, openable in place.
				</figcaption>
			</figure>
			<figure class="tile tile--c5 reveal">
				<div class="mock mock--panel mock--account mock--shrink-sc">
					<ShortcutsPanel />
				</div>
				<figcaption>
					<strong>Everything has a key</strong>
					Capture and paste without opening the window. The popup answers to digits,
					arrows and Esc, and the app lists every binding it uses.
				</figcaption>
			</figure>
			<figure class="tile tile--c7 reveal">
				<div class="mock mock--bulk">
					<BulkBar />
				</div>
				<figcaption>
					<strong>Do it to a hundred at once</strong>
					Tick the items and pin, save, tag, upload or share the lot. The space list
					checks the ones every selected item is already in.
				</figcaption>
			</figure>
			<figure class="tile tile--c5 reveal">
				<div class="mock mock--menu">
					<div class="oc-card oc-card--in-clipboard">
						<div class="oc-card-body">
							<p class="oc-card-text">Meet at the station, platform 4, 9:40. Bring the badge for the side door.</p>
							<div class="oc-card-footer">
								<span class="oc-chips">
									<span class="oc-chip" style={`--cc:${KIND_COLORS.text}`}><Fragment set:html={CHIP_ICONS.text} /><span class="oc-chip-label">Text</span></span>
									<span class="oc-chip oc-chip--group" style={`--cc:${GROUP_COLORS.teal}`}><span class="oc-chip-dot"></span><span class="oc-chip-label">work</span></span>
								</span>
								<span class="oc-time">Just now</span>
							</div>
						</div>
					</div>
					<CardMenu spaces={2} />
				</div>
				<figcaption>
					<strong>Right-click any item</strong>
					Copy, pin, save, put it in the cloud, share it to a space, tag it, or delete it,
					without leaving the list.
				</figcaption>
			</figure>
			<figure class="tile tile--c7 reveal">
				<div class="mock mock--panel mock--account mock--shrink-st">
					<StorageZone />
				</div>
				<figcaption>
					<strong>You can see what you use</strong>
					The quota sits in the open, per account, and every byte of it was encrypted
					before it left the machine.
				</figcaption>
			</figure>
			<figure class="tile tile--c4 reveal">
				<div class="mock mock--panel">
					<SpaceMembers />
				</div>
				<figcaption>
					<strong>Who is in a space</strong>
					Who is online right now, and a badge on anyone whose device has not picked up
					the space key yet.
				</figcaption>
			</figure>
			<figure class="tile tile--c4 reveal">
				<div class="mock mock--panel">
					<SpaceRules />
				</div>
				<figcaption>
					<strong>Sharing is opt-in</strong>
					Nothing leaves this machine unless you shared it or turned one of these on.
				</figcaption>
			</figure>
			<figure class="tile tile--c4 reveal">
				<div class="mock mock--panel mock--account">
					<DevicesPanel />
				</div>
				<figcaption>
					<strong>Sync per device</strong>
					Realtime, passive or manual, chosen on each machine. Your laptop can stay live
					while your desktop only syncs when you ask.
				</figcaption>
			</figure>
			<figure class="tile tile--c6 reveal">
				<div class="mock mock--panel mock--pop">
					<InvitesPopout />
				</div>
				<figcaption>
					<strong>Nobody joins without you</strong>
					A code gets somebody as far as the door. Requests, invites you were sent and
					invites you sent out all wait in one panel.
				</figcaption>
			</figure>
			<figure class="tile tile--c6 reveal">
				<div class="mock mock--panel mock--pop">
					<NotificationsPopout />
				</div>
				<figcaption>
					<strong>The bell keeps the receipts</strong>
					Space invites and sync warnings land in one feed. Answer an invite from the row
					it arrived on, or filter down to the kind you came for.
				</figcaption>
			</figure>
		</div>
	</div>
</section>

<style>

.show {
	}

/* ---- wide window shots ---- */

.wide {
		margin: 0 0 1.6rem;
	}

/* the app window is 920x560; draw it at that size and zoom the whole shot
	   down on narrow screens so nothing inside it changes proportion */

.wide :global(.oc-window) {
		width: 920px;
		height: 560px;
		margin: 0 auto;
		zoom: var(--mz, 1);
	}

/* Three panels and a three-column feed do not fit 1180: the feed alone needs
	   3 x 240 plus its gaps. Drawn at 1440x830 and scaled to the section measure
	   rather than to the 920 shot, so this one shot is wider than the others -
	   which is the point, it is the screen with the most in it.
	   It gets its own scale ladder (--sz) rather than riding on the 920 shot's
	   --mz: 1440 runs out of room at a different viewport width than 920 does,
	   so multiplying one by a constant overflows on half the steps. */

.wide--spaces :global(.oc-window) {
		width: 1440px;
		height: 830px;
		zoom: var(--sz, 0.8);
	}

.wide--spaces figcaption {
		max-width: 1152px;
	}

.wide + .bento {
		margin-top: 0.4rem;
	}

.wide figcaption {
		padding: 0.9rem 0.2rem 0;
		font-size: 0.85rem;
		color: var(--text-secondary);
		max-width: 920px;
		margin: 0 auto;
	}

.wide figcaption strong {
		display: inline;
		font-family: var(--font-display);
		font-size: 0.95rem;
		color: var(--text);
		margin-right: 0.5rem;
		letter-spacing: -0.01em;
	}

.bento + .wide {
		margin-top: 1.8rem;
	}

/* ---- the rows-layout shot ---- */

.mock--rows {
		display: flex;
		flex-direction: column;
		gap: 8px;
		align-items: stretch;
		justify-content: flex-start;
	}

/* ---- bento grid of small tiles ---- */

/* Twelve columns, so a row can be split unevenly. Three rows of two, each
	   split the other way from the row above, and the two tiles in a row stretch
	   to the same height: every horizontal edge in the block lines up, while no
	   two tiles side by side are the same width. The narrower span still has to
	   clear the panel the app draws inside it, so nothing goes below five. */

.bento {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 0.9rem;
		/* Tiles in a row share a height, so every horizontal edge in the block
		   lines up, and the mock sits in the middle of whatever height that
		   turns out to be - leftover room splits above and below it rather
		   than pooling under it. The one pair too far apart in height to take
		   that treatment opts out with `tile--hug` below. */
		align-items: stretch;
	}

.tile--c3 {
		grid-column: span 3;
	}

.tile--c4 {
		grid-column: span 4;
	}

.tile--c5 {
		grid-column: span 5;
	}

.tile--c6 {
		grid-column: span 6;
	}

.tile--c7 {
		grid-column: span 7;
	}

.tile--c8 {
		grid-column: span 8;
	}

/* Sharing a height is right until the two mocks are nowhere near the same
	   size: the notifications popout is 265 tall and the storage panel beside it
	   451, and centring a shot in 186px of spare tile reads as a hole rather
	   than as breathing room. That one tile takes its own height. */

.tile--hug {
		align-self: start;
	}

.tile {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		/* a figure carries a 40px UA margin, which in a grid track eats 80px of
		   the column and leaves the 340px popup inside it clipped */
		margin: 0;
		display: flex;
		flex-direction: column;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

/* The mock takes the room the caption does not, and gives way when its
	   content is taller than that: without min-height:0 a flex item refuses to
	   shrink past its content and pushes the caption out of the tile. Cropping a
	   scrolled list is the honest outcome; hiding the caption is not. */

.tile .mock {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		justify-content: center;
	}

.tile:hover {
		border-color: var(--border-light);
		transform: translateY(-2px);
	}

.mock {
		padding: 0.9rem;
		background: var(--bg);
		border-bottom: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

figcaption {
		padding: 0.7rem 0.95rem 0.9rem;
		font-size: 0.82rem;
		color: var(--text-secondary);
	}

.tile figcaption strong {
		display: block;
		font-family: var(--font-display);
		font-size: 0.95rem;
		color: var(--text);
		margin-bottom: 0.2rem;
		letter-spacing: -0.01em;
	}

.muted {
		color: var(--text-muted);
		font-size: 0.68rem;
	}

/* the menu hangs off the tile, not the window shell, so the card behind it can
	   sit at the top and the menu overlap it from the corner where the pointer was */

.tile .mock--menu {
		position: relative;
		justify-content: flex-start;
		/* the menu is absolutely positioned, so the mock has to be told to leave
		   room for it - the card behind it is only 90px tall */
		min-height: 292px;
	}

.mock--menu :global(.oc-menu) {
		top: 8px;
		left: 40%;
	}

/* ---- the note editor, from notes-screen/note-editor/note-editor.css ---- */

/* The editor fills its pane in the app, so the mock gives it the tile: one
	   column, no centring, and the panel takes the whole width it is given. */

.mock--editor {
		align-items: center;
		justify-content: center;
	}

/* ---- the two popouts: same shell, from NotificationsPopout.css and
	   InvitesPopover.css. They float over the app, so they keep the page ground
	   rather than the surface the tile is drawn on. ---- */

.tile .mock--pop {
		align-items: center;
		justify-content: center;
	}

/* ---- the bulk actions bar, from bulk-actions/BulkActionsBar.css. In the app
	   it floats under the select toggle with a flyout hanging off one chip; here
	   the bar sits on the tile and the Share flyout is open. ---- */

.tile .mock--bulk {
		align-items: center;
		justify-content: flex-start;
		/* the flyout is out of flow, so the mock is told to leave room for it */
		min-height: 186px;
	}

/* ---- the copy and paste popups, drawn at the app's own window sizes ---- */

/* Out of the bento and shown as their own pair. Each renders at native app px
	   (copy 328, paste 528) and the whole stage scales by `--pz` together, so the
	   two keep their real size relationship; the captions sit outside the zoom and
	   stay full size. They sit side by side, wrapping to a stack when the pair no
	   longer fits, and `--pz` only drops once the wide one alone outgrows the
	   column. */

.popups {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 1.8rem 3rem;
		margin: 0 0 1.8rem;
		--pz: 1;
	}

.popup-shot {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin: 0;
	}

.popup-stage {
		display: inline-flex;
		zoom: var(--pz, 1);
	}

.popup-shot figcaption {
		padding: 0.9rem 0.2rem 0;
		max-width: 30rem;
		font-size: 0.85rem;
		text-align: center;
		color: var(--text-secondary);
	}

.popup-shot figcaption strong {
		display: block;
		margin-bottom: 0.25rem;
		font-family: var(--font-display);
		font-size: 0.95rem;
		letter-spacing: -0.01em;
		color: var(--text);
	}

/* the account screen stacks its zones down one column at a 14px rhythm */

.tile .mock--account {
		display: flex;
		flex-direction: column;
		gap: 14px;
		justify-content: center;
	}

/* filter counts */

/* the filter card itself, from SearchFilter.css - the single-column shell
	   is 304px in the app, so the mock draws it at exactly that */

.mock--filter {
		align-items: center;
		justify-content: center;
	}

/* ---- notes: the note card, from note-card.css ---- */

/* the notes grid, the way NotesScreen.css draws it: columns, a 10px gutter,
	   and a card that never breaks across a column. A wide tile fits two. */

.tile .mock--notes {
		display: block;
		columns: 2;
		column-gap: 10px;
	}

.mock--notes :global(.ns-card) {
		break-inside: avoid;
		margin-bottom: 10px;
	}

/* Uneven spans only while the narrower of the two still clears the 340px
	   popup the app draws inside it, which needs the full 76rem measure. Below
	   that every tile takes a half, then the whole width. */

@media (max-width: 1220px) {
		.bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.tile--c3,
		.tile--c4,
		.tile--c5,
		.tile--c6,
		.tile--c7,
		.tile--c8 {
			grid-column: span 1;
		}

		/* After the span-1 rule, not before it: same specificity, so the last
		   one wins, and a full-row tile carries both classes. The filter card
		   and the actions bar are wider than a half, and were being clipped. */
		.tile--full {
			grid-column: span 2;
		}
	}

/* The window shots only ever scale as a whole, they never reflow. Each step
	   is placed at the width where the step above it stops fitting the column,
	   which is the viewport less the 3rem of section padding: 920 * mz has to
	   stay under it, or the shot bleeds past its figure. */

@media (max-width: 1010px) {
		.wide :global(.oc-window) {
			--mz: 0.82;
		}
	}

@media (max-width: 800px) {
		.wide :global(.oc-window) {
			--mz: 0.68;
		}
	}

@media (max-width: 672px) {
		.wide :global(.oc-window) {
			--mz: 0.55;
		}
	}

@media (max-width: 552px) {
		.wide :global(.oc-window) {
			--mz: 0.44;
		}
	}

@media (max-width: 452px) {
		.wide :global(.oc-window) {
			--mz: 0.36;
		}
	}

@media (max-width: 378px) {
		.wide :global(.oc-window) {
			--mz: 0.3;
		}
	}

@media (max-width: 322px) {
		.wide :global(.oc-window) {
			--mz: 0.25;
		}
	}

/* Each step is the width at which the one above it stops fitting the
	   column, which is the viewport less 3rem of section padding: 1440 * sz has
	   to stay under it. */

@media (max-width: 1200px) {
		.wide--spaces :global(.oc-window) {
			--sz: 0.72;
		}
	}

@media (max-width: 1085px) {
		.wide--spaces :global(.oc-window) {
			--sz: 0.62;
		}
	}

@media (max-width: 941px) {
		.wide--spaces :global(.oc-window) {
			--sz: 0.52;
		}
	}

@media (max-width: 797px) {
		.wide--spaces :global(.oc-window) {
			--sz: 0.43;
		}
	}

@media (max-width: 667px) {
		.wide--spaces :global(.oc-window) {
			--sz: 0.35;
		}
	}

@media (max-width: 552px) {
		.wide--spaces :global(.oc-window) {
			--sz: 0.28;
		}
	}

@media (max-width: 451px) {
		.wide--spaces :global(.oc-window) {
			--sz: 0.22;
		}
	}

@media (max-width: 365px) {
		.wide--spaces :global(.oc-window) {
			--sz: 0.18;
		}
	}

@media (max-width: 307px) {
		.wide--spaces :global(.oc-window) {
			--sz: 0.15;
		}
	}

@media (max-width: 600px) {
		.bento {
			grid-template-columns: minmax(0, 1fr);
		}

		/* One column, so a full-row tile is one column too. Left at `span 2` it
		   asked for a track that no longer exists, the grid grew an implicit
		   second column to hold it, and the explicit `1fr` collapsed to 0px -
		   which crushed every tile that was not full-row to nothing. */
		.tile--full {
			grid-column: span 1;
		}
	}

/* One hook for every mock, and only this one. A mock that draws a panel the
	   app renders at a fixed width scales as a whole rather than reflowing into
	   a width the app never produces, so each `.mock--*` family below sets `--z`
	   and this rule applies it.

	   `:global` on the child is load-bearing: every mock now holds a component,
	   and Astro scopes the last element in a selector, so the child carries its
	   own hash rather than this file's and a bare `> *` matches nothing. Naming
	   one shared hook rather than one per family means extracting the next mock
	   into a component cannot silently kill its ladder. */

.mock > :global(*) {
		zoom: var(--z, 1);
	}

/* The shortcut list (391) and the storage panel (578) each pair with a shorter
	   neighbour - the bulk bar (283) and the right-click menu (389) - that cannot
	   grow to meet them. Rather than leave a hole beside the shorter one, the tall
	   mock is scaled down to its partner's height while they share a row. Below
	   600 every tile is its own full-width row, so the scaling lifts and each mock
	   draws at full size. */
.mock--shrink-sc {
		--z: 0.66;
	}

.mock--shrink-st {
		--z: 0.62;
	}

@media (max-width: 600px) {
		.mock--shrink-sc,
		.mock--shrink-st {
			--z: 1;
		}
	}

/* A stretch panel has no fixed width, but its head does have a floor - a
	   label beside a three-way switch. Scaled just enough to keep that on one
	   line in a narrow two-column tile, which is what the app's wide pane gives
	   it. */

@media (min-width: 601px) and (max-width: 723px) {
		.mock--panel {
			--z: 0.9;
		}
	}

@media (max-width: 360px) {
		.mock--panel {
			--z: 0.9;
		}
	}

@media (max-width: 620px) {
		.popups {
			--pz: 0.82;
		}
	}

@media (max-width: 540px) {
		.popups {
			--pz: 0.7;
		}
	}

@media (max-width: 460px) {
		.popups {
			--pz: 0.6;
		}
	}

@media (max-width: 400px) {
		.popups {
			--pz: 0.52;
		}
	}

@media (max-width: 350px) {
		.popups {
			--pz: 0.45;
		}
	}

/* The card is 688 wide - `cs-filter-card--wide` in the app - and the tile
	   gives it the viewport less 50px of padding, except past 1220 where the
	   12-column grid hands this tile 673. Each rung is sized for the narrowest
	   viewport it covers, which is the breakpoint below it, and takes about
	   nine tenths of it: a card wedged against both edges of its tile reads as
	   an overflow rather than a shot of a window. */

.mock--filter {
		--z: 0.88;
	}

@media (max-width: 720px) {
		.mock--filter {
			--z: 0.77;
		}
	}

@media (max-width: 640px) {
		.mock--filter {
			--z: 0.66;
		}
