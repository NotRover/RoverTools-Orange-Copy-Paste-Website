	.acct-card--rows {
		padding: 0;
		overflow: hidden;
	}

	.acct-row {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 14px;
		border-top: 1px solid var(--border);
	}

	.acct-card--rows .acct-row:first-child {
		border-top: none;
	}

	.acct-row-icon {
		display: flex;
		align-items: center;
		flex: 0 0 auto;
		color: var(--text-muted);
	}

	.acct-row-main {
		display: flex;
		flex-direction: column;
		min-width: 0;
		flex: 1;
	}

	.acct-row-name {
		font-size: 13px;
		font-weight: 550;
		color: var(--text);
	}

	.acct-row-name > .acct-badge {
