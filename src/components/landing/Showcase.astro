	/* the account screen stacks its zones down one column at a 14px rhythm */
	.tile .mock--account {
		display: flex;
		flex-direction: column;
		gap: 14px;
		justify-content: flex-start;
	}

	/* ---- the shortcut list, from ShortcutsScreen.css ---- */
	.shortcut-row {
