---
import appIcon from '../../assets/app-icon.png';

const iconText =
	'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M4 6h16M4 12h16M4 18h10"/></svg>';
const iconUrl =
	'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M9 15l6-6M8 12l-3 3a4 4 0 105.7 5.7l3-3M16 12l3-3A4 4 0 1013.3 3.3l-3 3"/></svg>';
const iconImage =
	'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 16l5-5 4 4 3-3 6 6"/><circle cx="9" cy="9" r="1.6"/></svg>';
const iconDoc =
	'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6"/></svg>';
const iconFile =
	'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 6a2 2 0 012-2h4l2 2h8a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2z"/></svg>';
const iconPin =
	'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M12 17v5M7 4h10l-1 7 3 3H5l3-3z"/></svg>';
---

<section class="section show" id="showcase">
	<div class="wrap">
		<p class="eyebrow reveal">In the app</p>
		<h2 class="section-title reveal">Every surface, up close.</h2>
		<p class="section-lead reveal">
			Drawn with the app's own colors, spacing and type, so what you see here is what
			installs.
		</p>

		<!-- wide shot: the clipboard screen -->
		<figure class="wide reveal">
			<div class="oc-window">
				<div class="oc-titlebar">
					<span class="oc-title">Orange Copy Paste</span>
					<span class="oc-winbtns">
						<span class="oc-winbtn">&#8211;</span>
						<span class="oc-winbtn">&#9633;</span>
						<span class="oc-winbtn">&#10005;</span>
					</span>
				</div>
				<div class="oc-body">
					<div class="oc-sidebar">
						<span class="oc-side-logo"><img src={appIcon.src} alt="" /></span>
						<span class="oc-side-divider"></span>
						<span class="oc-navbtn active">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 2h6v4H9z"/></svg>
						</span>
						<span class="oc-navbtn">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 4h14v16H5z"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
						</span>
						<span class="oc-navbtn">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="9" r="3"/><circle cx="17" cy="15" r="3"/><path d="M11 11l4 3"/></svg>
						</span>
						<span class="oc-navbtn">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>
						</span>
					</div>
					<div class="clip-pane">
						<div class="clip-topbar">
							<div class="oc-search">Search history...</div>
							<span class="clip-tool">Filters</span>
							<span class="clip-tool">Newest</span>
							<span class="clip-tool clip-tool--accent">Groups</span>
						</div>
						<div class="day-label">Today</div>
						<div class="clip-grid">
							<div class="oc-card oc-card--in-clipboard">
								<div class="oc-card-body">
									<div class="oc-card-text">Meet at the station, platform 4, 9:40. Bring the badge for the side door.</div>
									<div class="oc-card-footer">
										<span class="oc-chips">
											<span class="oc-chip" style="--cc:var(--kind-text)" set:html={iconText + 'Text'} />
											<span class="oc-chip" style="--cc:#14b8a6">work</span>
										</span>
										<span class="oc-time">just now</span>
									</div>
								</div>
							</div>
							<div class="oc-card">
								<div class="oc-card-media grad-blue"></div>
								<div class="oc-card-body">
									<div class="oc-imgname">Image Aug 21, 2:45 PM</div>
									<div class="oc-card-footer">
										<span class="oc-chips">
											<span class="oc-chip" style="--cc:var(--kind-image)" set:html={iconImage + 'Image'} />
										</span>
										<span class="oc-time">2:45 PM</span>
									</div>
								</div>
							</div>
							<div class="oc-card">
								<div class="oc-card-body">
									<div class="oc-card-text oc-card-text--clamp">github.com/Spectrewolf8/RoverTools-Releases</div>
									<div class="oc-card-footer">
										<span class="oc-chips">
											<span class="oc-chip" style="--cc:var(--kind-url)" set:html={iconUrl + 'URL'} />
											<span class="oc-chip" style="--cc:var(--accent)" set:html={iconPin + 'Pinned'} />
										</span>
										<span class="oc-time">1:12 PM</span>
									</div>
								</div>
							</div>
							<div class="oc-card">
								<div class="oc-card-body">
									<div class="oc-card-text oc-card-text--clamp">quarterly-report.pdf</div>
									<div class="oc-card-footer">
										<span class="oc-chips">
											<span class="oc-chip" style="--cc:var(--kind-document)" set:html={iconDoc + 'Doc'} />
										</span>
										<span class="oc-time">12:58 PM</span>
									</div>
								</div>
							</div>
							<div class="oc-card">
								<div class="oc-card-body">
									<div class="oc-card-text oc-card-text--clamp">brand-assets (3 files)</div>
									<div class="oc-card-footer">
										<span class="oc-chips">
											<span class="oc-chip" style="--cc:var(--kind-file)" set:html={iconFile + 'File'} />
											<span class="oc-chip" style="--cc:#6366f1">ideas</span>
										</span>
										<span class="oc-time">11:31 AM</span>
									</div>
								</div>
							</div>
							<div class="oc-card">
								<div class="oc-card-body">
									<div class="oc-card-text">Invoice INV-20418, due Sep 5. Net 30, reference PO-99812.</div>
									<div class="oc-card-footer">
										<span class="oc-chips">
											<span class="oc-chip" style="--cc:var(--kind-text)" set:html={iconText + 'Text'} />
										</span>
										<span class="oc-time">10:02 AM</span>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="oc-pill-row">
					<span class="oc-status-pill"><span class="dot"></span>Connected</span>
				</div>
			</div>
			<figcaption>
				<strong>The history screen</strong>
				Tiles or list, day groups, colored group tags, and the entry currently on your
				clipboard outlined in orange.
			</figcaption>
		</figure>

		<div class="bento">
			<!-- row 1: paste popup + notes -->
			<figure class="tile tile--s3 reveal">
				<div class="mock">
					<div class="pp">
						<div class="pp-tabs">
							<span class="pp-tab active">Recent</span>
							<span class="pp-tab">Pinned</span>
						</div>
						<div class="pp-row"><span class="slot">1</span><span class="pp-text">Meet at the station, platform 4</span></div>
						<div class="pp-row sel"><span class="slot">2</span><span class="pp-text">github.com/Spectrewolf8</span></div>
						<div class="pp-row"><span class="slot">3</span><span class="pp-text">Invoice INV-20418, due Sep 5</span></div>
						<div class="pp-hint"><span class="kbd">1</span>-<span class="kbd">9</span> paste by slot <span class="kbd">Tab</span> switch tab</div>
						<span class="pp-cursor" aria-hidden="true">
							<span class="pp-ring"></span>
							<svg viewBox="0 0 24 24" width="16" height="16"><path d="M5 2l0 17 4.2-3.6 2.6 6 3-1.3-2.6-5.9 6-.6z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round"/></svg>
						</span>
					</div>
				</div>
				<figcaption>
					<strong>Quick-paste popup</strong>
					Opens at your cursor with Ctrl+Shift+V. Press a digit and it pastes.
				</figcaption>
			</figure>

			<figure class="tile tile--s3 reveal">
				<div class="mock">
					<div class="note">
						<div class="note-h">Release checklist</div>
						<div class="task done"><span class="cb"></span>Draft the notes</div>
						<div class="task done"><span class="cb"></span>Verify both channels</div>
						<div class="task"><span class="cb"></span>Ship v0.1.16</div>
						<div class="code">bun run tauri build</div>
					</div>
				</div>
				<figcaption>
					<strong>Notes, next to your clips</strong>
					Task lists, tables, code blocks and callouts. Exports to Markdown.
				</figcaption>
			</figure>

			<!-- row 2 -->
			<figure class="tile tile--s2 reveal">
				<div class="mock">
					<div class="radio-row on"><span class="radio"></span><div><b>Realtime</b><small>Items arrive the moment they are copied.</small></div></div>
					<div class="radio-row"><span class="radio"></span><div><b>Passive</b><small>Arrivals every 5 minutes, or on Refresh.</small></div></div>
					<div class="radio-row"><span class="radio"></span><div><b>Manual</b><small>You pick what uploads, item by item.</small></div></div>
				</div>
				<figcaption>
					<strong>Three sync modes</strong>
					Per device, so your laptop can sync live while your desktop stays manual.
				</figcaption>
			</figure>

			<figure class="tile tile--s2 reveal">
				<div class="mock">
					<div class="mem"><span class="avatar" style="--ac:#3b82f6">S</span><div><b>sam</b><small class="on-dot">Online now</small></div><span class="badge">owner</span></div>
					<div class="mem"><span class="avatar" style="--ac:#a855f7">R</span><div><b>rio</b><small class="on-dot">Online now</small></div></div>
					<div class="mem"><span class="avatar" style="--ac:#14b8a6">M</span><div><b>mei</b><small>Offline</small></div></div>
				</div>
				<figcaption>
					<strong>Spaces members</strong>
					See who is in a space and who is online. Removing one rotates the key.
				</figcaption>
			</figure>

			<figure class="tile tile--s2 reveal">
				<div class="mock">
					<div class="sw-row"><div><b>Auto-share to this space</b><small>Off. Only items you share by hand go in.</small></div><span class="switch"></span></div>
					<div class="sw-row"><div><b>Auto-copy incoming</b><small>Shared items land on your clipboard.</small></div><span class="switch on"></span></div>
				</div>
				<figcaption>
					<strong>Sharing is opt-in</strong>
					Nothing leaves your machine unless you shared it or switched a filter on.
				</figcaption>
			</figure>

			<!-- row 3 -->
			<figure class="tile tile--s2 reveal">
				<div class="mock">
					<div class="cp">
						<div class="cp-head"><span class="oc-chip" style="--cc:var(--kind-text)" set:html={iconText + 'Text'} /><span class="muted">Captured</span></div>
						<div class="cp-body">The quarterly numbers land Thursday</div>
						<div class="cp-actions"><span class="cp-btn">Pin</span><span class="cp-btn danger">Delete</span></div>
					</div>
				</div>
				<figcaption>
					<strong>Capture receipt</strong>
					Ctrl+Shift+C shows what was just grabbed, with pin and delete one click away.
				</figcaption>
			</figure>

			<figure class="tile tile--s2 reveal">
				<div class="mock">
					<div class="fl-row"><span class="oc-chip" style="--cc:var(--kind-text)" set:html={iconText + 'Text'} /><span class="count">41</span></div>
					<div class="fl-row"><span class="oc-chip" style="--cc:var(--kind-url)" set:html={iconUrl + 'URL'} /><span class="count">17</span></div>
					<div class="fl-row"><span class="oc-chip" style="--cc:var(--kind-image)" set:html={iconImage + 'Image'} /><span class="count">9</span></div>
					<div class="fl-row"><span class="oc-chip" style="--cc:var(--kind-document)" set:html={iconDoc + 'Doc'} /><span class="count">4</span></div>
				</div>
				<figcaption>
					<strong>Filters that count ahead</strong>
					Every option shows how many items it would leave you, before you apply it.
				</figcaption>
			</figure>

			<figure class="tile tile--s2 reveal">
				<div class="mock">
					<div class="up">
						<div class="up-head"><b>0.1.15 is ready</b><span class="up-btn">Download</span></div>
						<small>New: sounds for shared arrivals, invites and refusals. Updates never install without asking.</small>
					</div>
				</div>
				<figcaption>
					<strong>Signed updates</strong>
					Every bundle is checked against a key baked into the app before it installs.
				</figcaption>
			</figure>

			<!-- row 4: full-width band -->
			<figure class="tile tile--band reveal">
				<div class="mock">
					<div class="rc">7XKQM-2WNPF-9RTLC-4HVGB-8ZJSD-6YEAU</div>
					<div class="muted rc-note">Shown once. Stored nowhere.</div>
				</div>
				<figcaption>
					<strong>Recovery code</strong>
					150 bits that make a forgotten password survivable without giving the server a
					key.
				</figcaption>
			</figure>
		</div>

		<!-- wide shot: the spaces screen -->
		<figure class="wide reveal">
			<div class="oc-window">
				<div class="oc-titlebar">
					<span class="oc-title">Orange Copy Paste</span>
					<span class="oc-winbtns">
						<span class="oc-winbtn">&#8211;</span>
						<span class="oc-winbtn">&#9633;</span>
						<span class="oc-winbtn">&#10005;</span>
					</span>
				</div>
				<div class="oc-body">
					<div class="oc-sidebar">
						<span class="oc-side-logo"><img src={appIcon.src} alt="" /></span>
						<span class="oc-side-divider"></span>
						<span class="oc-navbtn">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 2h6v4H9z"/></svg>
						</span>
						<span class="oc-navbtn">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 4h14v16H5z"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
						</span>
						<span class="oc-navbtn active">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="9" r="3"/><circle cx="17" cy="15" r="3"/><path d="M11 11l4 3"/></svg>
						</span>
						<span class="oc-navbtn">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>
						</span>
					</div>
					<div class="sp-pane">
						<div class="sp-feed">
							<div class="sp-feed-head">
								<b>design-team</b>
								<span class="muted">4 members</span>
							</div>
							<div class="sp-cols">
								<div class="oc-card">
									<div class="oc-card-body">
										<div class="sp-owner"><span class="avatar sm" style="--ac:#a855f7">R</span><span class="sp-name">rio</span><span class="oc-time">2m</span></div>
										<div class="oc-card-text oc-card-text--clamp">#ff3e1c on #0e0e0e, ratio 4.6:1</div>
										<div class="oc-card-footer">
											<span class="oc-chips"><span class="oc-chip" style="--cc:var(--kind-text)" set:html={iconText + 'Text'} /></span>
											<span class="oc-time">2 comments</span>
										</div>
									</div>
								</div>
								<div class="oc-card">
									<div class="oc-card-media grad-teal"></div>
									<div class="oc-card-body">
										<div class="sp-owner"><span class="avatar sm" style="--ac:#14b8a6">M</span><span class="sp-name">mei</span><span class="oc-time">9m</span></div>
										<div class="oc-card-footer">
											<span class="oc-chips"><span class="oc-chip" style="--cc:var(--kind-image)" set:html={iconImage + 'Image'} /></span>
										</div>
									</div>
								</div>
								<div class="oc-card oc-card--in-clipboard">
									<div class="oc-card-body">
										<div class="sp-owner"><span class="avatar sm" style="--ac:#3b82f6">S</span><span class="sp-name">sam</span><span class="oc-time">now</span></div>
										<div class="oc-card-text oc-card-text--clamp">staging.rovertools.app/preview</div>
										<div class="oc-card-footer">
											<span class="oc-chips"><span class="oc-chip" style="--cc:var(--kind-url)" set:html={iconUrl + 'URL'} /></span>
											<span class="arrived">arrived</span>
										</div>
									</div>
								</div>
							</div>
						</div>
						<div class="sp-rail">
							<div class="rail-head">Your spaces</div>
							<div class="rail-space active"><span class="rail-dot"></span>design-team</div>
							<div class="rail-space"><span class="rail-dot off"></span>family</div>
							<div class="rail-space"><span class="rail-dot off"></span>ops-oncall</div>
							<div class="rail-head">Invites</div>
							<div class="rail-invite">
								<span>launch-week</span>
								<span class="rail-actions"><span class="rail-btn ok">Accept</span><span class="rail-btn">Decline</span></span>
							</div>
						</div>
					</div>
				</div>
				<div class="oc-pill-row oc-pill-row--left-of-rail">
					<span class="oc-status-pill"><span class="dot"></span>Connected</span>
				</div>
			</div>
			<figcaption>
				<strong>The Spaces screen</strong>
				A live shared feed on the left, your spaces and invites on the right. Panels
				resize and remember where you left them.
			</figcaption>
		</figure>
	</div>
</section>

<style>
	.show {
	}

	/* ---- wide window shots ---- */
	.wide {
		margin: 0 0 1.6rem;
	}

	/* the app window is 920x560; draw it at that size and zoom the whole shot
	   down on narrow screens so nothing inside it changes proportion */
	.wide .oc-window {
		width: 920px;
		height: 560px;
		display: flex;
		flex-direction: column;
		margin: 0 auto;
		zoom: var(--mz, 1);
	}

	.wide .oc-body {
		flex: 1;
		min-height: 0;
	}

	.wide + .bento {
		margin-top: 0.4rem;
	}

	.wide figcaption {
		padding: 0.9rem 0.2rem 0;
		font-size: 0.85rem;
		color: var(--text-secondary);
		max-width: 920px;
		margin: 0 auto;
	}

	.wide figcaption strong {
		display: inline;
		font-family: var(--font-display);
		font-size: 0.95rem;
		color: var(--text);
		margin-right: 0.5rem;
		letter-spacing: -0.01em;
	}

	.bento + .wide {
		margin-top: 1.8rem;
	}

	/* clipboard pane */
	.clip-pane {
		flex: 1;
		min-width: 0;
		padding: 12px 14px 44px;
	}

	.clip-topbar {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 10px;
	}

	.clip-topbar .oc-search {
		flex: 1;
	}

	.clip-tool {
		font-size: 11px;
		color: var(--text-secondary);
		border: 1px solid var(--border);
		background: var(--surface);
		border-radius: var(--radius-xs);
		padding: 5px 10px;
		white-space: nowrap;
	}

	.clip-tool--accent {
		color: var(--accent);
		background: var(--accent-dim);
		border-color: transparent;
	}

	.day-label {
		font-family: var(--font-mono);
		font-size: 0.64rem;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--text-muted);
		margin: 0 0 8px 2px;
	}

	.clip-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
		align-items: start;
	}

	.oc-card-media.grad-blue {
		background:
			linear-gradient(135deg, rgba(59, 130, 246, 0.45), rgba(139, 92, 246, 0.3)),
			var(--bg);
	}

	.oc-card-media.grad-teal {
		background:
			linear-gradient(135deg, rgba(20, 184, 166, 0.4), rgba(59, 130, 246, 0.28)),
			var(--bg);
		height: 58px;
	}

	.oc-imgname {
		font-size: 11px;
		font-weight: 500;
		color: var(--text-secondary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* spaces pane */
	.sp-pane {
		flex: 1;
		min-width: 0;
		display: flex;
	}

	.sp-feed {
		flex: 1;
		min-width: 0;
		padding: 12px 14px 44px;
	}

	.sp-feed-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 10px;
	}

	.sp-feed-head b {
		font-family: var(--font-display);
		font-size: 0.9rem;
	}

	.sp-cols {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 10px;
		align-items: start;
	}

	.sp-owner {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.sp-name {
		font-size: 11px;
		font-weight: 600;
	}

	.sp-owner .oc-time {
		margin-left: auto;
	}

	.avatar {
		width: 24px;
		height: 24px;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.66rem;
		font-weight: 600;
		color: #fff;
		background: color-mix(in srgb, var(--ac) 75%, #000);
		flex-shrink: 0;
	}

	.avatar.sm {
