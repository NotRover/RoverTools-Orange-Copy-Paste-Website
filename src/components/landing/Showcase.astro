	/* ---- the Devices zone, from AccountScreen.css ---- */
	.acct-zone {
		display: flex;
		flex-direction: column;
		gap: 9px;
	}

	.acct-zone-head {
		display: flex;
		align-items: center;
		gap: 8px;
		min-height: 26px;
	}

	.acct-zone-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		border-radius: 6px;
		color: var(--accent);
		background: var(--accent-dim);
		flex-shrink: 0;
