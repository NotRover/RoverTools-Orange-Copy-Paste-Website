---
import AppShell from './AppShell.astro';
import CardMenu from './CardMenu.astro';
import HistoryScreen from './HistoryScreen.astro';
import { CHIP_ICONS, GROUP_COLORS, KIND_COLORS, TYPE_LABELS } from './app-parts';

/* The Yesterday group. Static, because the animation only ever touches the
   Today group - and a second group is what gives the timeline rail two ends,
   a divider between the days, and something below the fold to scroll to. */
const earlier = [
	{
		kind: 'text',
		text: 'Rotate the space key before the beta goes out, then re-wrap for everyone.',
		group: ['release', 'amber'],
	},
	{ kind: 'document', text: 'meeting-notes-aug-20.md' },
	{ kind: 'url', text: 'staging.rovertools.app/preview/920x560' },
	{ kind: 'folder', text: '/home/rio/projects/orangecp/assets/press' },
] as const;

import { fetchBuild, RELEASES_PAGE } from '../../lib/releases';

/* Straight at the installer rather than at the download section: the section is
   still there for anyone who wants Linux or the version. DownloadSection's
   script refreshes every `data-dl` link on the page, this one included. */
const build = await fetchBuild();
---

<section class="hero">
	<div class="wrap wrap--wide hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Smart clipboard for Windows and Linux</p>
			<h1>The clipboard that remembers.</h1>
			<p class="sub">
				Orange Copy Paste keeps the text, images and files you copy in a searchable
				history, next to your notes, on every device. End-to-end encrypted, and fully
				usable offline.
			</p>
			<div class="ctas">
				<a class="btn btn-primary" data-dl="windows" href={build?.windows ?? RELEASES_PAGE}>
					Download for Windows
				</a>
				<a class="btn btn-ghost" href="/docs/">Read the docs</a>
			</div>
			<p class="meta">
				Free. No account needed. Linux builds: deb and AppImage.
			</p>
		</div>

		<div class="hero-demo" aria-hidden="true">
			<!-- the thing being copied -->
			<div class="capture-strip">
				<div class="capture-src">
					<span class="sweep" id="sweep">Meet at the station, platform 4, 9:40</span>
				</div>
				<div class="capture-keys">
					<span class="kbd" data-key>Ctrl</span>
					<span class="kbd" data-key data-shift>Shift</span>
					<span class="kbd" data-key>C</span>
				</div>
			</div>

			<!-- the app window, drawn from the shared shell so it matches the product -->
			<AppShell nav="clipboard" class="hero-window">
				<HistoryScreen count={128} groups={3} gridId="stack" scrollbar thumbTop={2} thumbHeight={40}>
					{
						earlier.map((e) => (
							<div class="oc-card" slot="earlier">
								<div class="oc-card-body">
									<p class="oc-card-text oc-card-text--clamp">{e.text}</p>
									<div class="oc-card-footer">
										<span class="oc-chips">
											<span class="oc-chip" style={`--cc:${KIND_COLORS[e.kind]}`}>
												<Fragment set:html={CHIP_ICONS[e.kind]} />
												<span class="oc-chip-label">{TYPE_LABELS[e.kind]}</span>
											</span>
											{'group' in e && e.group && (
												<span
													class="oc-chip oc-chip--group"
													style={`--cc:${GROUP_COLORS[e.group[1]]}`}
												>
													<span class="oc-chip-dot" />
													<span class="oc-chip-label">{e.group[0]}</span>
												</span>
											)}
										</span>
										<span class="oc-time">Yesterday</span>
									</div>
								</div>
							</div>
						))
					}
				</HistoryScreen>
				<CardMenu slot="overlay" spaces={2} />
				<div class="oc-pill-row">
					<div class="oc-stat-pill">
						<span class="oc-stat"><b>86</b> text</span>
						<span class="oc-stat-sep"></span>
						<span class="oc-stat"><b>21</b> img</span>
						<span class="oc-stat-sep"></span>
						<span class="oc-stat"><b>128</b> total</span>
					</div>
					<div class="oc-sync-pill"><span class="dot"></span>Sync connected</div>
				</div>
				<div class="fake-cursor" id="fcur" slot="overlay">
					<span class="click-ring"></span>
					<svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 2l0 17 4.2-3.6 2.6 6 3-1.3-2.6-5.9 6-.6z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round"/></svg>
				</div>
			</AppShell>
		</div>
	</div>
</section>

<script>
	import { CHIP_ICONS } from './app-parts';
	import { makeCard } from './mock-cards';

	/* what the watcher picks up, in the order it happens */
	const snippets = [
		{ kind: 'text', content: 'Meet at the station, platform 4, 9:40. Bring the badge for the side door.', group: ['work', 'teal'] },
		{ kind: 'url', content: 'github.com/Spectrewolf8/RoverTools-Releases' },
		{ kind: 'image', content: '#a1b2c3d4 Image Aug 21, 2:45 PM', thumb: 'photo' },
		{ kind: 'html', content: '<h4>Release checklist</h4><ul><li>Bump the version and tag it</li><li>Sign both bundles</li></ul>', group: ['release', 'amber'] },
		{ kind: 'document', content: 'quarterly-report.pdf' },
		{ kind: 'video', content: 'popup-placement-bug.mp4', thumb: 'ui' },
		{ kind: 'text', content: 'Invoice INV-20418, due Sep 5. Net 30, reference PO-99812.' },
		{ kind: 'folder', content: '/home/rio/projects/orangecp/assets' },
		{ kind: 'file', content: 'brand-assets (3 files)', group: ['ideas', 'indigo'] },
	] as const;

	const stack = document.getElementById('stack');
	const sweep = document.getElementById('sweep');
	const keys = document.querySelectorAll<HTMLElement>('[data-key]');
	const shiftKey = document.querySelector<HTMLElement>('[data-shift]');
	const cursor = document.getElementById('fcur');
	/* the window itself, not the cursor's parent: the coordinate space has to be
	   the 920x560 the mock is drawn at, and the same box the menu is positioned
	   against */
	const win = document.querySelector<HTMLElement>('.hero-demo .oc-window');
	const menu = win?.querySelector<HTMLElement>('.oc-menu') ?? null;
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function moveCursor(x: number, y: number) {
		if (cursor) cursor.style.transform = `translate(${x}px, ${y}px)`;
	}

	/* where on a card the cursor comes to rest, in the window's own pixels */
	function pointOn(card: HTMLElement) {
		const w = win!.getBoundingClientRect();
		const c = card.getBoundingClientRect();
		// the mock is zoomed as a whole, so screen deltas need dividing by it
		const z = w.width / 920 || 1;
		return {
			z,
			x: (c.left - w.left) / z + (c.width / z) * 0.72,
			y: (c.top - w.top) / z + (c.height / z) * 0.55,
		};
	}

	async function flashCopied(card: HTMLElement, wait: (ms: number) => Promise<unknown>) {
		const time = card.querySelector('.oc-time');
		const prev = time?.innerHTML ?? '';
		if (time) {
			time.innerHTML = `${CHIP_ICONS.check}Copied`;
			time.classList.add('oc-time--copied');
		}
		await wait(1100);
		if (time) {
			time.innerHTML = prev;
			time.classList.remove('oc-time--copied');
		}
	}

	async function cursorClick(card: HTMLElement, wait: (ms: number) => Promise<unknown>) {
		if (!cursor || !win) return;
		const p = pointOn(card);
		cursor.classList.add('on');
		moveCursor(p.x, p.y);
		await wait(620);
		cursor.classList.add('clicking');
		const copied = flashCopied(card, wait);
		await wait(420);
		cursor.classList.remove('clicking');
		await copied;
		moveCursor(920 - 60, 560 - 70);
	}

	/* The other half of the demo: right-click, the menu opens under the pointer,
	   the pointer picks Copy, the menu goes away again. The app opens it at the
	   click point and nudges it back inside when it would run off the window, so
	   the mock does the same. */
	async function cursorRightClick(card: HTMLElement, wait: (ms: number) => Promise<unknown>) {
		if (!cursor || !win || !menu) return;
		const p = pointOn(card);
		cursor.classList.add('on');
		moveCursor(p.x, p.y);
		await wait(620);
		cursor.classList.add('clicking');
		await wait(280);
		cursor.classList.remove('clicking');

		const m = menu.getBoundingClientRect();
		const mx = Math.max(8, Math.min(p.x, 920 - 8 - m.width / p.z));
		const my = Math.max(8, Math.min(p.y, 560 - 8 - m.height / p.z));
		menu.style.left = `${mx}px`;
		menu.style.top = `${my}px`;
		menu.classList.add('open');

		await wait(560);
		moveCursor(mx + 46, my + 17); // the Copy row
		await wait(820);
		cursor.classList.add('clicking');
		await wait(300);
		cursor.classList.remove('clicking');
		menu.classList.remove('open');
		await flashCopied(card, wait);
		moveCursor(920 - 60, 560 - 70);
	}

	function pushCard(s: (typeof snippets)[number]) {
		if (!stack) return;
		stack
			.querySelectorAll('.oc-card--in-clipboard')
			.forEach((c) => c.classList.remove('oc-card--in-clipboard'));
		const card = makeCard(s, { active: true, age: 'Just now' });
		card.classList.add('enter');
		stack.prepend(card);
		requestAnimationFrame(() => requestAnimationFrame(() => card.classList.remove('enter')));
		if (stack.children.length > 7) {
			const last = stack.lastElementChild as HTMLElement;
			last.classList.add('leave');
			setTimeout(() => last.remove(), 350);
		}
	}

	if (reduced || !stack || !sweep) {
		if (stack) {
			snippets.forEach((s, i) =>
				stack.appendChild(makeCard(s, { active: i === 0, age: i === 0 ? 'Just now' : `${i * 3}m ago` })),
			);
		}
	} else {
		let i = 0;
		// seed the window so it never reads as an empty app
		const ages = ['2m ago', '9m ago', '24m ago', '1h ago'];
		[5, 4, 3, 2].forEach((n, k) => stack.appendChild(makeCard(snippets[n]!, { age: ages[k]! })));

		const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

		async function loop() {
			let cycles = 0;
			let visits = 0;
			for (;;) {
				const s = snippets[i % snippets.length]!;
				// alternate the shortcut: a plain Ctrl+C the watcher grabs silently,
				// then a Ctrl+Shift+C capture - both land the copy in history. Start
				// on the plain copy, since that is the everyday one.
				const withShift = i % 2 === 1;
				i++;
				shiftKey?.classList.toggle('is-hidden', !withShift);
				sweep!.textContent = s.content;
				sweep!.style.backgroundSize = '0% 100%';
				await wait(500);
				sweep!.style.backgroundSize = '100% 100%';
				await wait(650);
				const pressing = Array.from(keys).filter((k) => withShift || k !== shiftKey);
				pressing.forEach((k) => k.classList.add('pressed'));
				await wait(260);
				pressing.forEach((k) => k.classList.remove('pressed'));
				await wait(140);
				pushCard(s);
				cycles++;
				// every other capture, the cursor comes over to the new card - and
				// every other visit is a right-click rather than a plain copy
				if (cycles % 2 === 0 && stack!.firstElementChild) {
					const card = stack!.firstElementChild as HTMLElement;
					await wait(700);
					visits++;
					await (visits % 2 === 0 ? cursorRightClick : cursorClick)(card, wait);
					await wait(1100);
				} else {
					await wait(2600);
				}
			}
		}
		loop();
	}
</script>

<style>
	.hero {
		padding: 5.5rem 0 6rem;
		position: relative;
		overflow: hidden;
	}

	/* quiet mesh behind the hero */
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(42% 55% at 82% 18%, rgba(255, 62, 28, 0.09), transparent 70%),
			radial-gradient(30% 40% at 65% 80%, rgba(99, 102, 241, 0.06), transparent 70%),
			radial-gradient(25% 35% at 10% 90%, rgba(255, 62, 28, 0.04), transparent 70%);
		/* The section clips its overflow, so the mesh is faded out before the
		   bottom edge - a gradient cut off by a box boundary draws a hard line
		   across the page. */
		-webkit-mask-image: linear-gradient(180deg, #000 0%, #000 46%, transparent 88%);
		mask-image: linear-gradient(180deg, #000 0%, #000 46%, transparent 88%);
		pointer-events: none;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 3.5rem;
		align-items: center;
		position: relative;
	}

	/* The mock is drawn at the app's real window size, 920x560, and the whole
	   block is zoomed as one unit so every internal metric stays in proportion. */
	.hero-demo {
		width: 920px;
		zoom: var(--mz, 1);
	}

	h1 {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(2.5rem, 5.4vw, 3.6rem);
		line-height: 1.08;
		letter-spacing: -0.025em;
		margin: 0 0 1.2rem;
	}

	.sub {
		color: var(--text-secondary);
		font-size: 1.12rem;
		max-width: 32rem;
		margin: 0 0 2rem;
	}

	.ctas {
		display: flex;
		gap: 0.9rem;
		flex-wrap: wrap;
	}

	.meta {
		margin-top: 1.3rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-muted);
	}

	/* ---- capture strip ---- */
	.capture-strip {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
		padding: 0.7rem 1rem;
		border: 1px dashed var(--border-light);
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.015);
	}

	.capture-src {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--text-secondary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		min-width: 0;
	}

	.capture-src .sweep {
		background-image: linear-gradient(rgba(255, 62, 28, 0.35), rgba(255, 62, 28, 0.35));
		background-repeat: no-repeat;
		background-size: 0% 100%;
		transition: background-size 0.45s ease;
		border-radius: 2px;
		padding: 0.1em 0;
	}

	.capture-keys {
		display: flex;
		gap: 0.3rem;
		flex-shrink: 0;
	}

	/* dropped for a plain Ctrl+C cycle; the flex gap collapses with it */
	.capture-keys .kbd.is-hidden {
		display: none;
	}

	/* ---- hero window: the app's real 920x560 ---- */
	.hero-demo :global(.hero-window) {
		width: 920px;
		height: 560px;
	}

	.hero-demo :global(.oc-card) {
		transition: transform 0.35s ease, opacity 0.35s ease, border-color 0.25s ease;
	}

	.hero-demo :global(.oc-card.enter) {
		transform: translateY(-14px);
		opacity: 0;
	}

	.hero-demo :global(.oc-card.leave) {
		transform: translateY(10px);
		opacity: 0;
	}

	/* The right-click menu is part of the loop, not furniture: it stays shut
	   until the cursor opens it, and closes when the row is picked. No transform
	   here on purpose - the script measures it while it is hidden. */
	.hero-demo :global(.oc-menu) {
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.13s ease, visibility 0.13s;
	}

	.hero-demo :global(.oc-menu.open) {
		opacity: 1;
		visibility: visible;
	}

	/* fake cursor */
	.hero-demo :global(.fake-cursor) {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 5;
		opacity: 0;
		transform: translate(85%, 80%);
		transition: transform 0.55s cubic-bezier(0.25, 0.7, 0.3, 1), opacity 0.3s ease;
		pointer-events: none;
	}

	.hero-demo :global(.fake-cursor.on) {
		opacity: 1;
	}

	.hero-demo :global(.fake-cursor.clicking svg) {
		transform: scale(0.82);
	}

	.hero-demo :global(.fake-cursor svg) {
		transition: transform 0.12s ease;
		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
	}

	.hero-demo :global(.click-ring) {
		position: absolute;
		top: -4px;
		left: -4px;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		border: 2px solid var(--accent);
		opacity: 0;
		transform: scale(0.4);
	}

	.hero-demo :global(.fake-cursor.clicking .click-ring) {
		animation: clickRing 0.45s ease-out;
	}

	@keyframes clickRing {
		0% {
			opacity: 0.9;
			transform: scale(0.4);
		}
		100% {
			opacity: 0;
			transform: scale(1.5);
		}
	}

	/* One knob, so the mock never distorts: it only gets smaller as a whole. */
	@media (max-width: 1500px) {
		.hero-demo {
			--mz: 0.86;
		}
	}

	@media (max-width: 1340px) {
		.hero-demo {
			--mz: 0.74;
		}
	}

	@media (max-width: 1180px) {
		.hero-demo {
			--mz: 0.62;
		}
	}

	@media (max-width: 1023px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 3rem;
			justify-items: center;
		}
		.hero-copy {
			justify-self: start;
		}
		.hero-demo {
			--mz: 0.78;
		}
	}

	@media (max-width: 820px) {
		.hero-demo {
			--mz: 0.62;
		}
	}

	@media (max-width: 640px) {
		.hero-demo {
			--mz: 0.5;
		}
	}

	@media (max-width: 520px) {
		.hero-demo {
			--mz: 0.4;
		}
	}

	@media (max-width: 420px) {
		.hero-demo {
			--mz: 0.35;
		}
	}
</style>
