---
import appIcon from '../../assets/app-icon.png';
---

<section class="hero">
	<div class="wrap wrap--wide hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Smart clipboard for Windows and Linux</p>
			<h1>The clipboard that remembers.</h1>
			<p class="sub">
				Orange Copy Paste keeps the text, images and files you copy in a searchable
				history, next to your notes, on every device. End-to-end encrypted, and fully
				usable offline.
			</p>
			<div class="ctas">
				<a class="btn btn-primary" href="#download">Download for Windows</a>
				<a class="btn btn-ghost" href="/docs/">Read the docs</a>
			</div>
			<p class="meta">
				Free. No account needed. Linux builds: deb, rpm, AppImage.
			</p>
		</div>

		<div class="hero-demo" aria-hidden="true">
			<!-- the thing being copied -->
			<div class="capture-strip">
				<div class="capture-src">
					<span class="sweep" id="sweep">Meet at the station, platform 4, 9:40</span>
				</div>
				<div class="capture-keys">
					<span class="kbd" data-key>Ctrl</span>
					<span class="kbd" data-key>Shift</span>
					<span class="kbd" data-key>C</span>
				</div>
			</div>

			<!-- app window, faithful to the real UI -->
			<div class="oc-window hero-window">
				<div class="oc-titlebar">
					<span class="oc-title">Orange Copy Paste</span>
					<span class="oc-winbtns">
						<span class="oc-winbtn">&#8211;</span>
						<span class="oc-winbtn">&#9633;</span>
						<span class="oc-winbtn">&#10005;</span>
					</span>
				</div>
				<div class="oc-body hero-body">
					<div class="oc-sidebar">
						<span class="oc-side-logo"><img src={appIcon.src} alt="" /></span>
						<span class="oc-side-divider"></span>
						<span class="oc-navbtn active">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 2h6v4H9z"/></svg>
						</span>
						<span class="oc-navbtn">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 4h14v16H5z"/><path d="M8 9h8M8 13h8M8 17h5"/></svg>
						</span>
						<span class="oc-navbtn">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="9" r="3"/><circle cx="17" cy="15" r="3"/><path d="M11 11l4 3"/></svg>
						</span>
						<span class="oc-navbtn">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 5-6 8-6s6.5 2 8 6"/></svg>
						</span>
					</div>
					<div class="main-pane">
						<div class="pane-top">
							<div class="oc-search">Search history...</div>
						</div>
						<div class="day-label">Today</div>
						<div class="stack" id="stack"></div>
					</div>
				</div>
				<div class="oc-pill-row">
					<span class="oc-status-pill"><span class="dot"></span>Connected</span>
				</div>
				<div class="fake-cursor" id="fcur">
					<span class="click-ring"></span>
					<svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 2l0 17 4.2-3.6 2.6 6 3-1.3-2.6-5.9 6-.6z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round"/></svg>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const ICONS: Record<string, string> = {
		text: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M4 6h16M4 12h16M4 18h10"/></svg>',
		url: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M9 15l6-6M8 12l-3 3a4 4 0 105.7 5.7l3-3M16 12l3-3A4 4 0 1013.3 3.3l-3 3"/></svg>',
		image: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 16l5-5 4 4 3-3 6 6"/><circle cx="9" cy="9" r="1.6"/></svg>',
		document: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6"/></svg>',
	};
	const snippets = [
		{ kind: 'text', label: 'Text', color: 'var(--kind-text)', content: 'Meet at the station, platform 4, 9:40' },
		{ kind: 'url', label: 'URL', color: 'var(--kind-url)', content: 'github.com/Spectrewolf8/RoverTools-Releases' },
		{ kind: 'image', label: 'Image', color: 'var(--kind-image)', content: 'Image Aug 21, 2:45 PM' },
		{ kind: 'document', label: 'Doc', color: 'var(--kind-document)', content: 'quarterly-report.pdf' },
		{ kind: 'text', label: 'Text', color: 'var(--kind-text)', content: 'Invoice INV-20418, due Sep 5' },
	];

	const stack = document.getElementById('stack');
	const sweep = document.getElementById('sweep');
	const keys = document.querySelectorAll<HTMLElement>('[data-key]');
	const cursor = document.getElementById('fcur');
	const win = cursor?.parentElement ?? null;
	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	function moveCursor(x: number, y: number) {
		if (cursor) cursor.style.transform = `translate(${x}px, ${y}px)`;
	}

	async function cursorClick(card: HTMLElement, wait: (ms: number) => Promise<unknown>) {
		if (!cursor || !win) return;
		const w = win.getBoundingClientRect();
		const c = card.getBoundingClientRect();
		// the mock is zoomed as a whole, so screen deltas need dividing by it
		const z = w.width / 920 || 1;
		cursor.classList.add('on');
		moveCursor(
			(c.left - w.left) / z + c.width / z * 0.72,
			(c.top - w.top) / z + c.height / z * 0.55,
		);
		await wait(620);
		cursor.classList.add('clicking');
		const time = card.querySelector('.oc-time');
		const prev = time?.textContent ?? '';
		if (time) {
			time.textContent = 'Copied';
			time.classList.add('oc-time--copied');
		}
		await wait(420);
		cursor.classList.remove('clicking');
		await wait(900);
		if (time) {
			time.textContent = prev;
			time.classList.remove('oc-time--copied');
		}
		moveCursor(920 - 60, 560 - 70);
	}

	function makeCard(s: (typeof snippets)[number], active: boolean) {
		const card = document.createElement('div');
		card.className = 'oc-card' + (active ? ' oc-card--in-clipboard' : '');
		const media = s.kind === 'image' ? '<div class="oc-card-media img-grad"></div>' : '';
		const textCls = s.kind === 'image' ? 'oc-card-text--imgname' : 'oc-card-text oc-card-text--clamp';
		card.innerHTML = `
			${media}
			<div class="oc-card-body">
				<div class="${textCls}">${s.content}</div>
				<div class="oc-card-footer">
					<span class="oc-chips">
						<span class="oc-chip" style="--cc:${s.color}">${ICONS[s.kind] ?? ''}${s.label}</span>
					</span>
					<span class="oc-time">${active ? 'just now' : '2m ago'}</span>
				</div>
			</div>`;
		return card;
	}

	function pushCard(s: (typeof snippets)[number]) {
		if (!stack) return;
		stack
			.querySelectorAll('.oc-card--in-clipboard')
			.forEach((c) => c.classList.remove('oc-card--in-clipboard'));
		const card = makeCard(s, true);
		card.classList.add('enter');
		stack.prepend(card);
		requestAnimationFrame(() => requestAnimationFrame(() => card.classList.remove('enter')));
		if (stack.children.length > 6) {
			const last = stack.lastElementChild as HTMLElement;
			last.classList.add('leave');
			setTimeout(() => last.remove(), 350);
		}
	}

	if (reduced || !stack || !sweep) {
		if (stack) {
			snippets.forEach((s, i) => stack.appendChild(makeCard(s, i === 0)));
		}
	} else {
		let i = 0;
		// seed the window so it never reads as an empty app
		[4, 3, 2, 1].forEach((n) => stack.appendChild(makeCard(snippets[n]!, false)));

		const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

		async function loop() {
			let cycles = 0;
			for (;;) {
				const s = snippets[i % snippets.length]!;
				i++;
				sweep!.textContent = s.content;
				sweep!.style.backgroundSize = '0% 100%';
				await wait(500);
				sweep!.style.backgroundSize = '100% 100%';
				await wait(650);
				keys.forEach((k) => k.classList.add('pressed'));
				await wait(260);
				keys.forEach((k) => k.classList.remove('pressed'));
				await wait(140);
				pushCard(s);
				cycles++;
				// every other capture, the cursor comes over and clicks the new card
				if (cycles % 2 === 0 && stack!.firstElementChild) {
					await wait(700);
					await cursorClick(stack!.firstElementChild as HTMLElement, wait);
					await wait(1100);
				} else {
					await wait(2600);
				}
			}
		}
		loop();
	}
</script>

<style>
	.hero {
		padding: 5.5rem 0 6rem;
		position: relative;
		overflow: hidden;
	}

	/* quiet mesh behind the hero */
	.hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background:
			radial-gradient(42% 55% at 82% 18%, rgba(255, 62, 28, 0.09), transparent 70%),
			radial-gradient(30% 40% at 65% 80%, rgba(99, 102, 241, 0.06), transparent 70%),
			radial-gradient(25% 35% at 10% 90%, rgba(255, 62, 28, 0.04), transparent 70%);
		pointer-events: none;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 3.5rem;
		align-items: center;
		position: relative;
	}

	/* The mock is drawn at the app's real window size, 920x560, and the whole
	   block is zoomed as one unit so every internal metric stays in proportion. */
	.hero-demo {
		width: 920px;
		zoom: var(--mz, 1);
	}

	h1 {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(2.5rem, 5.4vw, 3.6rem);
		line-height: 1.08;
		letter-spacing: -0.025em;
		margin: 0 0 1.2rem;
	}

	.sub {
		color: var(--text-secondary);
		font-size: 1.12rem;
		max-width: 32rem;
		margin: 0 0 2rem;
	}

	.ctas {
		display: flex;
		gap: 0.9rem;
		flex-wrap: wrap;
	}

	.meta {
		margin-top: 1.3rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-muted);
	}

	/* ---- capture strip ---- */
	.capture-strip {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
		padding: 0.7rem 1rem;
		border: 1px dashed var(--border-light);
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.015);
	}

	.capture-src {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--text-secondary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		min-width: 0;
	}

	.capture-src .sweep {
		background-image: linear-gradient(rgba(255, 62, 28, 0.35), rgba(255, 62, 28, 0.35));
		background-repeat: no-repeat;
		background-size: 0% 100%;
		transition: background-size 0.45s ease;
		border-radius: 2px;
		padding: 0.1em 0;
	}

	.capture-keys {
		display: flex;
		gap: 0.3rem;
		flex-shrink: 0;
	}

	/* ---- hero window internals: app window is 920x560, titlebar 30 ---- */
	.hero-window {
		width: 920px;
		height: 560px;
		display: flex;
		flex-direction: column;
	}

	.hero-body {
		flex: 1;
		min-height: 0;
	}

	.main-pane {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}

	.pane-top {
		padding: 10px 14px 8px;
	}

	.day-label {
		font-size: 11px;
		font-weight: 600;
		color: var(--text-secondary);
		letter-spacing: 0.3px;
		margin: 0 0 8px 15px;
	}

	/* the app's tiles layout: three CSS columns, 10px gutter, 14px pane padding */
	.stack {
		columns: 3;
		column-gap: 10px;
		padding: 0 14px;
	}

	.stack :global(.oc-card) {
		break-inside: avoid;
		margin-bottom: 10px;
		transition: transform 0.35s ease, opacity 0.35s ease, border-color 0.25s ease;
	}

	.stack :global(.oc-card.enter) {
		transform: translateY(-14px);
		opacity: 0;
	}

	.stack :global(.oc-card.leave) {
		transform: translateY(10px);
		opacity: 0;
	}

	.stack :global(.oc-card-media.img-grad) {
		height: 56px;
		background:
			linear-gradient(135deg, rgba(59, 130, 246, 0.45), rgba(139, 92, 246, 0.3)),
			var(--bg);
	}

	.stack :global(.oc-card-text--imgname) {
		font-size: 11px;
		font-weight: 500;
		color: var(--text-secondary);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* fake cursor */
	.hero-window :global(.fake-cursor) {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 5;
		opacity: 0;
		transform: translate(85%, 80%);
		transition: transform 0.55s cubic-bezier(0.25, 0.7, 0.3, 1), opacity 0.3s ease;
		pointer-events: none;
	}

	.hero-window :global(.fake-cursor.on) {
		opacity: 1;
	}

	.hero-window :global(.fake-cursor.clicking svg) {
		transform: scale(0.82);
	}

	.hero-window :global(.fake-cursor svg) {
		transition: transform 0.12s ease;
		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
	}

	.hero-window :global(.click-ring) {
		position: absolute;
		top: -4px;
		left: -4px;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		border: 2px solid var(--accent);
		opacity: 0;
		transform: scale(0.4);
	}

	.hero-window :global(.fake-cursor.clicking .click-ring) {
		animation: clickRing 0.45s ease-out;
	}

	@keyframes clickRing {
		0% {
			opacity: 0.9;
			transform: scale(0.4);
		}
		100% {
			opacity: 0;
			transform: scale(1.5);
		}
	}

	.stack :global(.oc-time--copied) {
		color: var(--success);
		font-weight: 600;
	}

	/* One knob, so the mock never distorts: it only gets smaller as a whole. */
	@media (max-width: 1500px) {
		.hero-demo {
			--mz: 0.86;
		}
	}

	@media (max-width: 1340px) {
		.hero-demo {
			--mz: 0.74;
		}
	}

	@media (max-width: 1180px) {
		.hero-demo {
			--mz: 0.62;
		}
	}

	@media (max-width: 1023px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 3rem;
			justify-items: center;
		}
		.hero-copy {
			justify-self: start;
		}
		.hero-demo {
			--mz: 0.78;
		}
	}

	@media (max-width: 820px) {
		.hero-demo {
			--mz: 0.62;
		}
	}

	@media (max-width: 640px) {
		.hero-demo {
			--mz: 0.5;
		}
	}

	@media (max-width: 520px) {
		.hero-demo {
			--mz: 0.4;
		}
	}

	@media (max-width: 420px) {
		.hero-demo {
			--mz: 0.35;
		}
	}
</style>
