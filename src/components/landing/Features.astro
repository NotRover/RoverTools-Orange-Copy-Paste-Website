---
const features = [
	{
		title: 'History that holds on',
		body: 'No entry limit, always deduped, and kept across restarts. Pin up to 10 for the quick-paste popup; clearing history never touches pins or saves.',
		tag: 'clipboard',
		color: 'var(--kind-text)',
	},
	{
		title: 'Groups and filters',
		body: 'Tag entries with colored groups, then filter by type, date, group, or cloud state. Deleting a group gives you five seconds to undo it.',
		tag: 'organize',
		color: '#14b8a6',
	},
	{
		title: 'Notes with a real editor',
		body: 'Headings, task lists, tables, code blocks, callouts, images and attachments. Export any note as Markdown whenever you want out.',
		tag: 'notes',
		color: '#eab308',
	},
	{
		title: 'Images, files and video',
		body: 'Screenshots and photos are captured at full quality and kept on disk, not in memory. Copied videos play right on the card.',
		tag: 'media',
		color: 'var(--kind-image)',
	},
	{
		title: 'Works offline, forever',
		body: 'No account required. Everything lives on your machine, and the app is fully usable with sync off or the network gone.',
		tag: 'local-first',
		color: 'var(--kind-url)',
	},
	{
		title: 'Quiet by design',
		body: 'Can close to the tray and start when you sign in, on Windows, macOS and Linux; both are off until you turn them on. The copy and paste sounds are off by default too.',
		tag: 'calm',
		color: 'var(--kind-file)',
	},
];
---

<section class="section feats" id="features">
	<div class="wrap">
		<p class="eyebrow reveal">Features</p>
		<h2 class="section-title reveal">Small app. Long memory.</h2>
		<p class="section-lead reveal">
			Everything below works without an account. Sync and sharing are layered on top,
			never wired in as a requirement.
		</p>
		{/* A bento: history is the product, so it leads at double width with a
		     glimpse of the list beside it; the rest sit in the cells around it,
		     and the last one runs the full width as a strip. */}
		<div class="bento">
			{
				features.map((f, i) => (
					<div class={`tile reveal ${i === 0 ? 'tile--lead' : ''} ${i === features.length - 1 ? 'tile--strip' : ''}`}>
						<div class="tile-copy">
							<span class="oc-chip" style={`--cc:${f.color}`}>{f.tag}</span>
							<h3>{f.title}</h3>
							<p>{f.body}</p>
						</div>
						{i === 0 && (
							<div class="peek" aria-hidden="true">
								<div class="peek-row peek-row--clip">
									<span class="peek-text">git commit -m "tray icon follows the theme"</span>
									<span class="peek-meta">
										<span class="oc-chip" style="--cc:var(--accent)">In clipboard</span>
										<span class="peek-time">Just now</span>
									</span>
								</div>
								<div class="peek-row">
									<span class="peek-text">Standup moved to 10:30, same room</span>
									<span class="peek-meta">
										<span class="oc-chip" style="--cc:#14b8a6">work</span>
										<span class="peek-time">12m</span>
									</span>
								</div>
								<div class="peek-row">
									<span class="peek-text">figma.com/file/k3Lp/onboarding-flow</span>
									<span class="peek-meta">
										<span class="oc-chip" style="--cc:var(--kind-url)">Link</span>
										<span class="peek-time">1h</span>
									</span>
								</div>
							</div>
						)}
					</div>
				))
			}
		</div>
	</div>
</section>

<style>
	.bento {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.9rem;
	}

	.tile {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.25rem 1.35rem;
		transition: border-color 0.2s ease;
	}

	.tile:hover {
		border-color: var(--border-light);
	}

	.tile h3 {
		font-family: var(--font-display);
		font-size: 1.02rem;
		font-weight: 700;
		margin: 0.75rem 0 0.4rem;
		letter-spacing: -0.01em;
	}

	.tile p {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.88rem;
	}

	/* the lead: double width, the copy beside a glimpse of the history list */
	.tile--lead {
		grid-column: span 2;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: 1.6rem;
		align-items: center;
	}

	.tile--lead h3 {
		font-size: 1.3rem;
	}

	/* the closing strip: title on the left, the line on the right */
	.tile--strip {
		grid-column: 1 / -1;
	}

	.tile--strip .tile-copy {
		display: grid;
		grid-template-columns: auto minmax(0, 15rem) minmax(0, 1fr);
		align-items: baseline;
		gap: 0 1.4rem;
	}

	.tile--strip h3 {
		margin: 0;
	}

	.tile--strip p {
		max-width: 46rem;
	}

	/* three rows drawn like the app's entry cards: the one on the clipboard
	   carries the same left-edge glow it has in the app */
	.peek {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.peek-row {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--bg);
	}

	.peek-row--clip {
		background-image: linear-gradient(90deg, rgba(255, 62, 28, 0.12), transparent 60%);
	}

	.peek-text {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: var(--text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.peek-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.peek-time {
		font-size: 0.68rem;
		color: var(--text-muted);
	}

	@media (max-width: 980px) {
		.tile--lead {
			grid-template-columns: minmax(0, 1fr);
		}

		.tile--strip .tile-copy {
			display: block;
		}

		.tile--strip h3 {
			margin: 0.75rem 0 0.4rem;
		}
	}

	@media (max-width: 820px) {
		.bento {
			grid-template-columns: minmax(0, 1fr);
		}

		.tile--lead {
			grid-column: auto;
		}
	}
</style>
