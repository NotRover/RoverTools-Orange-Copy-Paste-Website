---
/**
 * The spaces screen on its own, without the window around it, so the wide shot
 * and the guided demo can both draw it and cannot drift apart.
 *
 * The app always draws all three panels - list, feed, rules - and lets you drag
 * the two side ones inside a range (LIST_PANE 244-380, def 252; RULES_PANE
 * 240-420, def 272). Both widths are props here for the same reason: the wide
 * shot has room for the defaults and then some, the 920 demo does not, and
 * dragging the sides in is what a person running it that size does.
 *
 * `arrival` adds one card that starts hidden, for the demo to bring in.
 * `feedExtra` lengthens the feed past the window, so the demo has something to
 * scroll: the static shot is clipped either way and does not want the weight.
 */
import { CHIP_ICONS, KIND_COLORS, TB_ICONS, SRC_ICONS, THUMBS } from './app-parts';

interface Props {
	listWidth?: number;
	rulesWidth?: number;
	gridId?: string;
	arrival?: boolean;
	feedExtra?: boolean;
}

const { listWidth = 252, rulesWidth = 272, gridId, arrival = false, feedExtra = false } = Astro.props;

/* more of the same feed, further down it. Same shapes as the cards above, so
   they are written as data rather than another dozen copies of the markup. */
const FEED_EXTRA = [
	{ text: 'The rail needs ends. A line that stops dead reads as a bug.', kind: 'text', label: 'Text', who: 'rio', age: '1d ago' },
	{ text: 'docs.rovertools.app/spaces/invites', kind: 'url', label: 'URL', who: 'mei', age: '1d ago' },
	{ text: 'space-key-handover.pdf', kind: 'document', label: 'Doc', who: 'You', age: '1d ago' },
	{ text: 'Members panel: show who is online before who joined first.', kind: 'text', label: 'Text', who: 'Ada Lovelace', age: '1d ago' },
	{ text: 'invite-flow-v3 (5 files)', kind: 'file', label: 'File', who: 'rio', age: '1d ago' },
	{ text: 'figma.com/file/orangecp/members-rail', kind: 'url', label: 'URL', who: 'You', age: '1d ago' },
];

/* the app's own RULES_LABEL_WIDTH: above it the rail has room to spell its
   invite buttons out, below it they fall back to icons */
const rulesWide = rulesWidth >= 336;

/* UserAvatar.tsx's avatarInitials: two words give their first letters, one
   word gives its first two, always uppercase */
const initials = (name: string) => {
	const w = name.trim().split(/\s+/).filter(Boolean);
	return (w.length > 1 ? w[0][0] + w[1][0] : w[0].slice(0, 2)).toUpperCase();
};
