---
/**
 * The clipboard history screen as the app draws it: toolbar (sort, filters,
 * search, layout switch, select, groups, clear), the Today group header on the
 * timeline rail, then the three-column tiles grid. Cards come from the slot.
 */
import { TB_ICONS } from './app-parts';

interface Props {
	/** entry count shown on the clear button */
	count?: number;
	/** number of groups on the groups badge */
	groups?: number;
	/** the date line beside "Today" */
	date?: string;
	/** the date line beside "Yesterday", when an earlier group is passed in */
	earlierDate?: string;
	/** id put on the tiles grid, so a script can drop cards straight into it */
	gridId?: string;
	/** draw the app's scrollbar down the right edge of the viewport */
	scrollbar?: boolean;
	/** thumb top as a percentage of the track */
	thumbTop?: number;
	/** thumb height as a percentage of the track */
	thumbHeight?: number;
}

const {
	count = 128,
	groups = 3,
	date = 'Aug 21, 2026',
	earlierDate = 'Aug 20, 2026',
	gridId,
	scrollbar = false,
	thumbTop = 4,
	thumbHeight = 44,
} = Astro.props;

const hasEarlier = Astro.slots.has('earlier');
---

<div class="oc-screen">
	<div class="oc-toolbar">
		<div class="oc-tb-group">
			<span class="oc-tb-btn">
				<Fragment set:html={TB_ICONS.sortArrow} />
				<Fragment set:html={TB_ICONS.chevron} />
			</span>
			<span class="oc-tb-btn" set:html={TB_ICONS.filter} />
		</div>

		<div class="oc-search">
			<span class="oc-search-icon" set:html={TB_ICONS.search} />
			<span class="oc-search-field">Search...</span>
		</div>

		<div class="oc-tb-group">
			<div class="oc-seg">
				<span class="oc-seg-slider"></span>
				<span class="oc-seg-btn oc-seg-btn--active" set:html={TB_ICONS.tiles} />
				<span class="oc-seg-btn" set:html={TB_ICONS.columns} />
				<span class="oc-seg-btn" set:html={TB_ICONS.single} />
			</div>
			<span class="oc-tb-sep"></span>
			<span class="oc-tb-btn" set:html={TB_ICONS.select} />
			<span class="oc-tb-btn">
				<Fragment set:html={TB_ICONS.groups} />
				<span class="oc-tb-badge">{groups}</span>
			</span>
			<span class="oc-tb-btn oc-tb-btn--danger">
				<Fragment set:html={TB_ICONS.trash} />
				<span class="oc-tb-n">{count}</span>
			</span>
		</div>
	</div>

	<div class="oc-viewport">
		<div class="oc-timeline">
			<div class="oc-groups">
				<div class:list={['oc-group', !hasEarlier && 'oc-group--only']}>
					<div class="oc-day-row">
						<span class="oc-day-dot"></span>
						<span class="oc-day-label">Today</span>
						<span class="oc-day-sub">{date}</span>
						<span class="oc-day-chevron" set:html={TB_ICONS.dayChevron} />
					</div>
					<div class="oc-grid" id={gridId}><slot /></div>
				</div>
				{
					hasEarlier && (
						<div class="oc-group oc-group--last">
							<div class="oc-day-row">
								<span class="oc-day-dot" />
								<span class="oc-day-label">Yesterday</span>
								<span class="oc-day-sub">{earlierDate}</span>
								<span class="oc-day-chevron" set:html={TB_ICONS.dayChevron} />
							</div>
							<div class="oc-grid">
								<slot name="earlier" />
							</div>
						</div>
					)
				}
			</div>
		</div>
		{
			scrollbar && (
				<div class="oc-sb">
					<span
						class="oc-sb-thumb"
						style={`top:${thumbTop}%;height:${thumbHeight}%`}
					/>
				</div>
			)
		}
	</div>
	<slot name="menu" />
</div>

<style>
	.oc-screen {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	/* the scrollbar hangs off the scrolling box, not the screen */
	.oc-viewport {
		position: relative;
	}

	/* The viewport really does scroll in the app; a static shot has to say so.
	   Values from .layout-viewport::-webkit-scrollbar in ClipboardScreen.css:
	   12px wide, transparent track, --border-light thumb with a 2px --bg ring
	   and a fully round cap. */
	.oc-sb {
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		width: 12px;
		pointer-events: none;
	}

	.oc-sb-thumb {
		position: absolute;
		left: 2px;
		right: 2px;
		border-radius: 999px;
		background: var(--border-light);
	}
</style>
