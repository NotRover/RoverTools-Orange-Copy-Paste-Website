---
/**
 * The copy popup that Ctrl+Shift+C shows, matching the app's redesigned
 * copy-popup (copyPopup.css / CopyPopup.tsx): "Copied" title with the type
 * pill, a mono preview that fills the middle, and a CardMenu-style action row
 * (Pin, Groups, Share, then Delete past a divider) with the label ahead of the
 * icon. Drawn at the app's visible container size, 328x248 - the 340x260 window
 * less its 6px transparent margin. The page that places it does the scaling.
 */
import { CHIP_ICONS, KIND_COLORS, MENU_ICONS, SRC_ICONS } from '../app-parts';
---

<div class="cp">
	<div class="cp-header">
		<div class="cp-head-left">
			<span class="cp-title">Copied</span>
			<div class="cp-chips">
				<span class="oc-chip" style={`--cc:${KIND_COLORS.text}`}><Fragment set:html={CHIP_ICONS.text} /><span class="oc-chip-label">Text</span></span>
			</div>
		</div>
		<button class="cp-close" set:html={SRC_ICONS.close10} />
	</div>
	<div class="cp-preview">
		<p class="cp-preview-text">The quarterly numbers land Thursday. Loop finance in before the board call and confirm the travel line.</p>
	</div>
	<div class="cp-actions">
		<button class="cp-item cp-item--pin"><span>Pin</span><Fragment set:html={MENU_ICONS.pin} /></button>
		<button class="cp-item cp-item--groups"><span>Groups</span><Fragment set:html={MENU_ICONS.tag} /></button>
		<button class="cp-item cp-item--share"><span>Share</span><Fragment set:html={MENU_ICONS.share} /></button>
		<span class="cp-divider"></span>
		<button class="cp-item cp-item--danger"><span>Delete</span><Fragment set:html={MENU_ICONS.trash} /></button>
	</div>
</div>

<style>
	/* ---- copy popup: the app's copyPopup.css, at the visible container size ---- */

	.cp {
		width: 328px;
		height: 248px;
		box-sizing: border-box;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		padding: 10px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
		font-size: 13px;
		line-height: normal;
	}

	.cp-header {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 2px;
	}

	.cp-head-left {
		display: flex;
		align-items: center;
		gap: 8px;
		flex: 1;
		min-width: 0;
	}

	.cp-title {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--accent);
		flex-shrink: 0;
	}

	.cp-chips {
		display: flex;
		align-items: center;
		gap: 4px;
		flex: 1;
		min-width: 0;
		overflow: hidden;
	}

	.cp-close {
		width: 22px;
		height: 22px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-muted);
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 6px;
		flex-shrink: 0;
		padding: 0;
	}

	/* fills the room between the chips and the actions, the way flex:1 does in
	   the app - a slightly-off height shrinks the preview, never the chrome */
	.cp-preview {
		flex: 1;
		min-height: 0;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		padding: 8px 10px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.cp-preview-text {
		margin: 0;
		font-size: 11.5px;
		line-height: 1.5;
		color: var(--text-secondary);
		white-space: pre-wrap;
		word-break: break-word;
		font-family: 'Cascadia Code', 'Fira Code', Consolas, monospace;
	}

	/* CardMenu-style actions: borderless, neutral at rest, the label before the
	   icon; Delete reads red at rest, set off by a divider. */
	.cp-actions {
		display: flex;
		align-items: center;
		gap: 2px;
	}

	.cp-item {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-width: 0;
		width: 100%;
		padding: 7px 6px;
		border: none;
		border-radius: var(--radius-xs);
		background: transparent;
		color: var(--text-secondary);
		font-size: 12px;
		font-weight: 500;
		font-family: inherit;
		text-align: center;
	}

	.cp-item span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.cp-item :global(svg) {
		width: 13px;
		height: 13px;
		flex-shrink: 0;
	}

	.cp-item--danger {
		color: var(--danger);
	}

	.cp-divider {
		width: 1px;
		align-self: stretch;
		margin: 5px 3px;
		background: var(--border);
		flex-shrink: 0;
	}
</style>
