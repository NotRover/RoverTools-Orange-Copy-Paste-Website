---
/**
 * A space's send rules, from SpacesScreen.css.
 *
 * Drawn at the app's own size: the page that places it does the scaling.
 */
---

<div class="sp-settings-block">
	<div class="sp-settings-label">Rules<span class="sp-settings-count">auto</span></div>
	<div class="sp-toggle-row">
		<span class="sp-toggle-text">
			<span class="sp-toggle-title">Copy new items in</span>
			<span class="sp-toggle-desc">Anything shared here lands on your clipboard as it arrives.</span>
		</span>
		<span class="sp-switch sp-switch--on"></span>
	</div>
	<div class="sp-toggle-row">
		<span class="sp-toggle-text">
			<span class="sp-toggle-title">Share new items out</span>
			<span class="sp-toggle-desc">Off. Only items you share by hand go into this space.</span>
		</span>
		<span class="sp-switch"></span>
	</div>
	<div class="sp-toggle-row">
		<span class="sp-toggle-text">
			<span class="sp-toggle-title">Show removed items</span>
			<span class="sp-toggle-desc">Keeps a line where something used to be, with who took it out.</span>
		</span>
		<span class="sp-switch"></span>
	</div>
</div>
