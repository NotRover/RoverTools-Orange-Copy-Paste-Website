---
/**
 * The storage and activity zone, from AccountScreen.css.
 *
 * Drawn at the app's own size: the page that places it does the scaling.
 */
import { KIND_COLORS, SRC_ICONS } from '../app-parts';
---

<div class="acct-zone">
	<div class="acct-zone-head">
		<span class="acct-zone-icon" set:html={SRC_ICONS.chartBar13} />
		<span class="acct-zone-label">Storage and activity</span>
	</div>
	<div class="acct-card acct-card--rows">
		<div class="acct-comp">
			<div class="acct-comp-head">
				<div class="acct-seg">
					<span class="acct-seg-pill">This device</span>
					<span class="acct-seg-pill active">Cloud</span>
				</div>
				<span class="acct-comp-total">96 items</span>
			</div>
			<div class="acct-comp-bar">
				<span class="acct-comp-seg" style={`width:43.75%;background:${KIND_COLORS.text}`}></span>
				<span class="acct-comp-seg" style={`width:26.04%;background:${KIND_COLORS.image}`}></span>
				<span class="acct-comp-seg" style={`width:20.83%;background:${KIND_COLORS.url}`}></span>
				<span class="acct-comp-seg" style={`width:9.38%;background:${KIND_COLORS.notes}`}></span>
			</div>
			<div class="acct-comp-legend">
				<div class="acct-comp-row">
					<span class="acct-comp-dot" style={`background:${KIND_COLORS.text}`}></span>
					<span class="acct-comp-label">Text</span>
					<span class="acct-comp-count">42</span>
					<span class="acct-comp-pct">44%</span>
				</div>
				<div class="acct-comp-row">
					<span class="acct-comp-dot" style={`background:${KIND_COLORS.image}`}></span>
					<span class="acct-comp-label">Image</span>
					<span class="acct-comp-count">25</span>
					<span class="acct-comp-pct">26%</span>
				</div>
				<div class="acct-comp-row">
					<span class="acct-comp-dot" style={`background:${KIND_COLORS.url}`}></span>
					<span class="acct-comp-label">URL</span>
					<span class="acct-comp-count">20</span>
					<span class="acct-comp-pct">21%</span>
				</div>
				<div class="acct-comp-row">
					<span class="acct-comp-dot" style={`background:${KIND_COLORS.notes}`}></span>
					<span class="acct-comp-label">Notes</span>
					<span class="acct-comp-count">9</span>
					<span class="acct-comp-pct">9%</span>
				</div>
			</div>
			<p class="acct-comp-note">
				Only what you uploaded. Picking a row syncs first, then opens it.
			</p>
		</div>
		<div class="acct-quota">
			<div class="acct-quota-head">
				<Fragment set:html={SRC_ICONS.hardDrives13} />
				<span>Cloud image storage</span>
				<span class="acct-quota-value">25% of 50.0 MB</span>
			</div>
			<div class="acct-quota-track"><div class="acct-quota-fill" style="width:25%"></div></div>
			<p class="acct-quota-note">
				12.4 MB used, 37.6 MB free. Only images you uploaded count here. Text and
				notes take no storage, and images other people shared with you stay on
				their account.
			</p>
		</div>
		<div class="acct-quota">
			<div class="acct-quota-head">
				<Fragment set:html={SRC_ICONS.stack13} />
				<span>Synced items</span>
				<span class="acct-quota-value">3% of 3,000</span>
			</div>
			<div class="acct-quota-track"><div class="acct-quota-fill" style="width:3.2%"></div></div>
			<p class="acct-quota-note">
				96 of 3,000 rows used. Deleted items stop counting once the delete reaches
				the server. A single entry can be up to 512 KB; anything larger is left on
				this device.
			</p>
		</div>
	</div>
</div>
