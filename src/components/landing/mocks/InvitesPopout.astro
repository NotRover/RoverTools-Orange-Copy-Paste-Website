---
/**
 * The invites popout, which shares its shell with the notifications one.
 *
 * Drawn at the app's own size: the page that places it does the scaling.
 */
---

<div class="inv-pop">
	<div class="inv-head"><span class="inv-title">Invites</span></div>
	<div class="inv-tabs">
		<span class="inv-tab active">Requests<span class="inv-tab-count">2</span></span>
		<span class="inv-tab">Received<span class="inv-tab-count">1</span></span>
		<span class="inv-tab">Sent<span class="inv-tab-count">0</span></span>
	</div>
	<div class="inv-list">
		<div class="inv-row">
			<p class="inv-row-space">Design</p>
			<p class="inv-row-sub">rio used a code or a join link<span class="inv-row-meta"> 4 min ago</span></p>
			<div class="inv-row-actions">
				<span class="inv-btn inv-btn--primary">Approve</span>
				<span class="inv-btn">Decline</span>
			</div>
		</div>
		<div class="inv-row">
			<p class="inv-row-space">Ops</p>
			<p class="inv-row-sub">mei used a code or a join link<span class="inv-row-meta"> 1 hr ago</span></p>
			<div class="inv-row-actions">
				<span class="inv-btn inv-btn--primary">Approve</span>
				<span class="inv-btn">Decline</span>
			</div>
		</div>
	</div>
</div>
