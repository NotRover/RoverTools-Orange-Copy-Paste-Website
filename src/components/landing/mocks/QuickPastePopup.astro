---
/**
 * The Quick Paste popup, 340px wide, at the app's own metrics.
 *
 * Drawn at the app's own size: the page that places it does the scaling.
 */
import { CHIP_ICONS, KIND_COLORS, SRC_ICONS } from '../app-parts';
---

<div class="pp">
	<div class="pp-header">
		<div class="pp-header-left">
			<span class="pp-title">Quick Paste</span>
			<span class="pp-count">5</span>
		</div>
		<div class="pp-tabs">
			<span class="pp-tab pp-tab--active">Recent<span class="pp-tab-count">5</span></span>
			<span class="pp-tab">Pinned<span class="pp-tab-count">2</span></span>
		</div>
		<span class="pp-close" set:html={SRC_ICONS.close10} />
	</div>
	<div class="pp-list">
		<div class="pp-item">
			<span class="pp-badge">1</span>
			<div class="pp-wrap">
				<span class="oc-chip" style={`--cc:${KIND_COLORS.text}`}><Fragment set:html={CHIP_ICONS.text} /><span class="oc-chip-label">Text</span></span>
				<span class="pp-filename">Meet at the station, platform 4, 9:40...</span>
			</div>
			<span class="pp-meta"><span class="pp-time">2m</span></span>
		</div>
		<div class="pp-item pp-item--selected">
			<span class="pp-badge">2</span>
			<div class="pp-wrap">
				<span class="oc-chip" style={`--cc:${KIND_COLORS.url}`}><Fragment set:html={CHIP_ICONS.url} /><span class="oc-chip-label">URL</span></span>
				<span class="pp-filename">github.com/Spectrewolf8/RoverTools-Rel...</span>
			</div>
			<span class="pp-meta"><span class="pp-pin" set:html={CHIP_ICONS.pin} /><span class="pp-time">1h</span></span>
		</div>
		<div class="pp-item">
			<span class="pp-badge">3</span>
			<div class="pp-wrap">
				<span class="oc-chip" style={`--cc:${KIND_COLORS.document}`}><Fragment set:html={CHIP_ICONS.document} /><span class="oc-chip-label">Doc</span></span>
				<span class="pp-filename">quarterly-report.pdf</span>
			</div>
			<span class="pp-meta"><span class="pp-time">3d</span></span>
		</div>
		<div class="pp-item">
			<span class="pp-badge">4</span>
			<div class="pp-wrap">
				<span class="oc-chip" style={`--cc:${KIND_COLORS.image}`}><Fragment set:html={CHIP_ICONS.image} /><span class="oc-chip-label">Image</span></span>
				<span class="pp-filename">#a1b2c3d4 Image Aug 21, 2:45 PM</span>
			</div>
			<span class="pp-meta"><span class="pp-time">4d</span></span>
		</div>
		<div class="pp-item">
			<span class="pp-badge">5</span>
			<div class="pp-wrap">
				<span class="oc-chip" style={`--cc:${KIND_COLORS.folder}`}><Fragment set:html={CHIP_ICONS.folder} /><span class="oc-chip-label">Folder</span></span>
				<span class="pp-filename">/home/rio/projects/orangecp/assets</span>
			</div>
			<span class="pp-meta"><span class="pp-time">6d</span></span>
		</div>
	</div>
	<span class="pp-cursor" aria-hidden="true">
		<span class="pp-ring"></span>
		<svg viewBox="0 0 24 24" width="16" height="16"><path d="M5 2l0 17 4.2-3.6 2.6 6 3-1.3-2.6-5.9 6-.6z" fill="#fff" stroke="#111" stroke-width="1.4" stroke-linejoin="round"/></svg>
	</span>
</div>

<style>
	.pp {
		position: relative;
		width: 340px;
		background: var(--bg);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		padding: 10px 10px 4px;
		font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
		font-size: 13px;
		line-height: normal;
	}

	.pp-header {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 2px 2px 6px;
	}

	.pp-header-left {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.pp-title {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--accent);
	}

	.pp-count {
		font-size: 10px;
		font-weight: 600;
		color: var(--text-muted);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 3px 8px;
		line-height: 1;
		letter-spacing: 0.2px;
	}

	.pp-tabs {
		display: flex;
		gap: 1px;
		margin-left: auto;
		margin-right: 6px;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 2px;
	}

	.pp-tab {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: 10px;
		font-weight: 600;
		color: var(--text-muted);
		border-radius: 4px;
		padding: 3px 8px;
		line-height: 1;
	}

	.pp-tab--active {
		background: var(--accent-dim);
		color: var(--accent);
	}

	.pp-tab-count {
		font-size: 9px;
		font-weight: 600;
		color: var(--text-muted);
		min-width: 14px;
		text-align: center;
	}

	.pp-tab--active .pp-tab-count {
		color: var(--accent);
	}

	.pp-close {
		width: 22px;
		height: 22px;
		border: 1px solid var(--border);
		background: var(--surface);
		color: var(--text-muted);
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 6px;
		flex-shrink: 0;
	}

	.pp-list {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}

	.pp-item {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 7px 10px;
		min-height: 40px;
		border: 1px solid var(--border);
		border-radius: var(--radius-xs);
		background: var(--surface);
		color: var(--text);
		font-size: 12px;
	}

	/* selected row: accent border, and the badge picks up accent - no fill */

	.pp-item--selected {
		border-color: var(--accent);
	}

	.pp-item--selected .pp-badge {
		color: var(--accent);
	}

	.pp-badge {
		width: 20px;
		height: 20px;
		border-radius: 5px;
		border: 1px solid var(--border);
		background: var(--bg);
		color: var(--text-muted);
		font-size: 10px;
		font-weight: 600;
		font-family: 'Cascadia Code', 'Fira Code', Consolas, monospace;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.pp-wrap {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 8px;
		overflow: hidden;
	}

	.pp-filename {
		font-size: 11px;
		color: var(--text-secondary);
		font-family: 'Cascadia Code', 'Fira Code', Consolas, monospace;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		min-width: 0;
		flex: 1;
	}

	.pp-meta {
		display: flex;
		align-items: center;
		gap: 4px;
		flex-shrink: 0;
	}

	.pp-pin {
		color: var(--accent);
		display: flex;
	}

	.pp-time {
		font-size: 10px;
		color: var(--text-muted);
		white-space: nowrap;
	}

	/* looping cursor that clicks slot 2 */

	.pp-cursor {
		position: absolute;
		top: 0;
		left: 0;
		pointer-events: none;
		animation: ppCursor 6.5s ease-in-out infinite;
		filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
	}

	.pp-ring {
		position: absolute;
		top: -5px;
		left: -5px;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		border: 2px solid var(--accent);
		opacity: 0;
		animation: ppRing 6.5s ease-out infinite;
	}

	@keyframes ppCursor {
		0%, 12% { transform: translate(210px, 190px); opacity: 0; }
		22% { opacity: 1; }
		38% { transform: translate(190px, 60px); opacity: 1; }
		52%, 60% { transform: translate(176px, 92px); opacity: 1; }
		56% { transform: translate(176px, 92px) scale(0.85); }
		80% { transform: translate(210px, 190px); opacity: 1; }
		88%, 100% { transform: translate(210px, 190px); opacity: 0; }
	}

	@keyframes ppRing {
		0%, 54% { opacity: 0; transform: scale(0.4); }
		56% { opacity: 0.9; transform: scale(0.5); }
		64% { opacity: 0; transform: scale(1.5); }
		100% { opacity: 0; }
	}
</style>
