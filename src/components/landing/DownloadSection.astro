---
/**
 * The installers, linked directly.
 *
 * The links are baked in at build time and refreshed in the browser, so a
 * release published since the last site build still lands on the right file.
 * `data-dl` is what the script updates; if GitHub cannot be reached at either
 * point, every button falls back to the releases page.
 */
import { Icon } from 'astro-icon/components';
import { fetchBuild, RELEASES_PAGE } from '../../lib/releases';
import { REPO_URL } from '../../lib/github';
import { osLogo } from './app-parts';

const build = await fetchBuild();
---

<section class="section dl" id="download">
	<div class="wrap dl-inner">
		<p class="eyebrow reveal">Download</p>
		<h2 class="section-title reveal">Your clipboard is about to get a memory.</h2>
		<p class="section-lead reveal center">
			Free, no account, nothing to set up. Install it and your next copy is kept.
		</p>
		{/* Each card says the same three things in the same order - what you get,
		    what it runs on, the one thing to know - in two lines at desktop width, then one
		    main button and its setup notes, pinned to the card's foot. Only the
		    visitor's own platform gets the orange button (the script below). */}
		<div class="dl-cards">
			<div class="dl-card reveal">
				<h3><span class="dl-logo" set:html={osLogo('windows', 22)} /><span class="dl-name">Windows</span><span class="dl-ver" data-dl-version hidden={!build}>{build ? `v${build.version}` : ''}</span></h3>
				<p>An installer for Windows 10 and 11. It installs for your user only, so no admin rights are needed.</p>
				<div class="dl-row">
					<a class="btn btn-primary" data-main="windows" data-dl="windows" href={build?.windows ?? RELEASES_PAGE}>
						Download the installer
					</a>
					<a class="dl-note-link" href="/docs/getting-started/">Setup notes</a>
				</div>
			</div>
			<div class="dl-card reveal">
				<h3><span class="dl-logo" set:html={osLogo('linux', 22)} /><span class="dl-name">Linux</span><span class="dl-beta">Beta</span><span class="dl-ver" data-dl-version hidden={!build}>{build ? `v${build.version}` : ''}</span></h3>
				<p>A .deb for Debian, Ubuntu and their relatives. Best on X11; Wayland needs one setup step.</p>
				<div class="dl-row">
					<a class="btn btn-ghost" data-main="linux" data-dl="deb" href={build?.deb ?? RELEASES_PAGE}>Download the .deb</a>
					<a class="dl-note-link" href="/docs/linux/">Setup notes</a>
				</div>
			</div>
			<div class="dl-card reveal">
				<h3><span class="dl-logo" set:html={osLogo('apple', 22)} /><span class="dl-name">macOS</span><span class="dl-beta">Beta</span><span class="dl-ver" data-dl-version hidden={!build}>{build ? `v${build.version}` : ''}</span></h3>
				<p>One disk image per chip, for macOS 10.15 and later. The first launch asks for one permission.</p>
				<div class="dl-row">
					<a class="btn btn-ghost" data-main="mac" data-dl="macArm" href={build?.macArm ?? RELEASES_PAGE}>
						Apple silicon
					</a>
					<a class="btn btn-ghost" data-dl="macIntel" href={build?.macIntel ?? RELEASES_PAGE}>Intel</a>
					<a class="dl-note-link" href="/docs/macos/">Setup notes</a>
				</div>
			</div>
		</div>
		{/* Under the cards, quieter than them: the beta channel, then the two
		    links out - the code and the release notes - side by side as the
		    section's sign-off. */}
		<p class="dl-beta-line reveal">
			Want new features early? Turn on <span class="dl-setting">Get beta versions</span> in
			Settings, under Updates.
		</p>
		<p class="dl-source reveal">
			<a href={REPO_URL} target="_blank" rel="noopener">
				<Icon name="lucide:github" size={16} />Open source. Browse the code on GitHub.
			</a>
			<a data-dl="page" href={build?.page ?? RELEASES_PAGE}>
				<Icon name="lucide:file-text" size={16} />Release notes
			</a>
		</p>
	</div>
</section>

<style>
	.dl-source {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.75rem;
		margin: 2.4rem 0 0;
	}

	.dl-source a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.85rem;
		transition: color 0.15s ease;
	}

	.dl-source a:hover {
		color: var(--text);
	}

	.dl {
		background:
			radial-gradient(60% 80% at 50% 110%, rgba(255, 62, 28, 0.13), transparent 70%),
			var(--bg);
	}

	.dl-inner {
		text-align: center;
	}

	.section-lead.center {
		margin-left: auto;
		margin-right: auto;
	}

	.dl-cards {
		display: grid;
		/* Wide enough that each card's buttons and note link sit on one line;
		   the shortest wrap-free width is the macOS row with its two chips. */
		grid-template-columns: repeat(3, minmax(0, 23.5rem));
		justify-content: center;
		gap: 1.2rem;
		text-align: left;
	}

	/* a column, so the button row sits on the card's foot whatever the copy
	   above it does, and the three rows line up across the cards */
	.dl-card {
		display: flex;
		flex-direction: column;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.5rem;
	}

	.dl-card h3 {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-display);
		font-size: 1.25rem;
		margin: 0 0 0.8rem;
	}

	.dl-logo {
		display: inline-flex;
		flex-shrink: 0;
	}

	/* The Linux and Mac apps shipped later than the Windows one and are still
	   settling; the chip says so where the download is. */
	.dl-beta {
		font-family: var(--font-body);
		font-size: 0.68rem;
		font-weight: 600;
		line-height: 1;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--accent);
		background: var(--accent-dim);
		border: 1px solid var(--accent-dim-strong);
		/* Squircle where the browser can draw one, a rounded rectangle elsewhere. */
		border-radius: 0.45rem;
		corner-shape: squircle;
		padding: 0.25rem 0.5rem;
		margin-left: 0.15rem;
	}

	.dl-logo :global(svg) {
		display: block;
	}

	.dl-card .btn {
		white-space: nowrap;
	}

	/* The version sits at the far end of the heading row, in the card's top
	   corner, level with the name and the same on every card. It is hidden
	   when GitHub could not be asked, at build time or in the browser: no
	   number beats a vague one. */
	.dl-ver {
		margin-left: auto;
		align-self: center;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1;
		color: var(--text-muted);
		white-space: nowrap;
	}

	.dl-card p {
		color: var(--text-secondary);
		font-size: 0.9rem;
		margin: 0 0 1.6rem;
	}

	.dl-card .dl-row {
		margin-top: auto;
	}

	.dl-row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.dl-note-link {
		margin-left: auto;
		font-size: 0.85rem;
		color: var(--text-secondary);
		white-space: nowrap;
		transition: color 0.15s ease;
	}

	.dl-note-link:hover {
		color: var(--text);
	}

	.dl-beta-line {
		margin: 2.2rem 0 0;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	/* The toggle's own label, lifted by weight and colour rather than set in
	   mono: a mono run inside a sentence brings its wide spaces with it, and
	   the line reads unevenly spaced. */
	.dl-setting {
		font-weight: 500;
		color: var(--text-secondary);
	}



	@media (max-width: 1024px) {
		.dl-cards {
			grid-template-columns: repeat(2, minmax(0, 24rem));
		}
	}

	@media (max-width: 760px) {
		.dl-cards {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* On a phone the buttons share the card's full width and the setup notes
	   drop to their own centred line, so nothing runs past the card's edge. */
	@media (max-width: 520px) {
		.dl-row {
			flex-wrap: wrap;
		}
		.dl-row .btn {
			flex: 1 1 0;
			justify-content: center;
		}
		.dl-note-link {
			flex-basis: 100%;
			margin-left: 0;
			text-align: center;
		}
	}
</style>

<script>
	/* The baked-in links are only as fresh as the last site build, and a release
	   lands without one. This asks GitHub for the current build and repoints the
	   buttons if it has moved on. It is allowed to fail - unauthenticated calls
	   are rate limited per address, and the links it would replace already work. */
	import { fetchBuild } from '../../lib/releases';

	/* Orange goes on the visitor's own platform only, the same guess the hero
	   makes: Windows unless the browser says Mac or Linux. The page is built
	   with Windows orange, so without this script it reads like the hero. */
	{
		const ua = navigator.userAgent;
		const plat =
			(navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ??
			navigator.platform ??
			'';
		let os = 'windows';
		if (/mac/i.test(plat) || /Macintosh/.test(ua)) os = 'mac';
		else if (/linux/i.test(plat) && !/Android/i.test(ua)) os = 'linux';
		for (const el of document.querySelectorAll<HTMLElement>('#download [data-main]')) {
			const mine = el.dataset.main === os;
			el.classList.toggle('btn-primary', mine);
			el.classList.toggle('btn-ghost', !mine);
		}
	}

	const build = await fetchBuild();
	if (build) {
		for (const el of document.querySelectorAll<HTMLAnchorElement>('a[data-dl]')) {
			const href = build[el.dataset.dl as 'windows' | 'deb' | 'macArm' | 'macIntel' | 'page'];
			if (href) el.href = href;
		}
		for (const el of document.querySelectorAll('[data-dl-version]')) {
			el.textContent = `v${build.version}`;
			(el as HTMLElement).hidden = false;
		}
	}
</script>
