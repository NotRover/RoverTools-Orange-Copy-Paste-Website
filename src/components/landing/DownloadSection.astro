---
/**
 * The installers, linked directly.
 *
 * The links are baked in at build time and refreshed in the browser, so a
 * release published since the last site build still lands on the right file.
 * `data-dl` is what the script updates; if GitHub cannot be reached at either
 * point, every button falls back to the releases page.
 */
import { fetchBuild, RELEASES_PAGE } from '../../lib/releases';

const build = await fetchBuild();
---

<section class="section dl" id="download">
	<div class="wrap dl-inner">
		<p class="eyebrow reveal">Download</p>
		<h2 class="section-title reveal">Your clipboard is about to get a memory.</h2>
		<p class="section-lead reveal center">
			Free, no account, nothing to configure. Install it, copy something, press
			Ctrl+Shift+V.
		</p>
		<div class="dl-cards">
			<div class="dl-card reveal">
				<h3>Windows</h3>
				<p>Installer for Windows 10 and 11. Installs per user, no admin needed.</p>
				<a class="btn btn-primary" data-dl="windows" href={build?.windows ?? RELEASES_PAGE}>
					Download the installer
				</a>
			</div>
			<div class="dl-card reveal">
				<h3>Linux</h3>
				<p>AppImage to run it as it comes, or a deb to install it. X11 is the smoothest ride, and Wayland works with a small setup step.</p>
				<div class="dl-row">
					<a class="btn btn-ghost" data-dl="appImage" href={build?.appImage ?? RELEASES_PAGE}>
						AppImage
					</a>
					<a class="btn btn-ghost" data-dl="deb" href={build?.deb ?? RELEASES_PAGE}>.deb</a>
					<a class="dl-note-link" href="/docs/linux/">Linux notes</a>
				</div>
			</div>
			<div class="dl-card dl-card--soon reveal">
				<h3>macOS</h3>
				<p>A Mac build is on the way. Everything here, on Apple silicon and Intel.</p>
				<span class="btn btn-ghost dl-soon-cta" aria-disabled="true">Coming soon...</span>
			</div>
		</div>
		<p class="dl-version reveal">
			<span data-dl-version>{build ? `Version ${build.version}` : 'Latest build'}</span>
			<span class="dl-sep">-</span>
			<a data-dl="page" href={build?.page ?? RELEASES_PAGE}>every build and its notes</a>
		</p>
		<p class="dl-note reveal">
			Updates arrive inside the app, signature-checked, and never install without
			asking. A beta channel is one switch away in Settings.
		</p>
	</div>
</section>

<style>
	.dl {
		background:
			radial-gradient(60% 80% at 50% 110%, rgba(255, 62, 28, 0.13), transparent 70%),
			var(--bg);
	}

	.dl-inner {
		text-align: center;
	}

	.section-lead.center {
		margin-left: auto;
		margin-right: auto;
	}

	.dl-cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 20rem));
		justify-content: center;
		gap: 1.2rem;
		text-align: left;
	}

	.dl-card {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.25rem 1.3rem;
	}

	.dl-card h3 {
		font-family: var(--font-display);
		font-size: 1.2rem;
		margin: 0 0 0.4rem;
	}

	.dl-card--soon {
		border-style: dashed;
		background: color-mix(in srgb, var(--surface) 60%, transparent);
	}

	.dl-soon-cta {
		pointer-events: none;
		opacity: 0.5;
	}

	.dl-card p {
		color: var(--text-secondary);
		font-size: 0.92rem;
		margin: 0 0 1.2rem;
	}

	.dl-row {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.dl-note-link {
		font-size: 0.85rem;
		color: var(--accent);
	}

	.dl-version {
		margin: 1.4rem 0 0;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.dl-version a {
		color: var(--text-secondary);
	}

	.dl-sep {
		margin: 0 0.5rem;
		opacity: 0.6;
	}

	.dl-note {
		margin: 2.2rem auto 0;
		max-width: 34rem;
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	@media (max-width: 1024px) {
		.dl-cards {
			grid-template-columns: repeat(2, minmax(0, 22rem));
		}
	}

	@media (max-width: 760px) {
		.dl-cards {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>

<script>
	/* The baked-in links are only as fresh as the last site build, and a release
	   lands without one. This asks GitHub for the current build and repoints the
	   buttons if it has moved on. It is allowed to fail - unauthenticated calls
	   are rate limited per address, and the links it would replace already work. */
	import { fetchBuild } from '../../lib/releases';

	const build = await fetchBuild();
	if (build) {
		for (const el of document.querySelectorAll<HTMLAnchorElement>('a[data-dl]')) {
			const href = build[el.dataset.dl as 'windows' | 'appImage' | 'deb' | 'page'];
			if (href) el.href = href;
		}
		for (const el of document.querySelectorAll('[data-dl-version]')) {
			el.textContent = `Version ${build.version}`;
		}
	}
</script>
