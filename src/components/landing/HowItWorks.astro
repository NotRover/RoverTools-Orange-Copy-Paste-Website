---
---

<section class="section how" id="how">
	<div class="wrap">
		<p class="eyebrow reveal">How it works</p>
		<h2 class="section-title reveal">Copy. Find. Paste.</h2>
		{/* One strip, three cells: the keys (or what you type) are each step's
		    headline, the way the app is driven */}
		<div class="steps reveal">
			<div class="step">
				<div class="step-keys">
					<span class="kbd">Ctrl</span><span class="plus">+</span><span class="kbd">C</span>
				</div>
				<h3>Copy anywhere</h3>
				<p>
					Copy the way you always have. Every copy lands in history in about a fifth
					of a second: text, links, images, files, even rich HTML.
				</p>
			</div>
			<div class="step">
				<div class="step-keys">
					<span class="search-demo"><span class="search-slash">/</span><span class="search-q" data-search-q>meeting link</span><span class="caret"></span></span>
				</div>
				<h3>Find it later</h3>
				<p>
					Search by content or group name. Filter by type, date, group, or cloud state,
					and every filter shows how many items it would leave before you apply it.
				</p>
			</div>
			<div class="step">
				<div class="step-keys">
					<span class="kbd">Ctrl</span><span class="plus">+</span><span class="kbd">Shift</span><span class="plus">+</span><span class="kbd">V</span>
				</div>
				<h3>Paste it back</h3>
				<p>
					A small popup opens at your cursor with your recent and pinned items. Press 1
					to 9, or 0 for the tenth, and it is pasted into the app you are in.
				</p>
			</div>
		</div>
	</div>
</section>

<script>
	/* The search in step two types one query, holds it, clears it and types
	   the next, the way someone hunts for different things through a day.
	   With motion off it stays on the first query. */
	const QUERIES = ['meeting link', 'wifi password', 'tracking number', 'address', 'that screenshot'];
	const q = document.querySelector<HTMLElement>('[data-search-q]');
	const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (q && !still) {
		const pause = (ms: number) => new Promise((r) => setTimeout(r, ms));
		(async () => {
			let n = 0;
			for (;;) {
				await pause(2200);
				const text = q.textContent ?? '';
				for (let i = text.length; i >= 0; i--) {
					q.textContent = text.slice(0, i);
					await pause(32);
				}
				n = (n + 1) % QUERIES.length;
				const next = QUERIES[n]!;
				await pause(260);
				for (let i = 1; i <= next.length; i++) {
					q.textContent = next.slice(0, i);
					await pause(70 + Math.random() * 50);
				}
			}
		})();
	}
</script>

<style>
	.steps {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: 2.2rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.step {
		padding: 1.4rem 1.5rem 1.5rem;
	}

	.step + .step {
		border-left: 1px solid var(--border);
	}

	.step-keys {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		min-height: 30px;
		margin-bottom: 1.1rem;
	}

	.plus {
		color: var(--text-muted);
		font-size: 0.8rem;
	}

	/* what you would type into the search box, caret and all */
	.search-demo {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--text);
	}

	/* keeps the space inside a query while it is half typed */
	.search-q {
		display: inline-block;
		white-space: pre;
	}

	.search-slash {
		color: var(--text-muted);
		margin-right: 0.5rem;
	}

	.caret {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		margin-left: 2px;
		background: var(--accent);
		animation: caretBlink 1.1s steps(1) infinite;
	}

	@keyframes caretBlink {
		50% {
			opacity: 0;
		}
	}

	.step h3 {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 700;
		margin: 0 0 0.4rem;
		letter-spacing: -0.01em;
	}

	.step p {
		margin: 0;
		color: var(--text-secondary);
		font-size: 0.88rem;
	}

	@media (prefers-reduced-motion: reduce) {
		.caret {
			animation: none;
		}
	}

	@media (max-width: 820px) {
		.steps {
			grid-template-columns: minmax(0, 1fr);
		}

		.step + .step {
			border-left: 0;
			border-top: 1px solid var(--border);
		}
	}
</style>
