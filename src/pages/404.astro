---
import '../styles/landing.css';
import SiteNav from '../components/landing/SiteNav.astro';

const title = 'Page not found - Orange Copy Paste';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="robots" content="noindex" />
		<meta name="color-scheme" content="dark" />
		<link rel="icon" type="image/png" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/app-icon.png" />
	</head>
	<body class="landing">
		<SiteNav />
		<main class="nf">
			<div class="wrap nf-inner">
				<p class="eyebrow">404</p>
				<h1>This page is not here</h1>
				<p class="nf-text">
					The link may be old, or the page may have moved. The landing page and the docs
					are both still where you left them.
				</p>
				<div class="nf-actions">
					<a class="btn btn-primary" href="/">Back to the home page</a>
					<a class="btn btn-ghost" href="/docs/">Read the docs</a>
				</div>
			</div>
		</main>

		<style>
			.nf {
				display: flex;
				align-items: center;
				min-height: calc(100vh - 62px);
			}

			.nf-inner {
				padding: 4rem 1.25rem 6rem;
			}

			h1 {
				font-family: var(--font-display);
				font-size: clamp(1.9rem, 4vw, 2.9rem);
				line-height: 1.1;
				letter-spacing: -0.02em;
				margin: 0.5rem 0 0;
			}

			.nf-text {
				max-width: 44ch;
				color: var(--text-secondary);
				font-size: 1.02rem;
				line-height: 1.6;
				margin: 0.9rem 0 0;
			}

			.nf-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.7rem;
				margin-top: 1.6rem;
			}
		</style>
	</body>
</html>
